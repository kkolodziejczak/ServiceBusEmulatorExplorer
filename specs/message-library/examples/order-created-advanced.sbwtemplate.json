{
  "schemaVersion": 1,
  "id": "9b73a3b8-0300-4f44-ae25-fbdb9f862e9f",
  "name": "Order created - advanced cloud properties",
  "description": "Uses the same orders.csv. PartitionKey is intentionally an advanced cloud-only input; remove it explicitly for emulator use.",
  "body": {
    "format": "json",
    "source": "{\n  \"eventId\": \"$(EventId)\",\n  \"customerId\": \"$(CustomerId)\",\n  \"amount\": \"$(Amount)\",\n  \"occurredAt\": \"$(OccurredAt)\"\n}"
  },
  "properties": {
    "contentType": "application/json",
    "subject": "OrderCreated",
    "correlationId": "order-$(CustomerId)",
    "sessionId": "$(CustomerId)",
    "messageId": { "mode": "custom", "source": "order-$(CustomerId)" },
    "timeToLive": { "source": "00:10:00" },
    "replyTo": "order-replies",
    "replyToSessionId": "$(CustomerId)",
    "partitionKey": "$(CustomerId)",
    "applicationProperties": {
      "amount": { "type": "decimal", "source": "$(Amount)" },
      "eventId": { "type": "guid", "source": "$(EventId)" },
      "occurredAt": { "type": "dateTimeUtc", "source": "$(OccurredAt)" },
      "source": { "type": "string", "source": "message-library" },
      "traceUrl": { "type": "uri", "source": "https://example.invalid/orders" },
      "unsignedReference": { "type": "uint64", "source": "18446744073709551615" }
    }
  },
  "variables": [
    { "name": "CustomerId", "type": "string", "source": "input" },
    { "name": "Amount", "type": "number", "source": "input" },
    { "name": "EventId", "type": "string", "source": "guid" },
    { "name": "OccurredAt", "type": "string", "source": "utcNow" }
  ]
}
