<Window x:Class="ServiceBusEmulatorExplorer.InvestigationPrototype.GlobalWatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Watch" Width="540" Height="640" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner"
 Icon="Assets/AppIcon.png" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="{DynamicResource CanvasBrush}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Watch" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <CheckBox x:Name="GlobalActiveChoice" Content="Active messages" Checked="GlobalChoice_Changed" Unchecked="GlobalChoice_Changed" Margin="0,0,0,12" AutomationProperties.AutomationId="GlobalActiveChoice"/>
   <CheckBox x:Name="GlobalDlqChoice" Content="Dead-letter messages" Checked="GlobalChoice_Changed" Unchecked="GlobalChoice_Changed" AutomationProperties.AutomationId="GlobalDlqChoice"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <TextBox x:Name="InclusionSearch" Padding="30,7,10,7" BorderBrush="{DynamicResource ControlBorderBrush}" TextChanged="Search_Changed" ToolTip="Find queues, topics and subscriptions" AutomationProperties.Name="Search watched entities" AutomationProperties.AutomationId="InclusionSearch"/>
   <Path Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M9,9 L14,14" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
   <TextBlock x:Name="InclusionSearchPlaceholder" Text="Search entities" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="31,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=InclusionSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
  <Grid Grid.Row="2"><TreeView x:Name="InclusionTree" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Included Watch entities" AutomationProperties.AutomationId="InclusionTree"/><TextBlock x:Name="NoEntitiesMatch" Text="No matching entities" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
  <Button x:Name="DoneButton" Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0" Content="Done" Style="{StaticResource PrimaryButton}" Click="Done_Click" AutomationProperties.AutomationId="DoneButton"/>
 </Grid></Border>
</Window>
