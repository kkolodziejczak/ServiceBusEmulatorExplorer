<Window x:Class="ServiceBusEmulatorExplorer.InvestigationPrototype.PrototypeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ServiceBusEmulatorExplorer.InvestigationPrototype"
 Title="Service Bus Emulator Explorer · Investigation prototype" Width="1500" Height="900" MinWidth="980" MinHeight="640" Background="#FAFCFF" FontFamily="Segoe UI" FontSize="14" Foreground="#17213D" WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="EntityIcon" TargetType="Path">
   <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#52708D"/><Setter Property="StrokeThickness" Value="1.5"/>
   <Setter Property="Data" Value="M1,4 L7,4 9,6 19,6 19,17 1,17 Z"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="Queue"><Setter Property="Stroke" Value="#087BC1"/><Setter Property="Data" Value="M2,2 H18 V6 H2 Z M2,9 H18 V13 H2 Z M2,16 H18 V20 H2 Z"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Topic"><Setter Property="Stroke" Value="#087BC1"/><Setter Property="Data" Value="M7,1 H13 V6 H7 Z M10,6 V10 M3,10 H17 M3,10 V14 M17,10 V14 M0,14 H6 V19 H0 Z M14,14 H20 V19 H14 Z"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Subscription"><Setter Property="Stroke" Value="#7351B5"/><Setter Property="Data" Value="M10,0 V12 M6,8 L10,12 14,8 M3,10 L0,19 H20 L17,10 M0,15 H6 L8,18 H12 L14,15 H20"/></DataTrigger>
   </Style.Triggers>
  </Style>

  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DFEA"/><Setter Property="Foreground" Value="#234266"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CBD8E8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#526887"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#0069FA"/><Setter Property="BorderBrush" Value="#0069FA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisibility}}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SelectionBackground" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="3"/>
    <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="30" Padding="0" BorderThickness="0" Focusable="False" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 5 L 0 10" Stroke="#365371" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" Margin="0,4"/>
    <ItemsPresenter x:Name="ChildrenPresenter" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBackground" Property="Background" Value="#DBEDFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBackground" Property="BorderBrush" Value="#0069FA"/><Setter TargetName="SelectionBackground" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:EntityNode}" ItemsSource="{Binding Children}">
   <Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <DockPanel Margin="3,0,6,0"><Path Style="{StaticResource EntityIcon}" ToolTip="{Binding Kind}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DockPanel>
    <TextBlock Grid.Column="1" Text="{Binding MessageCount}" Foreground="#0069FA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding DlqCount}" Foreground="#A65B00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
   </Grid>
  </HierarchicalDataTemplate>
 </Window.Resources>
 <Grid Background="#FAFCFF"><Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#D7E0EB" BorderThickness="0,0,0,1" Background="#F5F9FE">
   <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▣" FontSize="28" Foreground="#087BC1" Margin="0,0,12,0"/><TextBlock Text="Service Bus Emulator Explorer" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Prototype · sample data" Foreground="#64758A" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Local emulator" Margin="10,0,14,0" VerticalAlignment="Center"/><Button x:Name="ConnectionButton" Content="{Binding ConnectionLabel}" Click="Connection_Click" ToolTip="Disconnect or reconnect the simulated connection" AutomationProperties.AutomationId="ConnectionButton" AutomationProperties.Name="Toggle simulated connection"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="315" MinWidth="250" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="15,16,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Namespace" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,15"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_Changed" ToolTip="Search queues, topics and subscriptions" AutomationProperties.Name="Search entities" AutomationProperties.AutomationId="SearchEntities"/>
    <TextBlock Grid.Row="1" Text="Search entities" Foreground="#627692" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Grid Grid.Row="2" Margin="0,9,5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Entities" Foreground="#63748D" FontSize="12"/><TextBlock Grid.Column="1" Text="Messages" HorizontalAlignment="Right" Foreground="#63748D" FontSize="12"/><TextBlock Grid.Column="2" Text="DLQ" HorizontalAlignment="Right" Foreground="#63748D" FontSize="12"/></Grid>
    <TreeView x:Name="NamespaceTree" Grid.Row="3" ItemsSource="{Binding Roots}" SelectedItemChanged="Tree_Selected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Namespace entities" AutomationProperties.AutomationId="NamespaceTree"/>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DFE6EE" AutomationProperties.Name="Resize namespace pane"/>
   <Grid x:Name="ContentGrid" Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="370"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.1*" MinWidth="380"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="ListPane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="ListHeading" Margin="19,18,15,12"><TextBlock Text="{Binding EntityPath}" Foreground="#3970B8" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MessagesHeading" Text="Messages" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0"><ToggleButton x:Name="ActiveTab" Content="Active" IsChecked="True" Click="Active_Click" AutomationProperties.AutomationId="ActiveTab"/><ToggleButton x:Name="DeadLetterTab" Content="Dead letter" Click="DeadLetter_Click" AutomationProperties.AutomationId="DeadLetterTab"/></StackPanel>
     <Border x:Name="ListToolbar" Grid.Row="2" BorderBrush="#DFE6EE" BorderThickness="0,1" Padding="12,9"><DockPanel LastChildFill="False"><TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" VerticalAlignment="Center" Foreground="#42638C" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="RefreshButton" Content="↻ Refresh" Click="Refresh_Click" IsEnabled="{Binding IsConnected}" AutomationProperties.AutomationId="RefreshButton"/><ComboBox x:Name="AutoInterval" SelectedIndex="0" Width="104" Margin="5,0" VerticalContentAlignment="Center" SelectionChanged="Interval_Changed" AutomationProperties.Name="Automatic refresh interval" AutomationProperties.AutomationId="AutoInterval"><ComboBoxItem Content="Auto: Off"/><ComboBoxItem Content="Auto: 5s"/><ComboBoxItem Content="Auto: 10s"/><ComboBoxItem Content="Auto: 30s"/></ComboBox><Button x:Name="PauseButton" Content="Ⅱ" Width="36" Padding="0" Click="Pause_Click" ToolTip="Pause automatic refresh" AutomationProperties.Name="Pause automatic refresh" AutomationProperties.AutomationId="PauseButton"/></StackPanel>
     </DockPanel></Border>
     <Grid Grid.Row="3"><DataGrid x:Name="MessageGrid" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBF2" BorderThickness="0" RowHeight="63" Background="White" AlternatingRowBackground="#FBFCFE" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionChanged="Messages_Selected" CurrentCellChanged="Messages_CurrentCellChanged" PreviewKeyDown="Messages_KeyDown" AutomationProperties.Name="Messages" AutomationProperties.AutomationId="MessageGrid">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="#EEF4FA"/><Setter Property="Foreground" Value="#284366"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#17213D"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEDFF"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTemplateColumn Width="45" CanUserSort="False"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllBox" Click="SelectAll_Click" AutomationProperties.Name="Select all loaded messages" AutomationProperties.AutomationId="SelectAllMessages"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="RowCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding EventName, StringFormat=Select {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Event" Width="*" SortMemberPath="EventName"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,9,4,4"><TextBlock Text="{Binding EventName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MessageId}" FontSize="12" Foreground="#627692" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessageId}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn x:Name="SourceColumn" Header="Subscription" Width="130" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SourceName}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" Margin="8,13,5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Enqueued (UTC)" Binding="{Binding Enqueued, StringFormat=HH:mm:ss}" Width="125"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Margin" Value="10,13,0,0"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid><TextBlock x:Name="EmptyMessage" Text="No messages in this view" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66768B" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
     <Border x:Name="ListFooter" Grid.Row="4" Padding="15,10" BorderBrush="#DFE6EE" BorderThickness="0,1,0,0"><StackPanel><DockPanel><Button x:Name="LoadMoreButton" Content="Load more" DockPanel.Dock="Right" Click="LoadMore_Click" IsEnabled="{Binding CanLoadMore}" AutomationProperties.AutomationId="LoadMoreButton"/><TextBlock Text="{Binding Footer}" VerticalAlignment="Center" Foreground="#63748D" FontSize="12" TextWrapping="Wrap"/></DockPanel><WrapPanel Margin="0,7,0,0" Visibility="{Binding IsDeadLetter, Converter={StaticResource BoolVisibility}}"><Button x:Name="ReplayButton" Content="Replay" Click="Replay_Click" IsEnabled="{Binding CanReplay}" ToolTip="Replay selected messages as active copies with new IDs; originals stay in the DLQ" AutomationProperties.AutomationId="ReplayButton"/><Button x:Name="EditReplayButton" Content="Edit and Replay" Click="EditReplay_Click" IsEnabled="{Binding CanEditAndReplay}" ToolTip="Edit one message and replay a copy with a new ID" AutomationProperties.AutomationId="EditReplayButton"/></WrapPanel></StackPanel></Border>
    </Grid>
    <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DFE6EE" AutomationProperties.Name="Resize message inspector"/>
    <Grid x:Name="InspectorPane" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel x:Name="InspectorHeading" Margin="20,19,15,18"><TextBlock x:Name="InspectorTitle" Text="{Binding FocusedMessage.EventName, TargetNullValue=Select a message}" FontSize="25" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FocusedMessage.MessageId}" Foreground="#617693" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
     <DockPanel Grid.Row="1" Margin="9,0,8,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" Padding="7,4" ToolTip="Copy original body or properties" AutomationProperties.AutomationId="CopyBody"/><Button x:Name="FindButton" Content="Find" Click="Find_Click" Padding="7,4" AutomationProperties.AutomationId="FindButton"/></StackPanel><StackPanel Orientation="Horizontal"><ToggleButton x:Name="JsonTab" Content="JSON" IsChecked="True" Click="Json_Click" Padding="9,8" AutomationProperties.AutomationId="JsonTab"/><ToggleButton x:Name="RawTab" Content="Raw" Click="Raw_Click" Padding="9,8" AutomationProperties.AutomationId="RawTab"/><ToggleButton x:Name="PropertiesTab" Content="Properties" Click="Properties_Click" Padding="9,8" AutomationProperties.AutomationId="PropertiesTab"/></StackPanel></DockPanel>
     <DockPanel x:Name="FindPanel" Grid.Row="2" Visibility="Collapsed" Margin="10,7"><Button DockPanel.Dock="Right" Content="×" Click="CloseFind_Click" AutomationProperties.Name="Close find"/><Button DockPanel.Dock="Right" Content="Next" Click="FindNext_Click" AutomationProperties.AutomationId="FindNext"/><TextBox x:Name="FindBox" KeyDown="Find_KeyDown" AutomationProperties.Name="Find in message" AutomationProperties.AutomationId="FindText"/></DockPanel>
     <RichTextBox x:Name="BodyViewer" Grid.Row="3" Background="#1C2937" Foreground="#DCE7F3" FontFamily="Consolas" FontSize="14" Padding="20,18" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Message body" AutomationProperties.AutomationId="BodyViewer"/>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#D7E0EB" BorderThickness="0,1,0,0"><Grid Margin="16,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="#62738B" FontSize="12" VerticalAlignment="Center"/><Expander Grid.Column="1" Header="Activity log" ExpandDirection="Up" Foreground="#62738B" AutomationProperties.AutomationId="ActivityLog"><TextBox x:Name="LogText" Width="480" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log entries"/></Expander></Grid></Border>
 </Grid>
</Window>
