<Window x:Class="ServiceBusEmulatorExplorer.InvestigationPrototype.PrototypeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ServiceBusEmulatorExplorer.InvestigationPrototype"
 Title="Service Bus Emulator Explorer · Investigation prototype" Width="1500" Height="1000" Icon="Assets/AppIcon.png" MinWidth="980" MinHeight="640" Background="#FAFCFF" FontFamily="Segoe UI" FontSize="14" Foreground="#17213D" WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/><Style x:Key="CopyIcon" TargetType="Path"><Setter Property="Data" Value="M4,1 H1 V13 H4 M6,4 H15 V17 H6 Z"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="Width" Value="16"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="EntityIcon" TargetType="Path">
   <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#52708D"/><Setter Property="StrokeThickness" Value="1.5"/>
   <Setter Property="Data" Value="M1,4 L7,4 9,6 19,6 19,17 1,17 Z"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="Queue"><Setter Property="Stroke" Value="#087BC1"/><Setter Property="Data" Value="M2,2 H18 V6 H2 Z M2,9 H18 V13 H2 Z M2,16 H18 V20 H2 Z"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Topic"><Setter Property="Stroke" Value="#087BC1"/><Setter Property="Data" Value="M7,1 H13 V6 H7 Z M10,6 V10 M3,10 H17 M3,10 V14 M17,10 V14 M0,14 H6 V19 H0 Z M14,14 H20 V19 H14 Z"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Subscription"><Setter Property="Stroke" Value="#7351B5"/><Setter Property="Data" Value="M10,0 V12 M6,8 L10,12 14,8 M3,10 L0,19 H20 L17,10 M0,15 H6 L8,18 H12 L14,15 H20"/></DataTrigger>
   </Style.Triggers>
  </Style>

  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DFEA"/><Setter Property="Foreground" Value="#234266"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078F8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#738196"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CBD8E8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#526887"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#0069FA"/><Setter Property="BorderBrush" Value="#0069FA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisibility}}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SelectionBackground" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="3"/>
    <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="30" Padding="0" BorderThickness="0" Focusable="False" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 5 L 0 10" Stroke="#365371" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" Margin="0,4"/>
    <ItemsPresenter x:Name="ChildrenPresenter" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBackground" Property="Background" Value="#DBEDFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBackground" Property="BorderBrush" Value="#0069FA"/><Setter TargetName="SelectionBackground" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:EntityNode}" ItemsSource="{Binding Children}">
   <Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <DockPanel Margin="3,0,6,0"><Path Style="{StaticResource EntityIcon}" ToolTip="{Binding Kind}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DockPanel>
    <TextBlock Grid.Column="1" Text="{Binding MessageCount}" Foreground="#0069FA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding DlqCount}" Foreground="#A65B00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
   </Grid>
  </HierarchicalDataTemplate>
 </Window.Resources>
 <Grid Background="#FAFCFF">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#F5F9FE" BorderBrush="#D7E0EB" BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0" LastChildFill="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="30" Height="30" Margin="0,0,12,0"/><TextBlock Text="Service Bus Emulator Explorer" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Local emulator" Margin="10,0,14,0" VerticalAlignment="Center"/><Button x:Name="ConnectionButton" Content="{Binding ConnectionLabel}" Click="Connection_Click" AutomationProperties.AutomationId="ConnectionButton" AutomationProperties.Name="Toggle simulated connection"/><Button x:Name="WatchSummaryButton" Click="WatchSummary_Click" Padding="8,3" Background="Transparent" BorderThickness="0" ToolTip="Watch notifications" AutomationProperties.Name="Watch notifications"><Path Data="M3,14 V7 A5,5 0 0 1 13,7 V14 L16,17 H0 Z M6,20 H10" Stroke="#234266" StrokeThickness="1.5" Width="17" Height="20"/></Button><Button Content="⚙" Click="Settings_Click" Padding="6,2" Background="Transparent" BorderThickness="0" ToolTip="Settings" AutomationProperties.Name="Settings"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="240" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="15,16,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,15"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" Padding="30,7,35,7" TextChanged="Search_Changed" PreviewKeyDown="SearchKeyDown" GotKeyboardFocus="SearchFocused" ToolTip="Search entities, correlation IDs or message IDs across this connection" AutomationProperties.Name="Search all entities and messages" AutomationProperties.AutomationId="SearchBox"/>
    <Path Grid.Row="1" Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M9,9 L14,14" Stroke="#365371" StrokeThickness="1.5" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
    <Button x:Name="ClearSearchButton" Grid.Row="1" HorizontalAlignment="Right" Width="30" Margin="2" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Clear search and return to browsing" AutomationProperties.Name="Clear search" AutomationProperties.AutomationId="ClearSearchButton"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="#52708D" StrokeThickness="1.8"/></Button>
    <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
     <Border Width="420" Background="White" BorderBrush="#CBD8E8" BorderThickness="1" CornerRadius="3" Padding="0,5">
      <ListBox x:Name="SuggestionsList" BorderThickness="0" MaxHeight="440" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="SuggestionKeyDown" PreviewMouseLeftButtonUp="SuggestionPicked" AutomationProperties.Name="Grouped search suggestions">
       <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border BorderBrush="#E4EBF4" BorderThickness="0,1,0,0" Margin="10,5,10,0" Padding="2,9,2,3"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#42689A"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding IconBrush}" StrokeThickness="1.4" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#617693" FontSize="11" MaxWidth="155" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DockPanel><TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{Binding IconBrush}" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Border>
    </Popup>
    <TextBlock Grid.Row="1" Text="Entities, correlation or message ID" FontSize="12" Foreground="#627692" Margin="31,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Grid Grid.Row="2" Margin="0,9,5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Entities" Foreground="#63748D" FontSize="12"/><TextBlock Grid.Column="1" Text="Messages" HorizontalAlignment="Right" Foreground="#63748D" FontSize="12"/><TextBlock Grid.Column="2" Text="DLQ" HorizontalAlignment="Right" Foreground="#63748D" FontSize="12"/></Grid>
    <TreeView x:Name="NamespaceTree" Grid.Row="3" ItemsSource="{Binding Roots}" SelectedItemChanged="Tree_Selected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Namespace entities" AutomationProperties.AutomationId="NamespaceTree"/>
    <TextBlock x:Name="NamespaceEmpty" Grid.Row="3" Text="No matching entities. Clear the search to show all entities." TextWrapping="Wrap" Foreground="#617693" Margin="10,15" VerticalAlignment="Top" Visibility="Collapsed"/>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DFE6EE" AutomationProperties.Name="Resize namespace pane"/>
   <Grid x:Name="ContentGrid" Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="370"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1*" MinWidth="380"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="ListPane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="ListHeading" Margin="19,18,15,12"><TextBlock x:Name="ListBreadcrumb" Text="{Binding EntityPath}" Foreground="#3970B8" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MessagesHeading" Text="Messages" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="SearchSummary" Foreground="#617693" Margin="0,6,0,0" Visibility="Collapsed"/></StackPanel>
     <StackPanel x:Name="BrowseTabs" Grid.Row="1" Orientation="Horizontal" Margin="14,0"><ToggleButton x:Name="ActiveTab" Content="Active" IsChecked="True" Click="Active_Click" AutomationProperties.AutomationId="ActiveTab"/><ToggleButton x:Name="DeadLetterTab" Content="Dead letter" Click="DeadLetter_Click" AutomationProperties.AutomationId="DeadLetterTab"/></StackPanel>
     <Border x:Name="SearchStatusPanel" Grid.Row="1" Margin="18,0,15,12" Padding="10,8" Background="#EAF4FF" BorderBrush="#C9DFFF" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"><DockPanel><Button x:Name="StopSearchButton" DockPanel.Dock="Right" Content="■  Stop" Click="StopSearch_Click" Padding="10,4" AutomationProperties.AutomationId="StopSearchButton"/><TextBlock x:Name="SearchStatusText" Text="{Binding SearchStatus}" Foreground="#2766B3" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
     <Border x:Name="ListToolbar" Grid.Row="2" BorderBrush="#DFE6EE" BorderThickness="0,1" Padding="12,9"><DockPanel LastChildFill="False"><TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" VerticalAlignment="Center" Foreground="#42638C" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="WatchButton" Click="Watch_Click" Background="#0078F8" Foreground="White" BorderBrush="#0078F8" Padding="10,7" AutomationProperties.Name="Watch messages" AutomationProperties.AutomationId="WatchButton"><StackPanel Orientation="Horizontal"><Path Data="M3,14 V7 A5,5 0 0 1 13,7 V14 L16,17 H0 Z M6,20 H10" Fill="White" Stroke="White" StrokeThickness="1" Width="13" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock x:Name="WatchButtonLabel" Text="Watch"/><TextBlock Text="⌄" Margin="7,0,0,0"/></StackPanel></Button><Button x:Name="RefreshButton" Content="↻ Refresh" Click="Refresh_Click" IsEnabled="{Binding IsConnected}" AutomationProperties.AutomationId="RefreshButton"/><ComboBox x:Name="AutoInterval" SelectedIndex="0" Width="104" Margin="5,0" VerticalContentAlignment="Center" SelectionChanged="Interval_Changed" AutomationProperties.Name="Automatic refresh interval" AutomationProperties.AutomationId="AutoInterval"><ComboBoxItem Content="Auto: Off"/><ComboBoxItem Content="Auto: 5s"/><ComboBoxItem Content="Auto: 10s"/><ComboBoxItem Content="Auto: 30s"/></ComboBox><Button x:Name="PauseButton" Content="Ⅱ" Width="36" Padding="0" Click="Pause_Click" AutomationProperties.Name="Pause automatic refresh" AutomationProperties.AutomationId="PauseButton"/></StackPanel>
     </DockPanel></Border>
     <Grid Grid.Row="3"><DataGrid x:Name="MessageGrid" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBF2" BorderThickness="0" RowHeight="54" Background="White" AlternatingRowBackground="#FBFCFE" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionChanged="Messages_Selected" CurrentCellChanged="Messages_CurrentCellChanged" PreviewKeyDown="Messages_KeyDown" AutomationProperties.Name="Messages" AutomationProperties.AutomationId="MessageGrid">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,7"/><Setter Property="Background" Value="#EEF4FA"/><Setter Property="Foreground" Value="#284366"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#17213D"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEDFF"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="40" CanUserSort="False"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllBox" Click="SelectAll_Click" AutomationProperties.Name="Select all loaded messages" AutomationProperties.AutomationId="SelectAllMessages"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="RowCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding EventName, StringFormat=Select {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Event / Message ID" Width="1.1*" SortMemberPath="EventName"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,6,4,2"><TextBlock Text="{Binding EventName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding EventName}"/><TextBlock Text="{Binding MessageId}" FontSize="12" Foreground="#627692" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessageId}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Correlation ID" Width="145" SortMemberPath="CorrelationId"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="7,8" VerticalAlignment="Center"><TextBlock Text="{Binding CorrelationId}" MaxWidth="99" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CorrelationId}" FontSize="12"/><Button Click="CopyRowCorrelation_Click" Padding="3" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="Copy correlation ID" AutomationProperties.Name="Copy row correlation ID"><Path Style="{StaticResource CopyIcon}"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn x:Name="SourceColumn" Header="Location / State" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,8,5,5" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" VerticalAlignment="Center"/><Border Grid.Column="1" CornerRadius="3" HorizontalAlignment="Left" Padding="6,2" Margin="5,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DBEDFF"/><Style.Triggers><DataTrigger Binding="{Binding IsDeadLetter}" Value="True"><Setter Property="Background" Value="#FFE6C8"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StateLabel}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0072DD"/><Style.Triggers><DataTrigger Binding="{Binding IsDeadLetter}" Value="True"><Setter Property="Foreground" Value="#A65B00"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn x:Name="EnqueuedColumn" Header="Enqueued (UTC)" Binding="{Binding Enqueued, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="EmptyResults" VerticalAlignment="Center" Margin="25" Visibility="Collapsed"><Border x:Name="EmptySearchIcon" Width="48" Height="48" Background="#EAF4FF" CornerRadius="24" HorizontalAlignment="Center"><Path Data="M24,15 A9,9 0 1 1 6,15 A9,9 0 1 1 24,15 M21,22 L30,31" Stroke="#0078F8" StrokeThickness="2" Width="32" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyMessage" Text="No messages in this view" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="#617693"/><Button x:Name="EmptyClearButton" Content="Clear search" Click="ClearSearch_Click" HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.AutomationId="EmptyClearButton"/></StackPanel>
     </Grid>
     <Border x:Name="ListFooter" Grid.Row="4" Padding="15,10" BorderBrush="#DFE6EE" BorderThickness="0,1,0,0"><DockPanel><Button x:Name="LoadMoreButton" Content="Load more" DockPanel.Dock="Right" Click="LoadMore_Click" IsEnabled="{Binding CanLoadMore}" AutomationProperties.AutomationId="LoadMoreButton"/><TextBlock Text="{Binding Footer}" VerticalAlignment="Center" Foreground="#63748D" FontSize="12" TextWrapping="Wrap"/></DockPanel></Border>
    </Grid>
    <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DFE6EE" AutomationProperties.Name="Resize message inspector"/>
    <Grid x:Name="InspectorPane" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="InspectorHeading" Margin="18,18,15,12">
      <DockPanel><Border x:Name="InspectorState" DockPanel.Dock="Right" Background="#FFE6C8" CornerRadius="3" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="{Binding FocusedMessage.StateLabel}" Foreground="#A65B00" FontSize="12"/></Border><TextBlock x:Name="InspectorTitle" Text="{Binding FocusedMessage.EventName}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></DockPanel>
      <TextBlock x:Name="InspectorMessageId" Text="{Binding FocusedMessage.MessageId}" Foreground="#617693" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/>
      <Border x:Name="CorrelationMetadata" BorderBrush="#DFE7F1" BorderThickness="1" Background="#F3F7FC" CornerRadius="3" Padding="10,9"><StackPanel>
       <DockPanel><Button x:Name="FindRelatedButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="⌕  Find related" Padding="7,4" Click="FindRelated_Click" AutomationProperties.AutomationId="FindRelatedButton"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Correlation ID" Foreground="#617693" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock x:Name="CorrelationValue" Text="{Binding FocusedMessage.CorrelationId}" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocusedMessage.CorrelationId}" FontSize="12" VerticalAlignment="Center"/><Button x:Name="CopyCorrelationButton" Padding="4" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Click="CopyCorrelation_Click" ToolTip="Copy correlation ID" AutomationProperties.Name="Copy correlation ID" AutomationProperties.AutomationId="CopyCorrelationButton"><Path Style="{StaticResource CopyIcon}"/></Button></StackPanel></DockPanel>
       <TextBlock x:Name="DlqReason" Text="{Binding FocusedMessage.DeadLetterReason, StringFormat=DLQ reason: {0}}" Foreground="#526887" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </StackPanel>
     <DockPanel x:Name="InspectorTabs" Grid.Row="1" Margin="9,0,8,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ReplayButton" Content="▶  Replay" Click="Replay_Click" Background="#0078F8" Foreground="White" BorderBrush="#0078F8" Padding="14,8" AutomationProperties.AutomationId="ReplayButton"/><Button x:Name="FindButton" Content="Find" Click="Find_Click" Padding="7,4" AutomationProperties.AutomationId="FindButton"/></StackPanel><StackPanel Orientation="Horizontal"><ToggleButton x:Name="JsonTab" Content="JSON" IsChecked="True" Click="Json_Click" Padding="9,8" AutomationProperties.AutomationId="JsonTab"/><ToggleButton x:Name="RawTab" Content="Raw" Click="Raw_Click" Padding="9,8" AutomationProperties.AutomationId="RawTab"/><ToggleButton x:Name="PropertiesTab" Content="Properties" Click="Properties_Click" Padding="9,8" AutomationProperties.AutomationId="PropertiesTab"/></StackPanel></DockPanel>
     <DockPanel x:Name="FindPanel" Grid.Row="2" Visibility="Collapsed" Margin="10,7"><Button DockPanel.Dock="Right" Content="×" Click="CloseFind_Click" AutomationProperties.Name="Close find"/><Button DockPanel.Dock="Right" Content="Next" Click="FindNext_Click" AutomationProperties.AutomationId="FindNext"/><TextBox x:Name="FindBox" KeyDown="Find_KeyDown" AutomationProperties.Name="Find in message" AutomationProperties.AutomationId="FindText"/></DockPanel>
     <Grid Grid.Row="3">
      <RichTextBox x:Name="BodyViewer" Background="#1C2937" Foreground="#DCE7F3" FontFamily="Consolas" FontSize="14" Padding="20,18" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Original message body and properties" AutomationProperties.AutomationId="BodyViewer" Visibility="Collapsed"/>
      <local:JsonEditor x:Name="BodyEditor" Background="#1C2937" FontFamily="Consolas" FontSize="14" Padding="14,18" BorderThickness="0" ShowLineNumbers="True" LineNumbersForeground="#8394A9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="BodyEditor_Changed" AutomationProperties.Name="Editable message JSON" AutomationProperties.AutomationId="BodyEditor"/>
      <Border x:Name="ModifiedBadge" Background="#FFE38D" CornerRadius="3" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,105,0" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="Modified" Foreground="#5E4600" FontSize="11"/></Border>
      <Button x:Name="CopyButton" Content="⧉  Copy" Click="Copy_Click" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,12,0" Background="#253546" Foreground="White" BorderBrush="#526578" ToolTip="Copy displayed body or properties" AutomationProperties.AutomationId="CopyBody"/>
     </Grid>
     <Border x:Name="ReplayActions" Grid.Row="4" Padding="10,10" BorderBrush="#D7E0EB" BorderThickness="0,1,0,0"><StackPanel>
      <TextBlock x:Name="EditError" Foreground="#A94415" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
      <WrapPanel><Button x:Name="DiscardButton" Content="↶  Discard changes" Click="Discard_Click" Padding="10,8" Visibility="Collapsed" AutomationProperties.AutomationId="DiscardButton"/><TextBlock x:Name="NextReplayIdText" Text="{Binding NextReplayId, StringFormat=Next ID: {0}}" FontSize="11" Foreground="#617693" VerticalAlignment="Center" Margin="10,6" TextTrimming="CharacterEllipsis"/></WrapPanel>
     </StackPanel></Border>
     <StackPanel x:Name="EmptyInspector" Grid.RowSpan="5" VerticalAlignment="Center" Margin="25" Visibility="Collapsed"><Path Data="M4,1 H20 L30,11 V39 H4 Z M20,1 V11 H30 M10,18 H24 M10,24 H24 M10,30 H20" Stroke="#8197B3" StrokeThickness="1.5" Width="34" Height="42" HorizontalAlignment="Center"/><TextBlock Text="Select a message to inspect" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="Choose a message from the list to view its details, JSON content, and replay options." Foreground="#617693" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#D7E0EB" BorderThickness="0,1,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Background="#F3F8FE"><Button x:Name="LogToggle" Content="⌃" DockPanel.Dock="Right" Width="32" Padding="0" Click="ToggleLog_Click" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Collapse activity log" AutomationProperties.AutomationId="LogToggle"/><Button DockPanel.Dock="Right" Content="Clear" Click="ClearLog_Click" BorderThickness="0" Background="Transparent" Padding="12,4" AutomationProperties.AutomationId="ClearLogButton"/><Border Width="23" Height="23" Margin="16,0,0,0" Background="#22374D" CornerRadius="2"><TextBlock Text="›_" FontFamily="Consolas" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="LogHeading" Text="Activity log · Expanded" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/></DockPanel>
    <Grid x:Name="LogPanel" Grid.Row="1" Height="150" Background="#1C2937"><RichTextBox x:Name="LogText" Background="Transparent" Foreground="#D5E5F5" FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0" Padding="16,7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Activity log entries"><RichTextBox.Document><FlowDocument PagePadding="0"/></RichTextBox.Document></RichTextBox></Grid>
   </Grid>
  </Border>
  <Border Grid.Row="3" BorderBrush="#D7E0EB" BorderThickness="0,1,0,0" Padding="16,7"><DockPanel><TextBlock x:Name="LastOperationTime" DockPanel.Dock="Right" Foreground="#42638C" FontSize="11" Margin="15,0,0,0"/><TextBlock x:Name="LastOperation" Text="Last operation: Connected to local sample data" TextTrimming="CharacterEllipsis" Foreground="#42638C" FontSize="12"/></DockPanel></Border>
 </Grid>
</Window>