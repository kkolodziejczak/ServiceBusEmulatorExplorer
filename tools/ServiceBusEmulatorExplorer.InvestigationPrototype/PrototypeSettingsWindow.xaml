<Window x:Class="ServiceBusEmulatorExplorer.InvestigationPrototype.PrototypeSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings" Width="520" Height="820" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner"
 Icon="Assets/AppIcon.png" Background="#FAFCFF" Foreground="#17213D" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD8E8"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="#17213D"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F5F9FE"/><Setter Property="Foreground" Value="#627692"/></Trigger></Style.Triggers></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD8E8"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="#17213D"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F5F9FE"/><Setter Property="Foreground" Value="#627692"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Switch" TargetType="ToggleButton">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" CornerRadius="12" Background="#798BA3" BorderBrush="Transparent" BorderThickness="2"><Ellipse x:Name="Thumb" Fill="White" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0069FA"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#234266"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Background" Value="#004FBD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Background" Value="#CBD8E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 <Style x:Key="ProfileItem" TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#234266"/><Setter Property="Cursor" Value="Hand"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ProfileBorder" Background="White" BorderBrush="#CBD8E8" BorderThickness="1" CornerRadius="4" Padding="12,11" Margin="0,0,0,7">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" Margin="0,0,10,0"><Ellipse x:Name="Ring" Stroke="{Binding ColorHex}" StrokeThickness="1.5"/><Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="{Binding ColorHex}" Visibility="Collapsed"/></Grid>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="ProfileBorder" Property="Background" Value="#DBEDFF"/><Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#0069FA"/><Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/></Trigger>
         <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="ProfileBorder" Property="Background" Value="#EAF4FF"/></MultiTrigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#17213D"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ResourceDictionary></Window.Resources>
 <Grid Background="#FAFCFF"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#F5F9FE" BorderBrush="#CBD8E8" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel Orientation="Horizontal"><Image Source="Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="20,16,20,0" Background="Transparent" BorderThickness="0">
   <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="18,9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#627692"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EAF4FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#627692"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#0069FA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="Background" Value="#DBEDFF"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#0069FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#17213D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
   <TabItem x:Name="GeneralTab" Header="General" AutomationProperties.AutomationId="GeneralTab">
    <ScrollViewer Foreground="#17213D" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,22,4,12">
     <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Close to system tray" FontWeight="SemiBold"/><TextBlock Text="Keep watches running when you close the window." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,5,0,0"/></StackPanel><ToggleButton x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" AutomationProperties.AutomationId="CloseToTrayToggle" AutomationProperties.Name="Close to system tray"/></Grid>
     <TextBlock x:Name="TrayUnavailableText" Text="System tray is unavailable in this session." Foreground="#8A5914" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
     <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop notifications" FontWeight="SemiBold"/><TextBlock Text="Show persistent alerts for new messages in watched entities." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,5,0,0"/></StackPanel><ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="Notifications_Changed" Unchecked="Notifications_Changed" AutomationProperties.AutomationId="NotificationsToggle" AutomationProperties.Name="Desktop notifications"/></Grid>
     <Border Height="1" Background="#DFE6EE" Margin="0,24"/>
     <TextBlock Text="Connections" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Saved profiles. No broker connection is made in this prototype." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,8,0,14"/>
     <ListBox x:Name="ConnectionPicker" ItemContainerStyle="{StaticResource ProfileItem}" Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ConnectionPicker_Selected" AutomationProperties.AutomationId="ConnectionPicker" AutomationProperties.Name="Connection to use">

     </ListBox>
     <WrapPanel Margin="0,8,0,0"><Button x:Name="UseConnectionButton" Content="Use connection" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="UseConnection_Click" AutomationProperties.AutomationId="UseConnectionButton"/><Button Content="Manage connections" Margin="0,0,0,8" Click="ManageConnections_Click" AutomationProperties.AutomationId="ManageConnectionsButton"/></WrapPanel>
     <TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" Foreground="#42689A" FontSize="12" Margin="0,2,0,0" AutomationProperties.AutomationId="ConnectionStatus" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ConnectionsTab" Header="Connections" AutomationProperties.AutomationId="ConnectionsTab">
    <ScrollViewer Foreground="#17213D" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,20,4,12">
     <TextBlock Text="Connection profiles" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Profiles and preferences are saved for your next launch. Connection strings are protected for your Windows user; this prototype does not connect to a broker." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,8,0,14"/>
     <ListBox x:Name="ProfilesList" Height="104" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ProfileItem}" SelectionChanged="Profile_Selected" AutomationProperties.AutomationId="ProfilesList" AutomationProperties.Name="Sample connection profiles"/>
     <Label Content="Profile name" Target="{Binding ElementName=ProfileName}" Padding="0" Margin="0,16,0,6"/>
     <TextBox x:Name="ProfileName" AutomationProperties.AutomationId="ProfileName" AutomationProperties.Name="Profile name"/>
     <Label Content="Connection color" Target="{Binding ElementName=ColorPicker}" Padding="0" Margin="0,14,0,6"/>
     <ListBox x:Name="ColorPicker" SelectedValuePath="ColorHex" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ColorPicker" AutomationProperties.Name="Connection accent color">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="72"/><Setter Property="Margin" Value="0,0,4,4"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="SwatchBorder" Background="White" BorderBrush="#CBD8E8" BorderThickness="2" CornerRadius="3" Padding="4,8">
         <StackPanel><Ellipse Width="18" Height="18" Fill="{Binding ColorHex}"/><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Foreground="#17213D"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="#EAF4FF"/></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="#DBEDFF"/><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#0069FA"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#17213D"/></Trigger>
         <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwatchBorder" Property="Background" Value="#F5F9FE"/><Setter Property="Foreground" Value="#627692"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
     </ListBox>
     <Label Content="Runtime connection string" Target="{Binding ElementName=RuntimeConnection}" Padding="0" Margin="0,14,0,6"/>
     <PasswordBox x:Name="RuntimeConnection" AutomationProperties.AutomationId="RuntimeConnection" AutomationProperties.Name="Runtime connection string"/>
     <Label Content="Administration connection string" Target="{Binding ElementName=AdministrationConnection}" Padding="0" Margin="0,14,0,6"/>
     <PasswordBox x:Name="AdministrationConnection" AutomationProperties.AutomationId="AdministrationConnection" AutomationProperties.Name="Administration connection string"/>
     <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Foreground="#42689A" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#CBD8E8" BorderThickness="0,1,0,0" Padding="24,14" Background="#F5F9FE"><Grid>
   <Button x:Name="SaveProfileButton" Content="Save profile" HorizontalAlignment="Left" Margin="0" Click="SaveProfile_Click" AutomationProperties.AutomationId="SaveProfileButton"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=ConnectionsTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="84" HorizontalAlignment="Right" Click="Done_Click" AutomationProperties.AutomationId="DoneButton" IsCancel="True"/>
  </Grid></Border>
 </Grid>
</Window>


