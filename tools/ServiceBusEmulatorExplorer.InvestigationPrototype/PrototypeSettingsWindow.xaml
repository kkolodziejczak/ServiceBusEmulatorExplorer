<Window x:Class="ServiceBusEmulatorExplorer.InvestigationPrototype.PrototypeSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings" Width="520" Height="740" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner"
 Icon="Assets/AppIcon.png" Background="#FAFCFF" Foreground="#17213D" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD8E8"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD8E8"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD8E8"/><Setter Property="Foreground" Value="#234266"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Switch" TargetType="ToggleButton">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" CornerRadius="12" Background="#798BA3" BorderBrush="Transparent" BorderThickness="2"><Ellipse x:Name="Thumb" Fill="White" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#087CF0"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#FAFCFF"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#F5F9FE" BorderBrush="#D7E0EB" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel Orientation="Horizontal"><Image Source="Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="20,16,20,0" Background="Transparent" BorderThickness="0">
   <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="18,9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#526887"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#0069FA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="Background" Value="#EAF3FF"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#0069FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#17213D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
   <TabItem x:Name="GeneralTab" Header="General" AutomationProperties.AutomationId="GeneralTab">
    <ScrollViewer Foreground="#17213D" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,22,4,12">
     <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Close to system tray" FontWeight="SemiBold"/><TextBlock Text="Keep watches running when you close the window." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,5,0,0"/></StackPanel><ToggleButton x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" AutomationProperties.AutomationId="CloseToTrayToggle" AutomationProperties.Name="Close to system tray"/></Grid>
     <TextBlock x:Name="TrayUnavailableText" Text="System tray is unavailable in this session." Foreground="#8A5914" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
     <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop notifications" FontWeight="SemiBold"/><TextBlock Text="Show persistent alerts for new messages in watched entities." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,5,0,0"/></StackPanel><ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="Notifications_Changed" Unchecked="Notifications_Changed" AutomationProperties.AutomationId="NotificationsToggle" AutomationProperties.Name="Desktop notifications"/></Grid>
     <Border Height="1" Background="#DCE5F0" Margin="0,24"/>
     <TextBlock Text="Connections" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Sample profiles · session only. No broker connection is made." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,8,0,14"/>
     <ListBox x:Name="ConnectionPicker" Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ConnectionPicker_Selected" AutomationProperties.AutomationId="ConnectionPicker" AutomationProperties.Name="Connection to use">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#234266"/><Setter Property="Cursor" Value="Hand"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ProfileBorder" Background="White" BorderBrush="#D7E0EB" BorderThickness="1" CornerRadius="4" Padding="12,11" Margin="0,0,0,7">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" Margin="0,0,10,0"><Ellipse x:Name="Ring" Stroke="#879AB3" StrokeThickness="1.5"/><Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="#087CF0" Visibility="Collapsed"/></Grid>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="ProfileBorder" Property="Background" Value="#EAF3FF"/><Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#087CF0"/><Setter TargetName="Ring" Property="Stroke" Value="#087CF0"/><Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#087CF0"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#17213D"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
     </ListBox>
     <WrapPanel Margin="0,8,0,0"><Button x:Name="UseConnectionButton" Content="Use connection" Background="#087CF0" Foreground="White" BorderBrush="#087CF0" Margin="0,0,8,8" Click="UseConnection_Click" AutomationProperties.AutomationId="UseConnectionButton"/><Button Content="Manage connections" Margin="0,0,0,8" Click="ManageConnections_Click" AutomationProperties.AutomationId="ManageConnectionsButton"/></WrapPanel>
     <TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" Foreground="#42689A" FontSize="12" Margin="0,2,0,0" AutomationProperties.AutomationId="ConnectionStatus" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ConnectionsTab" Header="Connections" AutomationProperties.AutomationId="ConnectionsTab">
    <ScrollViewer Foreground="#17213D" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,20,4,12">
     <TextBlock Text="Connection profiles" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Sample data only. Changes stay in memory for this app session; nothing is connected or saved to disk." TextWrapping="Wrap" Foreground="#627692" FontSize="12" Margin="0,8,0,14"/>
     <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" Height="72" BorderBrush="#CBD8E8" SelectionChanged="Profile_Selected" AutomationProperties.AutomationId="ProfilesList" AutomationProperties.Name="Sample connection profiles"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/></Style></ListBox.ItemContainerStyle></ListBox>
     <Label Content="Profile name" Target="{Binding ElementName=ProfileName}" Padding="0" Margin="0,16,0,6"/>
     <TextBox x:Name="ProfileName" AutomationProperties.AutomationId="ProfileName" AutomationProperties.Name="Profile name"/>
     <Label Content="Runtime connection string" Target="{Binding ElementName=RuntimeConnection}" Padding="0" Margin="0,14,0,6"/>
     <PasswordBox x:Name="RuntimeConnection" AutomationProperties.AutomationId="RuntimeConnection" AutomationProperties.Name="Runtime connection string"/>
     <Label Content="Administration connection string" Target="{Binding ElementName=AdministrationConnection}" Padding="0" Margin="0,14,0,6"/>
     <PasswordBox x:Name="AdministrationConnection" AutomationProperties.AutomationId="AdministrationConnection" AutomationProperties.Name="Administration connection string"/>
     <Button x:Name="SaveProfileButton" Content="Save profile" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SaveProfile_Click" AutomationProperties.AutomationId="SaveProfileButton"/>
     <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Foreground="#42689A" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#D7E0EB" BorderThickness="0,1,0,0" Padding="24,14" Background="#F5F9FE"><Button x:Name="DoneButton" Content="Done" Background="#087CF0" Foreground="White" BorderBrush="#087CF0" MinWidth="84" HorizontalAlignment="Right" Click="Done_Click" AutomationProperties.AutomationId="DoneButton" IsCancel="True"/></Border>
 </Grid>
</Window>


