<Window x:Class="ServiceBusEmulatorExplorer.App.SendMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Message"
        Height="560"
        Width="620"
        MinHeight="560"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DialogTitleText"
                       AutomationProperties.AutomationId="SendMessageDialogTitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DestinationText"
                       AutomationProperties.AutomationId="SendMessageDestinationText"
                       Foreground="#607086"
                       Margin="0,4,0,16"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3">
                <TextBlock Text="Body" />
                <TextBox x:Name="BodyTextBox"
                         AutomationProperties.AutomationId="SendMessageBodyTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="170"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,12" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Content type" />
                <TextBox x:Name="ContentTypeTextBox"
                         AutomationProperties.AutomationId="SendMessageContentTypeTextBox"
                         Margin="0,4,0,10" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Subject" />
                <TextBox x:Name="SubjectTextBox"
                         AutomationProperties.AutomationId="SendMessageSubjectTextBox"
                         Margin="0,4,0,10" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Correlation id" />
                <TextBox x:Name="CorrelationIdTextBox"
                         AutomationProperties.AutomationId="SendMessageCorrelationIdTextBox"
                         Margin="0,4,0,10" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Session id" />
                <TextBox x:Name="SessionIdTextBox"
                         AutomationProperties.AutomationId="SendMessageSessionIdTextBox"
                         Margin="0,4,0,10" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                <TextBlock Text="Application properties" />
                <TextBox x:Name="ApplicationPropertiesTextBox"
                         AutomationProperties.AutomationId="SendMessageApplicationPropertiesTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="90"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,10" />
            </StackPanel>

            <TextBlock x:Name="ValidationMessageText"
                       Grid.Row="4"
                       Grid.ColumnSpan="3"
                       AutomationProperties.AutomationId="SendMessageValidationMessageText"
                       Foreground="#C50F1F"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SendButton"
                    AutomationProperties.AutomationId="SendMessageAcceptButton"
                    Content="Send"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="SendButton_Click" />
            <Button AutomationProperties.AutomationId="SendMessageCancelButton"
                    Content="Cancel"
                    MinWidth="96"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
