<Window x:Class="ServiceBusEmulatorExplorer.App.EntityManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Entity"
        Height="430"
        Width="460"
        MinHeight="430"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DialogTitleText"
                       AutomationProperties.AutomationId="EntityDialogTitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DialogSubtitleText"
                       Foreground="#607086"
                       Margin="0,4,0,16"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TopicNamePanel" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Topic name" />
                <TextBox x:Name="TopicNameTextBox"
                         AutomationProperties.AutomationId="EntityDialogTopicNameTextBox"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="NameLabelText" Text="Name" />
                <TextBox x:Name="NameTextBox"
                         AutomationProperties.AutomationId="EntityDialogNameTextBox"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="LockDurationPanel" Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Lock duration seconds" />
                <TextBox x:Name="LockDurationSecondsTextBox"
                         AutomationProperties.AutomationId="EntityDialogLockDurationSecondsTextBox"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="MaxDeliveryPanel" Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Max delivery count" />
                <TextBox x:Name="MaxDeliveryCountTextBox"
                         AutomationProperties.AutomationId="EntityDialogMaxDeliveryCountTextBox"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Default message TTL days" />
                <TextBox x:Name="DefaultTtlDaysTextBox"
                         AutomationProperties.AutomationId="EntityDialogDefaultTtlDaysTextBox"
                         TextChanged="Field_Changed"
                         Margin="0,4,0,0" />
            </StackPanel>

            <CheckBox x:Name="RequiresSessionCheckBox"
                      Grid.Row="5"
                      AutomationProperties.AutomationId="EntityDialogRequiresSessionCheckBox"
                      Content="Requires session"
                      Margin="0,0,0,8"
                      Checked="Field_Changed"
                      Unchecked="Field_Changed" />

            <CheckBox x:Name="RequiresDuplicateDetectionCheckBox"
                      Grid.Row="6"
                      AutomationProperties.AutomationId="EntityDialogRequiresDuplicateDetectionCheckBox"
                      Content="Requires duplicate detection"
                      Margin="0,0,0,8"
                      Checked="Field_Changed"
                      Unchecked="Field_Changed" />

            <TextBlock x:Name="ValidationMessageText"
                       Grid.Row="7"
                       AutomationProperties.AutomationId="EntityDialogValidationMessageText"
                       Foreground="#C50F1F"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CreateOrUpdateButton"
                    AutomationProperties.AutomationId="EntityDialogAcceptButton"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="AcceptButton_Click" />
            <Button AutomationProperties.AutomationId="EntityDialogCancelButton"
                    Content="Cancel"
                    MinWidth="96"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
