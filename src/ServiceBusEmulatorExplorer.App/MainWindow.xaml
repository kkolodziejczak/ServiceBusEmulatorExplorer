<Window x:Class="ServiceBusEmulatorExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServiceBusEmulatorExplorer.App.ViewModels"
        Title="Service Bus Emulator Explorer"
        AutomationProperties.Name="Service Bus Emulator Explorer"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="900">
    <DockPanel Background="#F5F7FA">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D2DAE6" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Label AutomationProperties.AutomationId="ShellTitleText"
                           Content="Service Bus Emulator Explorer"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Padding="0" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#607086" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewQueueButton"
                            AutomationProperties.AutomationId="NewQueueButton"
                            AutomationProperties.Name="New Queue"
                            Content="New Queue"
                            Command="{Binding CreateQueueCommand}"
                            MinWidth="92"
                            Margin="0,0,8,0" />
                    <Button x:Name="NewTopicButton"
                            AutomationProperties.AutomationId="NewTopicButton"
                            AutomationProperties.Name="New Topic"
                            Content="New Topic"
                            Command="{Binding CreateTopicCommand}"
                            MinWidth="92"
                            Margin="0,0,8,0" />
                    <Button x:Name="NewSubscriptionButton"
                            AutomationProperties.AutomationId="NewSubscriptionButton"
                            AutomationProperties.Name="New Subscription"
                            Content="New Subscription"
                            Command="{Binding CreateSubscriptionCommand}"
                            MinWidth="118"
                            Margin="0,0,8,0" />
                    <Button x:Name="ConnectButton"
                            AutomationProperties.AutomationId="ConnectButton"
                            AutomationProperties.Name="Connect"
                            Content="Connect"
                            Command="{Binding ConnectCommand}"
                            MinWidth="92"
                            Margin="0,0,8,0" />
                    <Button x:Name="DisconnectButton"
                            AutomationProperties.AutomationId="DisconnectButton"
                            AutomationProperties.Name="Disconnect"
                            Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            MinWidth="92"
                            Margin="0,0,8,0" />
                    <Button x:Name="RefreshButton"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="Refresh"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinWidth="92"
                            Margin="0,0,8,0" />
                    <Button x:Name="CancelRefreshButton"
                            AutomationProperties.AutomationId="CancelRefreshButton"
                            AutomationProperties.Name="Cancel refresh"
                            Content="Cancel"
                            Command="{Binding CancelRefreshCommand}"
                            MinWidth="92" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <Border Background="White" BorderBrush="#D2DAE6" BorderThickness="1" CornerRadius="6" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Connection Profile" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Name" />
                        <TextBox AutomationProperties.AutomationId="ProfileNameTextBox"
                                 Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <TextBlock Text="Runtime connection string" />
                        <TextBox AutomationProperties.AutomationId="RuntimeConnectionStringTextBox"
                                 Text="{Binding RuntimeConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="84"
                                 Margin="0,4,0,12" />
                        <TextBlock Text="Administration connection string" />
                        <TextBox AutomationProperties.AutomationId="AdministrationConnectionStringTextBox"
                                 Text="{Binding AdministrationConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="84"
                                 Margin="0,4,0,16" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Namespace Tree" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBox Grid.Row="1"
                                 AutomationProperties.AutomationId="NamespaceFilterTextBox"
                                 Text="{Binding NamespaceFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                        <TreeView Grid.Row="2"
                                  x:Name="NamespaceTree"
                                  AutomationProperties.AutomationId="NamespaceTree"
                                  ItemsSource="{Binding EntityTree}"
                                  SelectedItemChanged="NamespaceTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:EntityTreeNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CountsSummary}" Foreground="#607086" FontSize="12" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#D2DAE6" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding EntityBrowserStatus}"
                                       Foreground="#607086"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Entity Detail" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   AutomationProperties.AutomationId="EntityBrowserErrorText"
                                   Text="{Binding EntityBrowserError}"
                                   Foreground="#C50F1F"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2"
                                   AutomationProperties.AutomationId="SelectedEntityTitleText"
                                   Text="{Binding SelectedEntityTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3"
                                   AutomationProperties.AutomationId="SelectedEntityKindText"
                                   Text="{Binding SelectedEntityKind}"
                                   Foreground="#607086"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4"
                                   AutomationProperties.AutomationId="SelectedEntityPathText"
                                   Text="{Binding SelectedEntityPath}"
                                   FontFamily="Consolas"
                                   Foreground="#607086"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="5" Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock AutomationProperties.AutomationId="SelectedEntityCountsText"
                                           Text="{Binding SelectedEntityCounts}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock AutomationProperties.AutomationId="SelectedEntityMetadataText"
                                           Text="{Binding SelectedEntityMetadata}"
                                           Foreground="#607086"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,12">
                                <Button x:Name="SendMessageButton"
                                        AutomationProperties.AutomationId="SendMessageButton"
                                        AutomationProperties.Name="Send Message"
                                        Content="Send Message"
                                        Command="{Binding MessageInspection.SendMessageCommand}"
                                        MinWidth="108"
                                        Margin="0,0,8,0" />
                                <Button x:Name="PeekActiveMessagesButton"
                                        AutomationProperties.AutomationId="PeekActiveMessagesButton"
                                        AutomationProperties.Name="Peek Active"
                                        Content="Peek Active"
                                        Command="{Binding MessageInspection.PeekActiveMessagesCommand}"
                                        MinWidth="96"
                                        Margin="0,0,8,0" />
                                <Button x:Name="PeekNextActiveMessagesButton"
                                        AutomationProperties.AutomationId="PeekNextActiveMessagesButton"
                                        AutomationProperties.Name="Next Active"
                                        Content="Next Active"
                                        Command="{Binding MessageInspection.PeekNextActiveMessagesCommand}"
                                        MinWidth="96"
                                        Margin="0,0,8,0" />
                                <Button x:Name="PeekDeadLetterMessagesButton"
                                        AutomationProperties.AutomationId="PeekDeadLetterMessagesButton"
                                        AutomationProperties.Name="Peek DLQ"
                                        Content="Peek DLQ"
                                        Command="{Binding MessageInspection.PeekDeadLetterMessagesCommand}"
                                        MinWidth="88"
                                        Margin="0,0,8,0" />
                                <Button x:Name="PeekNextDeadLetterMessagesButton"
                                        AutomationProperties.AutomationId="PeekNextDeadLetterMessagesButton"
                                        AutomationProperties.Name="Next DLQ"
                                        Content="Next DLQ"
                                        Command="{Binding MessageInspection.PeekNextDeadLetterMessagesCommand}"
                                        MinWidth="88"
                                        Margin="0,0,8,0" />
                                <Button x:Name="ReplayDeadLetterButton"
                                        AutomationProperties.AutomationId="ReplayDeadLetterButton"
                                        AutomationProperties.Name="Replay DLQ Copy"
                                        Content="Replay"
                                        Command="{Binding MessageInspection.ReplayDeadLetterCommand}"
                                        MinWidth="86"
                                        Margin="0,0,8,0" />
                                <Button x:Name="EditReplayDeadLetterButton"
                                        AutomationProperties.AutomationId="EditReplayDeadLetterButton"
                                        AutomationProperties.Name="Edit and Replay DLQ"
                                        Content="Edit Replay"
                                        Command="{Binding MessageInspection.EditAndReplayDeadLetterCommand}"
                                        MinWidth="100"
                                        Margin="0,0,8,0" />
                                <Button x:Name="DeleteSelectedDeadLetterButton"
                                        AutomationProperties.AutomationId="DeleteSelectedDeadLetterButton"
                                        AutomationProperties.Name="Delete Selected DLQ"
                                        Content="Delete DLQ"
                                        Command="{Binding MessageInspection.DeleteSelectedDeadLetterCommand}"
                                        MinWidth="94"
                                        Margin="0,0,8,0" />
                                <Button x:Name="DeleteVisibleDeadLetterButton"
                                        AutomationProperties.AutomationId="DeleteVisibleDeadLetterButton"
                                        AutomationProperties.Name="Delete Visible DLQ"
                                        Content="Delete Visible"
                                        Command="{Binding MessageInspection.DeleteVisibleDeadLetterCommand}"
                                        MinWidth="112"
                                        Margin="0,0,8,0" />
                                <Button x:Name="UpdateEntityButton"
                                        AutomationProperties.AutomationId="UpdateEntityButton"
                                        AutomationProperties.Name="Update"
                                        Content="Update"
                                        Command="{Binding UpdateSelectedEntityCommand}"
                                        MinWidth="96"
                                        Margin="0,0,8,0" />
                                <Button x:Name="DeleteEntityButton"
                                        AutomationProperties.AutomationId="DeleteEntityButton"
                                        AutomationProperties.Name="{Binding SelectedEntityDeleteLabel}"
                                        Content="{Binding SelectedEntityDeleteLabel}"
                                        Command="{Binding DeleteSelectedEntityCommand}"
                                        MinWidth="116" />
                            </WrapPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock AutomationProperties.AutomationId="MessageInspectionStatusText"
                                               Text="{Binding MessageInspection.Status}"
                                               Foreground="#607086"
                                               TextWrapping="Wrap" />
                                    <TextBlock AutomationProperties.AutomationId="MessageInspectionErrorText"
                                               Text="{Binding MessageInspection.Error}"
                                               Foreground="#C50F1F"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,8" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TabControl AutomationProperties.AutomationId="MessageTabs">
                                        <TabItem Header="Active">
                                            <DataGrid x:Name="ActiveMessagesGrid"
                                                      AutomationProperties.AutomationId="ActiveMessagesGrid"
                                                      ItemsSource="{Binding MessageInspection.ActiveMessages}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      SelectionChanged="MessageGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="34">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                          IsHitTestVisible="False"
                                                                          HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Seq" Binding="{Binding SequenceNumber}" Width="70" />
                                                    <DataGridTextColumn Header="Message Id" Binding="{Binding MessageId}" Width="160" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding BodySizeBytes}" Width="70" />
                                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="120" />
                                                    <DataGridTextColumn Header="Enqueued UTC" Binding="{Binding EnqueuedTime, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="160" />
                                                    <DataGridTextColumn Header="Expires UTC" Binding="{Binding ExpiresAt, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="160" />
                                                    <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryCount}" Width="70" />
                                                    <DataGridTextColumn Header="Preview" Binding="{Binding BodyPreview}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Dead Letter">
                                            <DataGrid x:Name="DeadLetterMessagesGrid"
                                                      AutomationProperties.AutomationId="DeadLetterMessagesGrid"
                                                      ItemsSource="{Binding MessageInspection.DeadLetterMessages}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Extended"
                                                      SelectionChanged="MessageGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="34">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                          IsHitTestVisible="False"
                                                                          HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Seq" Binding="{Binding SequenceNumber}" Width="70" />
                                                    <DataGridTextColumn Header="Message Id" Binding="{Binding MessageId}" Width="160" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding BodySizeBytes}" Width="70" />
                                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="120" />
                                                    <DataGridTextColumn Header="Enqueued UTC" Binding="{Binding EnqueuedTime, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="160" />
                                                    <DataGridTextColumn Header="Expires UTC" Binding="{Binding ExpiresAt, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="160" />
                                                    <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryCount}" Width="70" />
                                                    <DataGridTextColumn Header="Preview" Binding="{Binding BodyPreview}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <GroupBox Header="Body">
                                            <TextBox AutomationProperties.AutomationId="SelectedMessageBodyText"
                                                     Text="{Binding MessageInspection.SelectedBody, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </GroupBox>

                                        <GroupBox Grid.Row="2" Header="System Properties">
                                            <TextBox AutomationProperties.AutomationId="SelectedMessageSystemPropertiesText"
                                                     Text="{Binding MessageInspection.SelectedSystemProperties, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </GroupBox>

                                        <GroupBox Grid.Row="4" Header="Application Properties">
                                            <TextBox AutomationProperties.AutomationId="SelectedMessageApplicationPropertiesText"
                                                     Text="{Binding MessageInspection.SelectedApplicationProperties, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </GroupBox>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#101827" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Operation Log" Foreground="#EEF5FF" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox AutomationProperties.AutomationId="OperationLogList"
                                 ItemsSource="{Binding OperationLog}"
                                 Background="#101827"
                                 BorderThickness="0"
                                 Foreground="#EEF5FF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
