<Window x:Class="ServiceBusEmulatorExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServiceBusEmulatorExplorer.App.ViewModels"
        Title="Service Bus Emulator Explorer"
        Icon="Assets/AppIcon.ico"
        AutomationProperties.Name="Service Bus Emulator Explorer"
        Height="780"
        Width="1500"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B9C5D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ConnectButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="BorderBrush" Value="#0F6CBD" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="#EAF6EA" />
                    <Setter Property="BorderBrush" Value="#8CCF8C" />
                    <Setter Property="Foreground" Value="#107C10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarRowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ConnectToolbarRowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ConnectButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,4" />
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#C50F1F" />
            <Setter Property="Background" Value="#FFF8F8" />
            <Setter Property="BorderBrush" Value="#F0B9BF" />
        </Style>

        <Style x:Key="ActionStripButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="DangerActionStripButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerActionButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#637083" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#1F2A44" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CompactFieldValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#1F2A44" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="InspectorTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="MessageBodyTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource InspectorTextBoxStyle}">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#E5EDF8" />
        </Style>

        <Style x:Key="ToolbarFieldLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="#F3F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" MinHeight="360" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" MinHeight="110" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="18,0" MinHeight="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="38"
                           Height="38"
                           Margin="0,0,10,0"
                           Source="Assets/AppIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           AutomationProperties.Name="Service Bus Emulator Explorer icon" />
                    <TextBlock AutomationProperties.AutomationId="ShellTitleText"
                               Text="Service Bus Emulator Explorer"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#107C10" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#637083" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="ConnectButton"
                            AutomationProperties.AutomationId="ConnectButton"
                            AutomationProperties.Name="{Binding ConnectControlAutomationName}"
                            Content="{Binding ConnectControlContent}"
                            Command="{Binding ConnectCommand}"
                            ToolTip="{Binding ConnectCommandToolTip}"
                            Style="{StaticResource ConnectToolbarRowButtonStyle}" />
                    <Button x:Name="DisconnectButton"
                            AutomationProperties.AutomationId="DisconnectButton"
                            AutomationProperties.Name="Disconnect"
                            Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            ToolTip="{Binding DisconnectCommandToolTip}"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                    <Button x:Name="RefreshButton"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="Refresh"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            ToolTip="{Binding RefreshCommandToolTip}"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                    <Button x:Name="CancelRefreshButton"
                            AutomationProperties.AutomationId="CancelRefreshButton"
                            AutomationProperties.Name="Cancel refresh"
                            Content="Cancel"
                            Command="{Binding CancelRefreshCommand}"
                            ToolTip="{Binding CancelRefreshCommandToolTip}"
                            Visibility="{Binding CanShowCancelRefreshCommand, Converter={StaticResource BoolToVisibility}}"
                            MinWidth="76"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                    <Rectangle Width="1" Height="24" Fill="#D8E0EA" Margin="0,0,12,0" />
                    <Button x:Name="NewQueueButton"
                            AutomationProperties.AutomationId="NewQueueButton"
                            AutomationProperties.Name="New Queue"
                            Content="New Queue"
                            Command="{Binding CreateQueueCommand}"
                            ToolTip="{Binding CreateQueueCommandToolTip}"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                    <Button x:Name="NewTopicButton"
                            AutomationProperties.AutomationId="NewTopicButton"
                            AutomationProperties.Name="New Topic"
                            Content="New Topic"
                            Command="{Binding CreateTopicCommand}"
                            ToolTip="{Binding CreateTopicCommandToolTip}"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                    <Button x:Name="NewSubscriptionButton"
                            AutomationProperties.AutomationId="NewSubscriptionButton"
                            AutomationProperties.Name="New Subscription"
                            Content="New Subscription"
                            Command="{Binding CreateSubscriptionCommand}"
                            ToolTip="{Binding CreateSubscriptionCommandToolTip}"
                            MinWidth="118"
                            Style="{StaticResource ToolbarRowButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile" Style="{StaticResource ToolbarFieldLabelStyle}" />
                    <TextBox AutomationProperties.AutomationId="ProfileNameTextBox"
                             Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                             Width="132"
                             Style="{StaticResource ToolbarTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Auth" Style="{StaticResource ToolbarFieldLabelStyle}" />
                    <ComboBox AutomationProperties.AutomationId="AuthenticationModeSelector"
                              AutomationProperties.Name="Authentication mode"
                              ItemsSource="{Binding AuthenticationModes}"
                              SelectedItem="{Binding AuthenticationMode, UpdateSourceTrigger=PropertyChanged}"
                              Width="110"
                              ToolTip="Choose connection strings or the Azure CLI account cached by az login." />
                </StackPanel>
                <Grid Grid.Column="6" VerticalAlignment="Center">
                    <Grid Visibility="{Binding IsConnectionStringMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Runtime" Style="{StaticResource ToolbarFieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="RuntimeConnectionStringTextBox"
                                     Text="{Binding RuntimeConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="80" Style="{StaticResource ToolbarTextBoxStyle}"
                                     ToolTip="Connection string used for sending, peeking, replaying, and deleting messages." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Admin" Style="{StaticResource ToolbarFieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="AdministrationConnectionStringTextBox"
                                     Text="{Binding AdministrationConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="80" Style="{StaticResource ToolbarTextBoxStyle}"
                                     ToolTip="Connection string used for creating, updating, deleting, and refreshing queues, topics, and subscriptions." />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsAzureCliMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Namespace" Style="{StaticResource ToolbarFieldLabelStyle}" />
                        <TextBox AutomationProperties.AutomationId="FullyQualifiedNamespaceTextBox"
                                 Text="{Binding FullyQualifiedNamespace, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220" Style="{StaticResource ToolbarTextBoxStyle}"
                                 ToolTip="Service Bus namespace hostname used with the account cached by az login." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*" MinWidth="240" MaxWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="12,12">
                        <TextBlock Text="Namespace" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>

                    <Border Grid.Row="1" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="12,10">
                        <TextBox AutomationProperties.AutomationId="NamespaceFilterTextBox"
                                 Text="{Binding NamespaceFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter queues, topics, subscriptions" />
                    </Border>

                    <TreeView Grid.Row="2"
                              x:Name="NamespaceTree"
                              AutomationProperties.AutomationId="NamespaceTree"
                              ItemsSource="{Binding EntityTree}"
                              BorderThickness="0"
                              Padding="10"
                              SelectedItemChanged="NamespaceTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0F6CBD" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0F6CBD" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:EntityTreeNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid MinHeight="28" Margin="0,1">
                                    <Grid.Resources>
                                        <Style x:Key="TreeNodeTextStyle" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="#172033" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="TreeNodeCountsStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TreeNodeTextStyle}">
                                            <Setter Property="Foreground" Value="#475569" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="{Binding IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconText}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Margin="6,0" Style="{StaticResource TreeNodeTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountsSummary}" Style="{StaticResource TreeNodeCountsStyle}" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border Grid.Column="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock AutomationProperties.AutomationId="SelectedEntityTitleText"
                                           AutomationProperties.Name="{Binding SelectedEntityTitle}"
                                           Text="{Binding SelectedEntityHeading}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock AutomationProperties.AutomationId="SelectedEntityKindText"
                                               Text="{Binding SelectedEntityKind}"
                                               Foreground="#075985"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <UniformGrid Columns="3" Rows="2">
                                <Grid Margin="0,0,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Relative URI" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock AutomationProperties.AutomationId="SelectedEntityPathText"
                                               Grid.Column="1"
                                               Text="{Binding SelectedEntityPath}"
                                               Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                                <Grid Margin="0,0,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Created UTC" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntityCreatedAtUtc}" Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                                <Grid Margin="0,0,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max Delivery" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntityMaxDeliveryCount}" Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                                <Grid Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock Duration" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntityLockDuration}" Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                                <Grid Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Default TTL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntityDefaultTtl}" Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                                <Grid Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock AutomationProperties.AutomationId="SelectedEntityMetadataText"
                                               Grid.Column="1"
                                               AutomationProperties.Name="{Binding SelectedEntityMetadata}"
                                               Text="{Binding SelectedEntityStatus}"
                                               Style="{StaticResource CompactFieldValueStyle}" />
                                </Grid>
                            </UniformGrid>
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="4" VerticalAlignment="Top" Margin="14,0,0,0">
                            <Border BorderBrush="#D8E0EA" BorderThickness="1" Background="#F8FAFC" CornerRadius="5" Padding="7,4" Margin="0,0,6,0" MinWidth="54">
                                <StackPanel>
                                    <TextBlock Text="Active" Foreground="#637083" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedEntityActiveCount}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#D8E0EA" BorderThickness="1" Background="#F8FAFC" CornerRadius="5" Padding="7,4" Margin="0,0,6,0" MinWidth="54">
                                <StackPanel>
                                    <TextBlock Text="DLQ" Foreground="#637083" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedEntityDeadLetterCount}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#D8E0EA" BorderThickness="1" Background="#F8FAFC" CornerRadius="5" Padding="7,4" Margin="0,0,6,0" MinWidth="68">
                                <StackPanel>
                                    <TextBlock Text="Scheduled" Foreground="#637083" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedEntityScheduledCount}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#D8E0EA" BorderThickness="1" Background="#F8FAFC" CornerRadius="5" Padding="7,4" MinWidth="54">
                                <StackPanel>
                                    <TextBlock Text="Total" Foreground="#637083" FontSize="11" />
                                    <TextBlock AutomationProperties.AutomationId="SelectedEntityCountsText"
                                               AutomationProperties.Name="{Binding SelectedEntityCounts}"
                                               Text="{Binding SelectedEntityTotalCount}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="1" Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="230" />
                            <RowDefinition Height="Auto" MinHeight="48" />
                        </Grid.RowDefinitions>

                        <TextBlock AutomationProperties.AutomationId="EntityBrowserErrorText"
                                   Text="{Binding EntityBrowserError}"
                                   Foreground="#C50F1F"
                                   TextWrapping="Wrap"
                                   Margin="12,8,12,0" />

                        <Grid Grid.Row="1" Margin="12,8,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="430" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Padding="10,6,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Message List" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,6" />
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="PeekActiveMessagesButton"
                                                AutomationProperties.AutomationId="PeekActiveMessagesButton"
                                                AutomationProperties.Name="Peek Active"
                                                Content="Peek Active"
                                                Command="{Binding MessageInspection.PeekActiveMessagesCommand}"
                                                ToolTip="{Binding MessageInspection.PeekActiveMessagesCommandToolTip}"
                                                Visibility="{Binding MessageInspection.CanShowPeekMessageCommands, Converter={StaticResource BoolToVisibility}}"
                                                MinWidth="88"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        <Button x:Name="PeekNextActiveMessagesButton"
                                                AutomationProperties.AutomationId="PeekNextActiveMessagesButton"
                                                AutomationProperties.Name="Next Active"
                                                Content="Next Active"
                                                Command="{Binding MessageInspection.PeekNextActiveMessagesCommand}"
                                                ToolTip="{Binding MessageInspection.PeekNextActiveMessagesCommandToolTip}"
                                                Visibility="{Binding MessageInspection.CanShowPeekMessageCommands, Converter={StaticResource BoolToVisibility}}"
                                                MinWidth="88"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        <Button x:Name="PeekDeadLetterMessagesButton"
                                                AutomationProperties.AutomationId="PeekDeadLetterMessagesButton"
                                                AutomationProperties.Name="Peek DLQ"
                                                Content="Peek DLQ"
                                                Command="{Binding MessageInspection.PeekDeadLetterMessagesCommand}"
                                                ToolTip="{Binding MessageInspection.PeekDeadLetterMessagesCommandToolTip}"
                                                Visibility="{Binding MessageInspection.CanShowPeekMessageCommands, Converter={StaticResource BoolToVisibility}}"
                                                MinWidth="82"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        <Button x:Name="PeekNextDeadLetterMessagesButton"
                                                AutomationProperties.AutomationId="PeekNextDeadLetterMessagesButton"
                                                AutomationProperties.Name="Next DLQ"
                                                Content="Next DLQ"
                                                Command="{Binding MessageInspection.PeekNextDeadLetterMessagesCommand}"
                                                ToolTip="{Binding MessageInspection.PeekNextDeadLetterMessagesCommandToolTip}"
                                                Visibility="{Binding MessageInspection.CanShowPeekMessageCommands, Converter={StaticResource BoolToVisibility}}"
                                                MinWidth="82"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        <Button AutomationProperties.Name="Copy Body"
                                                Content="Copy Body"
                                                IsEnabled="False"
                                                ToolTip="Copy the selected message body. Unavailable: copy body is not wired in this build."
                                                AutomationProperties.HelpText="Copy the selected message body. Unavailable: copy body is not wired in this build."
                                                MinWidth="84"
                                                Style="{StaticResource ActionButtonStyle}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1"
                                        AutomationProperties.AutomationId="MessageTabs"
                                        SelectedIndex="{Binding MessageInspection.SelectedMessageTabIndex, Mode=TwoWay}"
                                        BorderBrush="#D8E0EA"
                                        Background="White">
                                <TabItem Header="Description">
                                    <ScrollViewer Padding="12">
                                        <TextBlock Text="{Binding SelectedEntityMetadata}" TextWrapping="Wrap" Foreground="#42536A" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Messages">
                                    <DataGrid x:Name="ActiveMessagesGrid"
                                              AutomationProperties.AutomationId="ActiveMessagesGrid"
                                              ItemsSource="{Binding MessageInspection.ActiveMessages}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionChanged="MessageGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Select" Width="Auto" MinWidth="54">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                  IsHitTestVisible="False"
                                                                  HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="MessageId" Binding="{Binding MessageId}" Width="2*" MinWidth="130" />
                                            <DataGridTextColumn Header="Seq" Binding="{Binding SequenceNumber}" Width="0.7*" MinWidth="56" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding BodySizeBytes}" Width="0.7*" MinWidth="56" />
                                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="1.4*" MinWidth="90" />
                                            <DataGridTextColumn Header="EnqueuedTimeUtc" Binding="{Binding EnqueuedTime, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="2*" MinWidth="150" />
                                            <DataGridTextColumn Header="ExpiresAtUtc" Binding="{Binding ExpiresAt, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="2*" MinWidth="150" />
                                            <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryCount}" Width="0.8*" MinWidth="64" />
                                            <DataGridTextColumn Header="Preview" Binding="{Binding BodyPreview}" Width="3*" MinWidth="180" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Dead Letter">
                                    <DataGrid x:Name="DeadLetterMessagesGrid"
                                              AutomationProperties.AutomationId="DeadLetterMessagesGrid"
                                              ItemsSource="{Binding MessageInspection.DeadLetterMessages}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Extended"
                                              SelectionChanged="MessageGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Select" Width="Auto" MinWidth="54">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                  IsHitTestVisible="False"
                                                                  HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="MessageId" Binding="{Binding MessageId}" Width="2*" MinWidth="130" />
                                            <DataGridTextColumn Header="Seq" Binding="{Binding SequenceNumber}" Width="0.7*" MinWidth="56" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding BodySizeBytes}" Width="0.7*" MinWidth="56" />
                                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="1.4*" MinWidth="90" />
                                            <DataGridTextColumn Header="EnqueuedTimeUtc" Binding="{Binding EnqueuedTime, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="2*" MinWidth="150" />
                                            <DataGridTextColumn Header="ExpiresAtUtc" Binding="{Binding ExpiresAt, StringFormat={}{0:yyyy-MM-ddTHH:mm:ss.fffZ}}" Width="2*" MinWidth="150" />
                                            <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryCount}" Width="0.8*" MinWidth="64" />
                                            <DataGridTextColumn Header="Preview" Binding="{Binding BodyPreview}" Width="3*" MinWidth="180" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      Background="#E4EAF2"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True" />

                        <Grid Grid.Column="2">
                            <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,8">
                                        <TextBlock Text="Selected Message" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <TabControl Grid.Row="1"
                                                AutomationProperties.AutomationId="SelectedMessageInspectorTabs"
                                                Background="White"
                                                BorderThickness="0">
                                        <TabItem Header="Body">
                                            <TextBox AutomationProperties.AutomationId="SelectedMessageBodyText"
                                                     Text="{Binding MessageInspection.SelectedBody, Mode=OneWay}"
                                                     Style="{StaticResource MessageBodyTextBoxStyle}" />
                                        </TabItem>
                                        <TabItem Header="Properties">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="220" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" MinWidth="220" />
                                                </Grid.ColumnDefinitions>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,7">
                                                        <TextBlock Text="System Properties" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBox Grid.Row="1"
                                                             AutomationProperties.AutomationId="SelectedMessageSystemPropertiesText"
                                                             Text="{Binding MessageInspection.SelectedSystemProperties, Mode=OneWay}"
                                                             Style="{StaticResource InspectorTextBoxStyle}" />
                                                </Grid>
                                                <Rectangle Grid.Column="1" Fill="#D8E0EA" />
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,7">
                                                        <TextBlock Text="Custom Properties" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBox Grid.Row="1"
                                                             AutomationProperties.AutomationId="SelectedMessageApplicationPropertiesText"
                                                             Text="{Binding MessageInspection.SelectedApplicationProperties, Mode=OneWay}"
                                                             Style="{StaticResource InspectorTextBoxStyle}" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                        </Grid>

                        <Border Grid.Row="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="12,6">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <Button x:Name="SendMessageButton"
                                            AutomationProperties.AutomationId="SendMessageButton"
                                            AutomationProperties.Name="Send New Message"
                                            Content="Send"
                                            Command="{Binding MessageInspection.SendMessageCommand}"
                                            ToolTip="{Binding MessageInspection.SendMessageCommandToolTip}"
                                            Visibility="{Binding MessageInspection.CanShowSendMessageCommand, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="RefreshSubscriptionsButton"
                                            AutomationProperties.AutomationId="RefreshSubscriptionsButton"
                                            AutomationProperties.Name="Refresh Subscriptions"
                                            Content="Refresh Subscriptions"
                                            Command="{Binding RefreshSelectedTopicSubscriptionsCommand}"
                                            ToolTip="{Binding RefreshSelectedTopicSubscriptionsCommandToolTip}"
                                            Visibility="{Binding CanShowRefreshSubscriptionsCommand, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="136"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="ReplayDeadLetterButton"
                                            AutomationProperties.AutomationId="ReplayDeadLetterButton"
                                            AutomationProperties.Name="Replay DLQ Copy"
                                            AutomationProperties.HelpText="{Binding MessageInspection.ReplayDeadLetterCommandToolTip}"
                                            Content="Replay"
                                            Command="{Binding MessageInspection.ReplayDeadLetterCommand}"
                                            ToolTip="{Binding MessageInspection.ReplayDeadLetterCommandToolTip}"
                                            Visibility="{Binding MessageInspection.CanShowDeadLetterCommands, Converter={StaticResource BoolToVisibility}}"
                                            Background="#0F6CBD"
                                            BorderBrush="#0F6CBD"
                                            Foreground="White"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="EditReplayDeadLetterButton"
                                            AutomationProperties.AutomationId="EditReplayDeadLetterButton"
                                            AutomationProperties.Name="Edit and Replay DLQ"
                                            Content="Edit Replay"
                                            Command="{Binding MessageInspection.EditAndReplayDeadLetterCommand}"
                                            ToolTip="{Binding MessageInspection.EditAndReplayDeadLetterCommandToolTip}"
                                            Visibility="{Binding MessageInspection.CanShowDeadLetterCommands, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="98"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="DeleteSelectedDeadLetterButton"
                                            AutomationProperties.AutomationId="DeleteSelectedDeadLetterButton"
                                            AutomationProperties.Name="Delete Selected DLQ"
                                            Content="Selected"
                                            Command="{Binding MessageInspection.DeleteSelectedDeadLetterCommand}"
                                            ToolTip="{Binding MessageInspection.DeleteSelectedDeadLetterCommandToolTip}"
                                            Visibility="{Binding MessageInspection.CanShowDeadLetterCommands, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="82"
                                            Style="{StaticResource DangerActionStripButtonStyle}" />
                                    <Button x:Name="DeleteVisibleDeadLetterButton"
                                            AutomationProperties.AutomationId="DeleteVisibleDeadLetterButton"
                                            AutomationProperties.Name="Delete Visible DLQ"
                                            Content="Visible"
                                            Command="{Binding MessageInspection.DeleteVisibleDeadLetterCommand}"
                                            ToolTip="{Binding MessageInspection.DeleteVisibleDeadLetterCommandToolTip}"
                                            Visibility="{Binding MessageInspection.CanShowDeadLetterCommands, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="76"
                                            Style="{StaticResource DangerActionStripButtonStyle}" />
                                    <Rectangle Width="1" Height="24" Fill="#D8E0EA" Margin="0,3,8,3" VerticalAlignment="Center" />
                                    <Button AutomationProperties.Name="Refresh"
                                            Content="Refresh"
                                            Command="{Binding RefreshCommand}"
                                            ToolTip="{Binding RefreshCommandToolTip}"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="UpdateEntityButton"
                                            AutomationProperties.AutomationId="UpdateEntityButton"
                                            AutomationProperties.Name="Update"
                                            Content="Update"
                                            Command="{Binding UpdateSelectedEntityCommand}"
                                            ToolTip="{Binding UpdateSelectedEntityCommandToolTip}"
                                            Visibility="{Binding CanShowSelectedEntityCommands, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource ActionStripButtonStyle}" />
                                    <Button x:Name="DeleteEntityButton"
                                            AutomationProperties.AutomationId="DeleteEntityButton"
                                            AutomationProperties.Name="{Binding SelectedEntityDeleteLabel}"
                                            Content="{Binding SelectedEntityDeleteLabel}"
                                            Command="{Binding DeleteSelectedEntityCommand}"
                                            ToolTip="{Binding DeleteSelectedEntityCommandToolTip}"
                                            Visibility="{Binding CanShowSelectedEntityCommands, Converter={StaticResource BoolToVisibility}}"
                                            MinWidth="112"
                                            Style="{StaticResource DangerActionStripButtonStyle}" />
                                </StackPanel>
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="MessageInspectionStatusText"
                                               Text="{Binding MessageInspection.Status}"
                                               Foreground="#637083"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock AutomationProperties.AutomationId="MessageInspectionErrorText"
                                               Text="{Binding MessageInspection.Error}"
                                               Foreground="#C50F1F"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" />

        <Border Grid.Row="4" Margin="12,0,12,8" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="12,9">
                    <TextBlock Text="Operation Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <ListBox Grid.Row="1"
                         AutomationProperties.AutomationId="OperationLogList"
                         ItemsSource="{Binding OperationLog}"
                         Background="#101827"
                         BorderThickness="0"
                         Foreground="#D8E4F0"
                         FontFamily="Consolas"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="14,0" MinHeight="28">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#637083" Margin="0,0,16,0" />
                    <TextBlock Text="Transport: AMQP" Foreground="#637083" Margin="0,0,16,0" />
                    <TextBlock Text="Mode: Direct SDK" Foreground="#637083" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding EntityBrowserStatus}" Foreground="#637083" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
