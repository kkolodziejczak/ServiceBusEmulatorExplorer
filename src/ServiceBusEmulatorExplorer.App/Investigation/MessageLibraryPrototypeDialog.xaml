<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.MessageLibraryPrototypeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Message Workbench" Width="760" Height="690" MinWidth="640" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="DialogLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="DialogCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><Grid Margin="9,0"><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" Margin="0,0,18,0"/><Path Data="M0,0 L4,4 L8,0" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="2,2,24,2" Padding="7,4" Background="{DynamicResource RaisedBrush}" BorderThickness="0" VerticalContentAlignment="Center"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,7"/></Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="CenteredDataGridCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/></Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CenteredDataGridColumnHeader}"/>
  <Style TargetType="DataGridRow" BasedOn="{StaticResource CenteredDataGridRow}"/>
  <Style TargetType="DataGridCell" BasedOn="{StaticResource CenteredDataGridCell}"/>
 </ResourceDictionary></Window.Resources>
 <Border Margin="16" Padding="22" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
    <StackPanel x:Name="SampleCsvSurface" Visibility="Collapsed">
     <TextBlock Text="Choose sample CSV" Style="{StaticResource DialogHeading}"/>
     <TextBlock Text="These in-memory fixtures let you test a complete valid batch or a row with an invalid amount. No local file is read." TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="Sample file" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/>
     <ComboBox x:Name="SampleCsvPicker" SelectedIndex="0" AutomationProperties.Name="Sample CSV fixture" AutomationProperties.AutomationId="PrototypeSampleCsvPicker"><ComboBoxItem Content="orders.csv — 3 valid rows" Tag="orders.csv"/><ComboBoxItem Content="orders-invalid.csv — row 2 amount is abc" Tag="orders-invalid.csv"/></ComboBox>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Close_Click"/><Button Content="Use sample" Click="UseSampleCsv_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeUseSampleCsv"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="MappingSurface">
     <TextBlock Text="Map CSV inputs" Style="{StaticResource DialogHeading}"/>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="CSV file" Style="{StaticResource DialogLabel}"/><TextBox x:Name="MappingFile" Grid.Column="1" Text="orders.csv" IsReadOnly="True"/><Button Grid.Column="2" Content="Browse..." Click="BrowseSample_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="PrototypeMappingBrowse"/></Grid>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Delimiter" Style="{StaticResource DialogLabel}"/><ComboBox x:Name="MappingDelimiter" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="CSV delimiter"><ComboBoxItem Content="Comma"/><ComboBoxItem Content="Semicolon"/></ComboBox></Grid>
     <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3"><StackPanel>
      <Grid Background="{DynamicResource ColumnHeaderBrush}" Height="39"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Variable" Margin="10,10" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Declared type" Margin="10,10" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Input source" Margin="10,10" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Value" Margin="10,10" FontWeight="SemiBold"/></Grid>
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CustomerId" Margin="10,8"/><TextBlock Grid.Column="1" Text="string" Margin="10,8"/><ComboBox x:Name="CustomerSource" Grid.Column="2" SelectedIndex="0" Margin="5,0" SelectionChanged="MappingSource_Changed"><ComboBoxItem Content="CSV column"/><ComboBoxItem Content="Constant"/><ComboBoxItem Content="Declared default"/></ComboBox><ComboBox x:Name="CustomerValue" Grid.Column="3" IsEditable="True" Text="CustomerId" Margin="5,0" AutomationProperties.Name="CustomerId input mapping"><ComboBoxItem Content="CustomerId"/><ComboBoxItem Content="Amount"/></ComboBox></Grid>
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Amount" Margin="10,8"/><TextBlock Grid.Column="1" Text="number" Margin="10,8"/><ComboBox x:Name="AmountSource" Grid.Column="2" SelectedIndex="0" Margin="5,0" SelectionChanged="MappingSource_Changed"><ComboBoxItem Content="CSV column"/><ComboBoxItem Content="Constant"/><ComboBoxItem Content="Declared default"/></ComboBox><ComboBox x:Name="AmountValue" Grid.Column="3" IsEditable="True" Text="Amount" Margin="5,0" AutomationProperties.Name="Amount input mapping"><ComboBoxItem Content="Amount"/><ComboBoxItem Content="CustomerId"/></ComboBox></Grid>
      <TextBlock Text="Generated by template (read only)" FontWeight="SemiBold" Background="{DynamicResource ColumnHeaderBrush}" Padding="10,8"/>
      <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="EventId" Margin="10,7"/><TextBlock Grid.Column="1" Text="string" Margin="10,7"/><TextBlock Grid.Column="2" Text="New GUID per row" Margin="10,7"/><TextBlock Grid.Column="3" Text="not applicable" Margin="10,7"/></Grid>
      <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="OccurredAt" Margin="10,7"/><TextBlock Grid.Column="1" Text="string" Margin="10,7"/><TextBlock Grid.Column="2" Text="Current UTC per run" Margin="10,7"/><TextBlock Grid.Column="3" Text="not applicable" Margin="10,7"/></Grid>
     </StackPanel></Border>
     <TextBlock Text="Input sources: Column / Constant / Declared default." Style="{StaticResource DialogCaption}" Margin="0,8,0,0"/>
     <TextBlock x:Name="MappingError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Close_Click" MinWidth="105"/><Button Content="Apply mapping" Click="ApplyMapping_Click" Style="{StaticResource PrimaryButton}" MinWidth="150" AutomationProperties.AutomationId="PrototypeApplyMapping"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="CaptureSurface" Visibility="Collapsed">
     <TextBlock Text="Save as template" Style="{StaticResource DialogHeading}"/>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Source" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureSource" Grid.Column="1" IsReadOnly="True" Text="order-events / billing · Active"/></Grid>
     <TextBlock Text="Message body" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,13"><RadioButton x:Name="CaptureOriginal" Content="Original (as received)" IsChecked="True" GroupName="CaptureBody" Checked="CaptureBody_Checked" Margin="0,0,24,0"/><RadioButton x:Name="CaptureEdited" Content="Edited (current in editor)" GroupName="CaptureBody" Checked="CaptureBody_Checked"/></StackPanel>
     <TextBlock Text="Message preview (read only)" Margin="0,0,0,6"/><TextBox x:Name="CapturePreview" Height="140" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource EditorForegroundBrush}" Background="{DynamicResource EditorBackgroundBrush}" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Template name" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureName" Grid.Column="1" Text="Order created" AutomationProperties.AutomationId="PrototypeCaptureName"/></Grid>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Save to local collection" Style="{StaticResource DialogLabel}"/><ComboBox x:Name="CaptureCollection" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Team messages/Orders"/><ComboBoxItem Content="Team messages/Archive"/></ComboBox></Grid>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Filename" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureFileName" Grid.Column="1" Text="order-created.sbetemplate.json"/></Grid>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Topic association" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureAssociation" Grid.Column="1" Text="order-events"/></Grid>
     <TextBlock Text="The association filters the library. Sending still requires review." Style="{StaticResource DialogCaption}" Margin="180,0,0,12"/>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Message ID" Style="{StaticResource DialogLabel}"/><TextBox Grid.Column="1" Text="Generate new" IsReadOnly="True"/></Grid>
     <CheckBox x:Name="CaptureCopyTtl" Content="Copy observed TTL (if present)" Margin="0,0,0,15"/>
     <Border Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,8"><TextBlock x:Name="CaptureExclusions" Text="Sequence number, lock token and delivery count are excluded; the observed Message ID is replaced with Generate new. The source message remains unchanged." TextWrapping="Wrap"/></Border>
     <CheckBox x:Name="CaptureAcknowledge" Content="I reviewed the copied and excluded properties" Margin="0,0,0,18"/>
     <TextBlock x:Name="CaptureError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" Margin="0,0,0,10"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Close_Click" MinWidth="105"/><Button Content="Open draft" Click="OpenDraft_Click" Style="{StaticResource PrimaryButton}" MinWidth="130" AutomationProperties.AutomationId="PrototypeOpenDraft"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="ValidationSurface" Visibility="Collapsed">
     <TextBlock x:Name="ValidationHeading" Text="Validation errors" Style="{StaticResource DialogHeading}"/>
     <Border x:Name="ValidationBanner" Background="{DynamicResource DestructiveHoverBrush}" BorderBrush="{DynamicResource DestructiveBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16"><TextBlock x:Name="ValidationBannerText" Text="1 invalid row · Nothing can be sent" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
     <DataGrid x:Name="ValidationGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="36" Height="220" AutomationProperties.AutomationId="PrototypeValidationResults"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="80" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="CustomerId" Binding="{Binding CustomerId}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Close" Click="Close_Click"/><Button Content="Edit mapping" Click="EditMapping_Click"/><Button Content="Validate again" Click="ValidateAgain_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
     <Border x:Name="ValidationWarning" Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="Duplicate CSV header: CustomerId. Validation incomplete." TextWrapping="Wrap"/></Border>
    </StackPanel>
    <StackPanel x:Name="ConflictSurface" Visibility="Collapsed">
     <TextBlock Text="Sample revision changed. Draft preserved." Style="{StaticResource DialogHeading}" TextWrapping="Wrap"/>
     <Border Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16"><TextBlock Text="The saved in-memory sample differs from your unsaved draft. Choose how to continue." TextWrapping="Wrap"/></Border>
     <TextBlock x:Name="ConflictFileName" Text="OrderCreated.json" FontWeight="SemiBold" Margin="0,0,0,9"/>
     <TextBlock Text="Sample collection: Team messages/Orders" Style="{StaticResource DialogCaption}" Margin="0,0,0,5"/>
     <TextBlock x:Name="ConflictSavedFingerprint" Text="Saved fingerprint: —" Style="{StaticResource DialogCaption}" Margin="0,0,0,5" TextWrapping="Wrap"/>
     <TextBlock x:Name="ConflictDraftFingerprint" Text="Draft fingerprint: —" Style="{StaticResource DialogCaption}" Margin="0,0,0,18" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Reload sample" Click="ConflictReload_Click" AutomationProperties.AutomationId="PrototypeConflictReload"/><Button Content="Save as" Click="ConflictSaveAs_Click" AutomationProperties.AutomationId="PrototypeConflictSaveAs"/><Button Content="Keep editing" Click="ConflictKeep_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeConflictKeepEditing"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="DraftGuardSurface" Visibility="Collapsed">
     <TextBlock Text="Save changes?" Style="{StaticResource DialogHeading}"/>
     <TextBlock x:Name="DraftGuardText" Text="You have unsaved changes to this template. What do you want to do?" TextWrapping="Wrap" Margin="0,0,0,22"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save" Click="DraftSave_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Discard" Click="DraftDiscard_Click"/><Button Content="Cancel" Click="Close_Click"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="DestinationSurface" Visibility="Collapsed">
     <TextBlock x:Name="DestinationHeading" Text="Choose destination" Style="{StaticResource DialogHeading}"/>
     <TextBlock x:Name="DestinationDescription" Text="This template has no resolved send target. Choose a sample queue or topic for this draft; this does not change its saved associations." TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="Current profile" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/>
     <TextBlock x:Name="DestinationProfile" Text="Local emulator" Margin="0,0,0,16"/>
     <TextBlock Text="Destination" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/>
     <ComboBox x:Name="DestinationPicker" SelectedIndex="0" AutomationProperties.Name="Sample destination"><ComboBoxItem Content="order-events (Topic)" Tag="order-events"/><ComboBoxItem Content="inventory-events (Topic)" Tag="inventory-events"/><ComboBoxItem Content="order-replies (Queue)" Tag="order-replies"/></ComboBox>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Cancel" Click="Close_Click"/><Button x:Name="ApplyDestinationButton" Content="Use destination" Click="ApplyDestination_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeApplyDestination"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="ReviewSurface" Visibility="Collapsed">
     <TextBlock x:Name="ReviewHeading" Text="Review 3 messages" Style="{StaticResource DialogHeading}"/>
     <TextBlock Text="Target" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Margin="120,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Profile" Margin="0,7"/><TextBox x:Name="ReviewProfile" Grid.Column="1" IsReadOnly="True" Text="Local emulator"/><TextBlock Grid.Row="1" Text="Endpoint" Margin="0,7"/><TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="localhost"/><TextBlock x:Name="ReviewTargetKind" Grid.Row="2" Text="Topic" Margin="0,7"/><TextBox x:Name="ReviewTarget" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="order-events"/></Grid>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Send option" FontWeight="SemiBold" Width="120" VerticalAlignment="Center"/><RadioButton x:Name="ReviewSendNow" Content="Send now" IsChecked="True" GroupName="ReviewTiming" Checked="ReviewTiming_Checked" Margin="0,0,24,0"/><RadioButton x:Name="ReviewSchedule" Content="Schedule" GroupName="ReviewTiming" Checked="ReviewTiming_Checked" AutomationProperties.AutomationId="PrototypeScheduleLater"/></StackPanel></Border>
     <Grid x:Name="ScheduleInputs" Visibility="Collapsed" Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Schedule" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><DatePicker x:Name="ScheduleDateInput" Width="175" SelectedDateChanged="ScheduleInput_Changed"/><TextBox x:Name="ScheduleTimeInput" Text="14:30" Width="90" Margin="8,0,0,0" TextChanged="ScheduleInput_Changed"/><RadioButton x:Name="ScheduleUtc" Content="UTC" IsChecked="True" GroupName="TimeZone" Margin="12,8,0,0" Checked="ScheduleZone_Checked"/><RadioButton x:Name="ScheduleLocal" Content="Local" GroupName="TimeZone" Margin="12,8,0,0" Checked="ScheduleZone_Checked"/></StackPanel><TextBlock x:Name="ResolvedSchedule" Text="One time for all messages" Margin="0,10,0,0" Style="{StaticResource DialogCaption}"/></StackPanel></Grid>
     <Grid Margin="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Summary" FontWeight="SemiBold" VerticalAlignment="Top"/><TextBlock x:Name="ReviewMessageCount" Grid.Column="1" Text="3 valid messages" Margin="0,0,0,7"/><TextBlock Grid.Row="1" Text="Sample body size" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><TextBlock x:Name="ReviewTotalSize" Grid.Row="1" Grid.Column="1" Text="Sample body size: 0 bytes UTF-8" Margin="0,0,0,7" AutomationProperties.AutomationId="PrototypeReviewTotalSize" TextWrapping="WrapWithOverflow"/><TextBlock Grid.Row="2" Text="Message IDs" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><ScrollViewer Grid.Row="2" Grid.Column="1" MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,7"><TextBlock x:Name="ReviewMessageIds" Text="No prepared IDs" TextWrapping="WrapWithOverflow" AutomationProperties.AutomationId="PrototypeReviewMessageIds"/></ScrollViewer><TextBlock Grid.Row="3" Text="TTL" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><TextBlock x:Name="ReviewTtl" Grid.Row="3" Grid.Column="1" Text="Time to live: inherit entity default" TextWrapping="WrapWithOverflow" Margin="0,0,0,7"/><TextBlock Grid.Row="4" Text="Properties" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><ScrollViewer Grid.Row="4" Grid.Column="1" MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ReviewPropertyDetails" TextWrapping="WrapWithOverflow"/></ScrollViewer></Grid>
     <TextBlock x:Name="ReviewError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel x:Name="ProgressSurface" Visibility="Collapsed"><TextBlock x:Name="ProgressHeading" Text="Sending 3 messages" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="ProgressTarget" Text="Target: Local emulator / localhost / order-events" Margin="0,0,0,20"/><TextBlock x:Name="ProgressStatus" Text="0 of 3 acknowledged" Margin="0,0,0,8"/><ProgressBar x:Name="DispatchProgress" Height="10" Minimum="0" Maximum="3"/><TextBlock Text="Stops further submissions; acknowledged messages remain unchanged." Margin="0,20,0,20" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}"/><Button x:Name="StopDispatch" Content="Stop" Click="StopDispatch_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeStopDispatch"/></StackPanel>
<StackPanel x:Name="ResultsSurface" Visibility="Collapsed"><TextBlock x:Name="ResultsHeading" Text="Run results" Style="{StaticResource DialogHeading}"/><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="35" Height="260" AutomationProperties.AutomationId="PrototypeRunResults"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Row}" Width="40" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="280" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="160" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid><Border Background="{DynamicResource NeutralHoverBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,18"><TextBlock Text="Results are session-only. Broker counts refresh independently. No automatic retry is performed." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Export results" Click="ExportResults_Click"/><Button x:Name="CancelScheduled" Content="Cancel scheduled messages" Click="ShowCancellation_Click" Visibility="Collapsed" AutomationProperties.AutomationId="PrototypeShowCancellation"/><Button Content="View destination" Click="ViewDestination_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeViewDestination"/></StackPanel></StackPanel>
    <StackPanel x:Name="CancellationSurface" Visibility="Collapsed"><TextBlock Text="Scheduled results" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="CancellationTarget" Text="Local emulator · order-events · Due time (UTC)" Margin="0,0,0,12"/><DataGrid x:Name="ScheduledGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="36" Height="250" AutomationProperties.AutomationId="PrototypeScheduledResults"><DataGrid.Columns><DataGridCheckBoxColumn Header="" Binding="{Binding Selected}" Width="40" ElementStyle="{StaticResource CenteredDataGridCheckBox}"/><DataGridTextColumn Header="#" Binding="{Binding Row}" Width="45" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Receipt" Binding="{Binding Receipt}" Width="90" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Status" Binding="{Binding Outcome}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Scheduled for (UTC)" Binding="{Binding DueTime}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid><TextBlock Text="Cancellation may race activation. A request does not guarantee that a message was not activated." Foreground="{DynamicResource WarningHealthBrush}" TextWrapping="Wrap" Margin="0,14,0,14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back to results" Click="BackToResults_Click"/><Button Content="Cancel selected scheduled" Click="ConfirmCancellation_Click" Style="{StaticResource DestructiveButton}" AutomationProperties.AutomationId="PrototypeCancelScheduled"/></StackPanel></StackPanel>
    <StackPanel x:Name="HistorySurface" Visibility="Collapsed"><TextBlock Text="Cancellation history" Style="{StaticResource DialogHeading}"/><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="36" Height="240"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding Receipt}" Width="90" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Cancellation status" Binding="{Binding CancellationStatus}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Last attempt (UTC)" Binding="{Binding AttemptTime}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid><TextBlock Text="Dispatch results remain unchanged. Retry requires fresh confirmation." Foreground="{DynamicResource ActionTextBrush}" Margin="0,16,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back to results" Click="BackToResults_Click"/><Button Content="Retry cancellation" Click="ConfirmCancellation_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel>
    </Grid>
   </ScrollViewer>
   <Border x:Name="ReviewFooter" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
    <StackPanel>
     <Border Background="{DynamicResource NeutralHoverBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="ReviewNotice" Text="Subscriptions receive according to their rules." TextWrapping="Wrap"/></Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back" Click="Close_Click" MinWidth="100"/><Button x:Name="ConfirmDispatch" Content="Send 3 messages" Click="Dispatch_Click" Style="{StaticResource PrimaryButton}" MinWidth="170" AutomationProperties.AutomationId="PrototypeConfirmDispatch"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
