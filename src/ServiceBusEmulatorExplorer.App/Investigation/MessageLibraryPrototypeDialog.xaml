<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.MessageLibraryPrototypeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ServiceBusEmulatorExplorer.App.Investigation"
 Title="Message Workbench" Width="760" Height="690" MinWidth="640" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="DialogLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="DialogCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/></Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CenteredDataGridColumnHeader}"/><Style TargetType="DataGridRow" BasedOn="{StaticResource CenteredDataGridRow}"/><Style TargetType="DataGridCell" BasedOn="{StaticResource CenteredDataGridCell}"/>
 </ResourceDictionary></Window.Resources>
 <Border Margin="16" Padding="22" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="DialogScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid>
    <StackPanel x:Name="SampleCsvSurface" Visibility="Collapsed"><TextBlock Text="Choose sample CSV" Style="{StaticResource DialogHeading}"/><TextBlock Text="These in-memory fixtures let you test a complete valid batch or a row with an invalid amount. No local file is read." TextWrapping="Wrap" Margin="0,0,0,18"/><TextBlock Text="Sample file" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/><ComboBox x:Name="SampleCsvPicker" SelectedIndex="0" AutomationProperties.Name="Sample CSV fixture" AutomationProperties.AutomationId="PrototypeSampleCsvPicker"><ComboBoxItem Content="orders.csv — 3 valid rows" Tag="orders.csv"/><ComboBoxItem Content="orders-invalid.csv — row 2 amount is abc" Tag="orders-invalid.csv"/></ComboBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Close_Click"/><Button Content="Use sample" Click="UseSampleCsv_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeUseSampleCsv"/></StackPanel></StackPanel>
    <StackPanel x:Name="MappingSurface"><TextBlock Text="Map CSV inputs" Style="{StaticResource DialogHeading}"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="CSV file" Style="{StaticResource DialogLabel}"/><TextBox x:Name="MappingFile" Grid.Column="1" Text="orders.csv" IsReadOnly="True"/><Button Grid.Column="2" Content="Browse..." Click="BrowseSample_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="PrototypeMappingBrowse"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Delimiter" Style="{StaticResource DialogLabel}"/><ComboBox x:Name="MappingDelimiter" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="CSV delimiter"><ComboBoxItem Content="Comma"/><ComboBoxItem Content="Semicolon"/></ComboBox></Grid><TextBlock Text="Variable mappings" FontWeight="SemiBold" Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Variable" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Declared type" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Input source" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Value" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="CustomerId" Margin="0,12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="string" Margin="0,12"/><ComboBox x:Name="CustomerSource" Grid.Row="1" Grid.Column="2" SelectedIndex="0" SelectionChanged="MappingSource_Changed"><ComboBoxItem Content="CSV column"/><ComboBoxItem Content="Constant"/><ComboBoxItem Content="Declared default"/></ComboBox><ComboBox x:Name="CustomerValue" Grid.Row="1" Grid.Column="3" IsEditable="True" Text="CustomerId" AutomationProperties.Name="CustomerId input mapping"><ComboBoxItem Content="CustomerId"/><ComboBoxItem Content="Amount"/></ComboBox><TextBlock Grid.Row="2" Text="Amount" Margin="0,12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="number" Margin="0,12"/><ComboBox x:Name="AmountSource" Grid.Row="2" Grid.Column="2" SelectedIndex="0" SelectionChanged="MappingSource_Changed"><ComboBoxItem Content="CSV column"/><ComboBoxItem Content="Constant"/><ComboBoxItem Content="Declared default"/></ComboBox><ComboBox x:Name="AmountValue" Grid.Row="2" Grid.Column="3" IsEditable="True" Text="Amount" AutomationProperties.Name="Amount input mapping"><ComboBoxItem Content="Amount"/><ComboBoxItem Content="CustomerId"/></ComboBox><TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="Generated by template: EventId and OccurredAt" Background="{DynamicResource ColumnHeaderBrush}" Padding="10,8" Margin="0,8"/></Grid><TextBlock Text="Input sources: Column / Constant / Declared default." Style="{StaticResource DialogCaption}" Margin="0,8,0,0"/><TextBlock x:Name="MappingError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Close_Click" MinWidth="105"/><Button Content="Apply mapping" Click="ApplyMapping_Click" Style="{StaticResource PrimaryButton}" MinWidth="150" AutomationProperties.AutomationId="PrototypeApplyMapping"/></StackPanel></StackPanel>
    <StackPanel x:Name="CaptureSurface" Visibility="Collapsed"><TextBlock Text="Save as template" Style="{StaticResource DialogHeading}"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Source" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureSource" Grid.Column="1" IsReadOnly="True" Text="order-events / billing · Active"/></Grid><TextBlock Text="Message body" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,13"><RadioButton x:Name="CaptureOriginal" Content="Original (as received)" IsChecked="True" GroupName="CaptureBody" Checked="CaptureBody_Checked" Margin="0,0,24,0"/><RadioButton x:Name="CaptureEdited" Content="Edited (current in editor)" GroupName="CaptureBody" Checked="CaptureBody_Checked"/></StackPanel><TextBlock Text="Message preview (read only)" Margin="0,0,0,6"/><TextBox x:Name="CapturePreview" Height="140" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource EditorForegroundBrush}" Background="{DynamicResource EditorBackgroundBrush}" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Template name" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureName" Grid.Column="1" Text="Order created" AutomationProperties.AutomationId="PrototypeCaptureName"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Save to local collection" Style="{StaticResource DialogLabel}"/><ComboBox x:Name="CaptureCollection" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Team messages/Orders"/><ComboBoxItem Content="Team messages/Archive"/></ComboBox></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Filename" Style="{StaticResource DialogLabel}"/><TextBox x:Name="CaptureFileName" Grid.Column="1" Text="order-created.sbetemplate.json"/></Grid><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Topic or queue association" Style="{StaticResource DialogLabel}"/><ComboBox x:Name="CaptureAssociation" Grid.Column="1" SelectedIndex="0" IsEditable="False" AutomationProperties.Name="Topic or queue association" AutomationProperties.AutomationId="PrototypeCaptureAssociation"><ComboBoxItem Content="order-events (Topic)" Tag="order-events"/><ComboBoxItem Content="inventory-events (Topic)" Tag="inventory-events"/><ComboBoxItem Content="order-replies (Queue)" Tag="order-replies"/></ComboBox></Grid><TextBlock Text="The association filters the library. Sending still requires review." Style="{StaticResource DialogCaption}" Margin="180,0,0,12"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Message ID" Style="{StaticResource DialogLabel}"/><TextBox Grid.Column="1" Text="Generate new" IsReadOnly="True"/></Grid><CheckBox x:Name="CaptureCopyTtl" Content="Copy observed TTL (if present)" Margin="0,0,0,15"/><Border Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,8"><TextBlock x:Name="CaptureExclusions" Text="Sequence number, lock token and delivery count are excluded; the observed Message ID is replaced with Generate new. The source message remains unchanged." TextWrapping="Wrap"/></Border><CheckBox x:Name="CaptureAcknowledge" Content="I reviewed the copied and excluded properties" Margin="0,0,0,18"/><TextBlock x:Name="CaptureError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Close_Click" MinWidth="105"/><Button Content="Open draft" Click="OpenDraft_Click" Style="{StaticResource PrimaryButton}" MinWidth="130" AutomationProperties.AutomationId="PrototypeOpenDraft"/></StackPanel></StackPanel>
    <StackPanel x:Name="ValidationSurface" Visibility="Collapsed"><TextBlock x:Name="ValidationHeading" Text="Validation errors" Style="{StaticResource DialogHeading}"/><Border x:Name="ValidationBanner" Background="{DynamicResource DestructiveHoverBrush}" BorderBrush="{DynamicResource DestructiveBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16"><TextBlock x:Name="ValidationBannerText" Text="1 invalid row · Nothing can be sent" FontWeight="SemiBold" TextWrapping="Wrap"/></Border><DataGrid x:Name="ValidationGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="36" Height="220" AutomationProperties.AutomationId="PrototypeValidationResults"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="80" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="CustomerId" Binding="{Binding CustomerId}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Close" Click="Close_Click"/><Button Content="Edit mapping" Click="EditMapping_Click"/><Button Content="Validate again" Click="ValidateAgain_Click" Style="{StaticResource PrimaryButton}"/></StackPanel><Border x:Name="ValidationWarning" Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="Duplicate CSV header: CustomerId. Validation incomplete." TextWrapping="Wrap"/></Border></StackPanel>
    <StackPanel x:Name="ConflictSurface" Visibility="Collapsed"><TextBlock Text="Sample revision changed. Draft preserved." Style="{StaticResource DialogHeading}" TextWrapping="Wrap"/><Border Background="#FFF8EB" BorderBrush="#F3C166" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16"><TextBlock Text="The saved in-memory sample differs from your unsaved draft. Choose how to continue." TextWrapping="Wrap"/></Border><TextBlock x:Name="ConflictFileName" Text="OrderCreated.json" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Text="Sample collection: Team messages/Orders" Style="{StaticResource DialogCaption}" Margin="0,0,0,5"/><TextBlock x:Name="ConflictSavedFingerprint" Text="Saved fingerprint: —" Style="{StaticResource DialogCaption}" Margin="0,0,0,5" TextWrapping="Wrap"/><TextBlock x:Name="ConflictDraftFingerprint" Text="Draft fingerprint: —" Style="{StaticResource DialogCaption}" Margin="0,0,0,18" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Reload sample" Click="ConflictReload_Click" AutomationProperties.AutomationId="PrototypeConflictReload"/><Button Content="Save as" Click="ConflictSaveAs_Click" AutomationProperties.AutomationId="PrototypeConflictSaveAs"/><Button Content="Keep editing" Click="ConflictKeep_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeConflictKeepEditing"/></StackPanel></StackPanel>
    <StackPanel x:Name="DraftGuardSurface" Visibility="Collapsed"><TextBlock Text="Save changes?" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="DraftGuardText" Text="You have unsaved changes to this template. What do you want to do?" TextWrapping="Wrap" Margin="0,0,0,22"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save" Click="DraftSave_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Discard" Click="DraftDiscard_Click"/><Button Content="Cancel" Click="Close_Click"/></StackPanel></StackPanel>
    <StackPanel x:Name="DestinationSurface" Visibility="Collapsed"><TextBlock x:Name="DestinationHeading" Text="Choose destination" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="DestinationDescription" Text="This template has no resolved send target. Choose a sample queue or topic for this draft; this does not change its saved associations." TextWrapping="Wrap" Margin="0,0,0,18"/><TextBlock Text="Current profile" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/><TextBlock x:Name="DestinationProfile" Text="Local emulator" Margin="0,0,0,16"/><TextBlock Text="Destination" Style="{StaticResource DialogLabel}" Margin="0,0,0,6"/><ComboBox x:Name="DestinationPicker" SelectedIndex="0" AutomationProperties.Name="Sample destination"><ComboBoxItem Content="order-events (Topic)" Tag="order-events"/><ComboBoxItem Content="inventory-events (Topic)" Tag="inventory-events"/><ComboBoxItem Content="order-replies (Queue)" Tag="order-replies"/></ComboBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Cancel" Click="Close_Click"/><Button x:Name="ApplyDestinationButton" Content="Use destination" Click="ApplyDestination_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeApplyDestination"/></StackPanel></StackPanel>
   </Grid>
  </ScrollViewer>
  <local:MessageLibraryPrototypeReviewSurface x:Name="ReviewSurfaceControl" Grid.RowSpan="2" Visibility="Collapsed"/>
  </Grid>
 </Border>
</Window>
