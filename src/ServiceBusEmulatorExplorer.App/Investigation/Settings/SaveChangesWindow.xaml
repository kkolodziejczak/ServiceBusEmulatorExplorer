<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.Settings.SaveChangesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Save changes?" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" Icon="/ServiceBusEmulatorExplorer.App;component/Assets/AppIcon.png" AutomationProperties.AutomationId="SaveChangesWindow">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Window.Style><StaticResource ResourceKey="DialogWindow"/></Window.Style>
 <!-- Settings 70 #7-#8: the Message Library draft guard's question, for unsaved profile edits. -->
 <StackPanel Margin="24">
  <TextBlock Text="Save changes?" Style="{StaticResource DialogHeading}"/>
  <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,0,0,24" AutomationProperties.AutomationId="SaveChangesQuestion"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" AutomationProperties.AutomationId="SaveChangesSaveButton"/>
   <Button x:Name="DiscardButton" Content="Discard" Margin="8,0,0,0" Click="Discard_Click" AutomationProperties.AutomationId="SaveChangesDiscardButton"/>
   <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" IsCancel="True" AutomationProperties.AutomationId="SaveChangesCancelButton"/>
  </StackPanel>
 </StackPanel>
</Window>
