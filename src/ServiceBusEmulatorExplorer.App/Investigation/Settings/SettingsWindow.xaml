<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520"
        Height="820"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Icon="../../Assets/AppIcon.png"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        Closing="Window_Closing"
        AutomationProperties.Name="Settings">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>


            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Style>

            <Style x:Key="ProfileItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ProfileBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,11" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                                        <Ellipse x:Name="Ring" Stroke="{Binding ColorHex}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="{Binding ColorHex}" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ColorSwatchItem" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="72" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SwatchBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2" CornerRadius="3" Padding="4,8">
                                <StackPanel>
                                    <Ellipse Width="18" Height="18" Fill="{Binding ColorHex}" />
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Grid.Row="0" Margin="20,16,20,0" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,9" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem x:Name="GeneralTab" Header="General" AutomationProperties.AutomationId="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,22,4,12">
                        <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Close to system tray" FontWeight="SemiBold" /><TextBlock x:Name="CloseToTrayDescription" Text="Keep watches running when you close the window." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" AutomationProperties.AutomationId="CloseToTrayToggle" AutomationProperties.Name="Close to system tray" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop notifications" FontWeight="SemiBold" /><TextBlock Text="Show persistent alerts for new messages in watched entities." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="Notifications_Changed" Unchecked="Notifications_Changed" AutomationProperties.AutomationId="NotificationsToggle" AutomationProperties.Name="Desktop notifications" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Automatically connect when switching profiles" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="Connect after choosing a profile in the toolbar." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="AutoConnectToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed" AutomationProperties.AutomationId="AutoConnectToggle" AutomationProperties.Name="Automatically connect when switching profiles" />
                        </Grid>
                        <TextBlock Text="Message page sizes" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,14" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Queue page size" VerticalAlignment="Center" />
                            <ComboBox x:Name="QueuePageSizeSelector" Grid.Column="1" ItemsSource="{Binding PageSizeChoices}" SelectionChanged="PageSize_Changed" AutomationProperties.AutomationId="QueuePageSizeSelector" AutomationProperties.Name="Queue page size" />
                            <TextBlock Grid.Row="1" Text="Topic page size" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="TopicPageSizeSelector" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PageSizeChoices}" SelectionChanged="PageSize_Changed" Margin="0,10,0,0" AutomationProperties.AutomationId="TopicPageSizeSelector" AutomationProperties.Name="Topic page size" />
                            <TextBlock Grid.Row="2" Text="Subscription page size" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="SubscriptionPageSizeSelector" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PageSizeChoices}" SelectionChanged="PageSize_Changed" Margin="0,10,0,0" AutomationProperties.AutomationId="SubscriptionPageSizeSelector" AutomationProperties.Name="Subscription page size" />
                        </Grid>
                        <TextBlock Text="Search budgets" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,6" />
                        <TextBlock Text="A search stops when it reaches either limit. Continue starts the next budgeted scan." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Search time budget" VerticalAlignment="Center" />
                            <ComboBox x:Name="SearchTimeBudgetSelector" Grid.Column="1" ItemsSource="{Binding SearchTimeBudgetChoices}" ItemStringFormat="{}{0} seconds" SelectionChanged="SearchBudget_Changed" AutomationProperties.AutomationId="SearchTimeBudgetSelector" AutomationProperties.Name="Search time budget" />
                            <TextBlock Grid.Row="1" Text="Scanned delivery budget" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="SearchDeliveryBudgetSelector" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SearchDeliveryBudgetChoices}" ItemStringFormat="{}{0:N0}" SelectionChanged="SearchBudget_Changed" Margin="0,10,0,0" AutomationProperties.AutomationId="SearchDeliveryBudgetSelector" AutomationProperties.Name="Scanned delivery budget" />
                        </Grid>
                        <TextBlock x:Name="GeneralStatus" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" FontSize="12" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ConnectionsTab" Header="Connections" AutomationProperties.AutomationId="ConnectionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,20,4,12">
                        <TextBlock Text="Connection profiles" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Profiles and preferences are saved for your next launch. Connection strings are protected for your Windows user." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,8,0,14" />
                        <ListBox x:Name="ProfilesList" Height="104" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ProfileItem}" SelectionChanged="Profile_Selected" AutomationProperties.AutomationId="ProfilesList" AutomationProperties.Name="Connection profiles" />
                        <Button x:Name="AddConnectionButton" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddConnection_Click" AutomationProperties.AutomationId="AddConnectionButton" AutomationProperties.Name="Add connection">
                            <StackPanel Orientation="Horizontal"><Path Data="M8,1 V15 M1,8 H15" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0" /><TextBlock Text="Add connection" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Label Content="Profile name" Target="{Binding ElementName=ProfileName}" Padding="0" Margin="0,16,0,6" />
                        <TextBox x:Name="ProfileName" AutomationProperties.AutomationId="ProfileName" AutomationProperties.Name="Profile name" />
                        <Label Content="Authentication" Target="{Binding ElementName=AuthenticationModeSelector}" Padding="0" Margin="0,14,0,6" />
                        <ComboBox x:Name="AuthenticationModeSelector" ItemsSource="{Binding AuthenticationModes}" SelectionChanged="AuthenticationMode_Changed" AutomationProperties.AutomationId="AuthenticationModeSelector" AutomationProperties.Name="Authentication mode" />
                        <StackPanel x:Name="ConnectionStringsPanel">
                            <Label Content="Runtime connection string" Target="{Binding ElementName=RuntimeConnection}" Padding="0" Margin="0,14,0,6" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="RuntimeConnection" PasswordChanged="ConnectionString_Changed" AutomationProperties.AutomationId="RuntimeConnection" AutomationProperties.Name="Runtime connection string" />
                                <Button x:Name="CopyRuntimeConnectionButton" Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="8" IsEnabled="False" Click="CopyRuntimeConnection_Click" ToolTip="Copy runtime connection string" AutomationProperties.AutomationId="CopyRuntimeConnectionButton" AutomationProperties.Name="Copy runtime connection string"><Path Style="{StaticResource CopyIcon}" /></Button>
                            </Grid>
                            <Label Content="Administration connection string" Target="{Binding ElementName=AdministrationConnection}" Padding="0" Margin="0,14,0,6" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AdministrationConnection" PasswordChanged="ConnectionString_Changed" AutomationProperties.AutomationId="AdministrationConnection" AutomationProperties.Name="Administration connection string" />
                                <Button x:Name="CopyAdministrationConnectionButton" Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="8" IsEnabled="False" Click="CopyAdministrationConnection_Click" ToolTip="Copy administration connection string" AutomationProperties.AutomationId="CopyAdministrationConnectionButton" AutomationProperties.Name="Copy administration connection string"><Path Style="{StaticResource CopyIcon}" /></Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AzureCliPanel" Visibility="Collapsed">
                            <Label Content="Fully qualified namespace" Target="{Binding ElementName=FullyQualifiedNamespace}" Padding="0" Margin="0,14,0,6" />
                            <TextBox x:Name="FullyQualifiedNamespace" AutomationProperties.AutomationId="FullyQualifiedNamespace" AutomationProperties.Name="Fully qualified namespace" ToolTip="Service Bus namespace hostname used with the account cached by az login." />
                            <TextBlock Text="Uses the account cached by Azure CLI (az login)." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                        <Label Content="Connection color" Target="{Binding ElementName=ColorPicker}" Padding="0" Margin="0,14,0,6" />
                        <ListBox x:Name="ColorPicker" SelectedValuePath="ColorHex" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ColorSwatchItem}" AutomationProperties.AutomationId="ColorPicker" AutomationProperties.Name="Connection accent color">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                        <Label Content="Connection warning (optional)" Target="{Binding ElementName=ConnectionWarning}" Padding="0" Margin="0,14,0,6" />
                        <TextBox x:Name="ConnectionWarning" MinHeight="72" MaxHeight="144" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ConnectionWarning" AutomationProperties.Name="Connection warning" />
                        <TextBlock Text="Shown before connecting. Leave empty to connect without a warning." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Allow agent access" Style="{StaticResource DialogLabel}" /><TextBlock Text="Agents can read this connection's messages and entities while agent access is on in Settings › Agents. Turn this off for live or production data." TextWrapping="Wrap" Style="{StaticResource DialogCaption}" Margin="0,4,0,0" /></StackPanel>
                            <ToggleButton x:Name="ProfileAgentAccessToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" AutomationProperties.AutomationId="ProfileAgentAccessToggle" AutomationProperties.Name="Allow agent access for this connection" />
                        </Grid>
                        <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AgentsTab" Header="Agents" AutomationProperties.AutomationId="AgentsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,24,4,12">
                        <TextBlock Text="Agent access" Style="{StaticResource SettingsSectionHeading}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Allow agent access" Style="{StaticResource DialogLabel}" /><TextBlock Text="Let AI agents such as Claude Code, Codex and GitHub Copilot read what this app sees through a local MCP server. Message contents are sent to the agent's model provider." TextWrapping="Wrap" Style="{StaticResource DialogCaption}" Margin="0,4,0,0" /></StackPanel>
                            <ToggleButton x:Name="AgentAccessToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="AgentAccess_Changed" Unchecked="AgentAccess_Changed" AutomationProperties.AutomationId="AgentAccessToggle" AutomationProperties.Name="Allow agent access" />
                        </Grid>

                        <TextBlock Text="Connection" Style="{StaticResource SettingsSectionHeading}" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Address" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="AgentEndpoint" Width="248" IsReadOnly="True" AutomationProperties.AutomationId="AgentEndpoint" AutomationProperties.Name="Agent access address" />
                                <Button x:Name="CopyAgentEndpointButton" Width="36" Margin="8,0,0,0" Padding="8" Click="CopyAgentEndpoint_Click" ToolTip="Copy address" AutomationProperties.AutomationId="CopyAgentEndpointButton" AutomationProperties.Name="Copy agent access address"><Path Style="{StaticResource CopyIcon}" /></Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox x:Name="AgentPort" Grid.Row="1" Grid.Column="1" Width="112" HorizontalAlignment="Right" Margin="0,12,0,0" MaxLength="5" LostKeyboardFocus="AgentPort_LostFocus" KeyDown="AgentPort_KeyDown" AutomationProperties.AutomationId="AgentPort" AutomationProperties.Name="Agent access port" />
                            <TextBlock Grid.Row="2" Text="Access token" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="AgentToken" Width="160" IsReadOnly="True" AutomationProperties.AutomationId="AgentToken" AutomationProperties.Name="Agent access token (hidden)" />
                                <Button x:Name="CopyAgentTokenButton" Width="36" Margin="8,0,0,0" Padding="8" Click="CopyAgentToken_Click" ToolTip="Copy access token" AutomationProperties.AutomationId="CopyAgentTokenButton" AutomationProperties.Name="Copy agent access token"><Path Style="{StaticResource CopyIcon}" /></Button>
                                <Button x:Name="RegenerateAgentTokenButton" Content="Regenerate" Margin="8,0,0,0" Click="RegenerateAgentToken_Click" ToolTip="Create a new token. Agents using the old token must be updated." AutomationProperties.AutomationId="RegenerateAgentTokenButton" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="AgentPortWarning" Style="{StaticResource ValidationWarningFrame}" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="AgentPortWarning">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AgentPortWarningText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Grid.Column="1" Content="Change port" Style="{StaticResource ValidationWarningAction}" Click="ChangeAgentPort_Click" AutomationProperties.AutomationId="ChangeAgentPortButton" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="AgentStatusDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0" />
                            <TextBlock x:Name="AgentStatusText" Style="{StaticResource DialogCaption}" TextWrapping="Wrap" AutomationProperties.AutomationId="AgentStatusText" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <TextBlock Text="Connect an agent" Style="{StaticResource SettingsSectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Agent" VerticalAlignment="Center" />
                            <ComboBox x:Name="AgentClientSelector" Grid.Column="1" Width="176" SelectionChanged="AgentClient_Changed" AutomationProperties.AutomationId="AgentClientSelector" AutomationProperties.Name="Agent" />
                        </Grid>
                        <TextBox x:Name="AgentSnippet" Style="{StaticResource SnippetBox}" Margin="0,12,0,0" AutomationProperties.AutomationId="AgentSnippet" AutomationProperties.Name="Agent setup command" />
                        <Button x:Name="CopyAgentSnippetButton" Content="Copy command" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CopyAgentSnippet_Click" AutomationProperties.AutomationId="CopyAgentSnippetButton" />
                        <TextBlock x:Name="AgentsStatus" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" Style="{StaticResource DialogCaption}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Background="{DynamicResource ChromeBrush}">
            <Grid>
                <Button x:Name="SaveProfileButton" Content="Save profile" HorizontalAlignment="Left" Margin="0" Click="SaveProfile_Click" AutomationProperties.AutomationId="SaveProfileButton" />
                <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="84" HorizontalAlignment="Right" Click="Done_Click" AutomationProperties.AutomationId="DoneButton" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
