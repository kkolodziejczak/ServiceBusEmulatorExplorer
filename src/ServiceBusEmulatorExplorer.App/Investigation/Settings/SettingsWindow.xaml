<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:ServiceBusEmulatorExplorer.App.Investigation.Resources"
        Title="Settings"
        Width="520"
        Height="820"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Icon="../../Assets/AppIcon.png"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{x:Static res:AppFonts.Ui}"
        FontSize="14"
        Closing="Window_Closing"
        AutomationProperties.Name="Settings">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>


            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Style>

            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardActionFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource IconBrush}" BorderBrush="Transparent" BorderThickness="2">
                                <Ellipse x:Name="Thumb" Fill="White" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ActionTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

            <Style x:Key="ProfileItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ProfileBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,11" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                                        <Ellipse x:Name="Ring" Stroke="{Binding ColorHex}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="{Binding ColorHex}" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Licences 69: a compact profile-style row with the component and its licence name. -->
            <Style x:Key="LicenceItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="LicenceBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,7" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Licence}" Style="{StaticResource DialogCaption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="LicenceBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter TargetName="LicenceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="LicenceBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="LicenceBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ColorSwatchItem" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="72" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SwatchBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2" CornerRadius="3" Padding="4,8">
                                <StackPanel>
                                    <Ellipse Width="18" Height="18" Fill="{Binding ColorHex}" />
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SwatchBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Grid.Row="0" Margin="20,16,20,0" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,9" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource InkBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem x:Name="GeneralTab" Header="General" AutomationProperties.AutomationId="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,22,4,12">
                        <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Close to system tray" FontWeight="SemiBold" /><TextBlock x:Name="CloseToTrayDescription" Text="{Binding General.CloseToTrayDescription, Mode=OneTime}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" IsChecked="{Binding General.CloseToTray}" IsEnabled="{Binding General.CanChangeCloseToTray}" AutomationProperties.AutomationId="CloseToTrayToggle" AutomationProperties.Name="Close to system tray" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop notifications" FontWeight="SemiBold" /><TextBlock Text="Show persistent alerts for new messages in watched entities." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" IsChecked="{Binding General.NotificationsEnabled}" IsEnabled="{Binding General.IsEditable}" AutomationProperties.AutomationId="NotificationsToggle" AutomationProperties.Name="Desktop notifications" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Automatically connect when switching profiles" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="Connect after choosing a profile in the toolbar." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <ToggleButton x:Name="AutoConnectToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" IsChecked="{Binding General.AutoConnectOnSwitch}" IsEnabled="{Binding General.IsEditable}" AutomationProperties.AutomationId="AutoConnectToggle" AutomationProperties.Name="Automatically connect when switching profiles" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Date format" FontWeight="SemiBold"/>
                                <TextBlock Text="Used for dates throughout the app." Style="{StaticResource DialogCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="DateFormatSelector" Grid.Column="1" MaxWidth="300" VerticalAlignment="Top"
                                      DisplayMemberPath="Label" SelectedValuePath="Format" SelectedValue="{Binding General.DateFormat}" IsEnabled="{Binding General.IsEditable}"
                                      AutomationProperties.AutomationId="DateFormatSelector" AutomationProperties.Name="Date format"/>
                        </Grid>
                        <TextBlock Text="Message page sizes" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,14" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Queue page size" VerticalAlignment="Center" />
                            <ComboBox x:Name="QueuePageSizeSelector" Grid.Column="1" ItemsSource="{Binding General.PageSizeChoices}" SelectedItem="{Binding General.QueuePageSize}" IsEnabled="{Binding General.IsEditable}" AutomationProperties.AutomationId="QueuePageSizeSelector" AutomationProperties.Name="Queue page size" />
                            <TextBlock Grid.Row="1" Text="Topic page size" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="TopicPageSizeSelector" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding General.PageSizeChoices}" SelectedItem="{Binding General.TopicPageSize}" IsEnabled="{Binding General.IsEditable}" Margin="0,10,0,0" AutomationProperties.AutomationId="TopicPageSizeSelector" AutomationProperties.Name="Topic page size" />
                            <TextBlock Grid.Row="2" Text="Subscription page size" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="SubscriptionPageSizeSelector" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding General.PageSizeChoices}" SelectedItem="{Binding General.SubscriptionPageSize}" IsEnabled="{Binding General.IsEditable}" Margin="0,10,0,0" AutomationProperties.AutomationId="SubscriptionPageSizeSelector" AutomationProperties.Name="Subscription page size" />
                        </Grid>
                        <TextBlock Text="Search budgets" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,6" />
                        <TextBlock Text="A search stops when it reaches either limit. Continue starts the next budgeted scan." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Search time budget" VerticalAlignment="Center" />
                            <ComboBox x:Name="SearchTimeBudgetSelector" Grid.Column="1" ItemsSource="{Binding General.SearchTimeBudgetChoices}" ItemStringFormat="{}{0} seconds" SelectedItem="{Binding General.SearchTimeBudgetSeconds}" IsEnabled="{Binding General.IsEditable}" AutomationProperties.AutomationId="SearchTimeBudgetSelector" AutomationProperties.Name="Search time budget" />
                            <TextBlock Grid.Row="1" Text="Scanned delivery budget" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="SearchDeliveryBudgetSelector" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding General.SearchDeliveryBudgetChoices}" ItemStringFormat="{}{0:N0}" SelectedItem="{Binding General.SearchDeliveryBudget}" IsEnabled="{Binding General.IsEditable}" Margin="0,10,0,0" AutomationProperties.AutomationId="SearchDeliveryBudgetSelector" AutomationProperties.Name="Scanned delivery budget" />
                        </Grid>
                        <TextBlock x:Name="GeneralStatus" Text="{Binding General.Status}" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" FontSize="12" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ConnectionsTab" Header="Connections" AutomationProperties.AutomationId="ConnectionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,20,4,12">
                        <TextBlock Text="Connection profiles" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Profiles and preferences are saved for your next launch. Connection strings are protected for your Windows user." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,8,0,14" />
                        <ListBox x:Name="ProfilesList" Height="104" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ProfileItem}" ItemsSource="{Binding Connections.Profiles}" SelectedItem="{Binding Connections.SelectedProfile}" IsEnabled="{Binding Connections.IsEditable}" AutomationProperties.AutomationId="ProfilesList" AutomationProperties.Name="Connection profiles" />
                        <Button x:Name="AddConnectionButton" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding Connections.AddConnectionCommand}" AutomationProperties.AutomationId="AddConnectionButton" AutomationProperties.Name="Add connection">
                            <StackPanel Orientation="Horizontal"><Path Data="M8,1 V15 M1,8 H15" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0" /><TextBlock Text="Add connection" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Label Content="Profile name" Target="{Binding ElementName=ProfileName}" Padding="0" Margin="0,16,0,6" />
                        <TextBox x:Name="ProfileName" Text="{Binding Connections.ProfileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Connections.IsEditable}" AutomationProperties.AutomationId="ProfileName" AutomationProperties.Name="Profile name" />
                        <Label Content="Authentication" Target="{Binding ElementName=AuthenticationModeSelector}" Padding="0" Margin="0,14,0,6" />
                        <ComboBox x:Name="AuthenticationModeSelector" ItemsSource="{Binding Connections.AuthenticationModes}" SelectedIndex="{Binding Connections.AuthenticationModeIndex}" IsEnabled="{Binding Connections.IsEditable}" AutomationProperties.AutomationId="AuthenticationModeSelector" AutomationProperties.Name="Authentication mode" />
                        <StackPanel x:Name="ConnectionStringsPanel" Visibility="{Binding Connections.UsesConnectionStrings, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding Connections.IsEditable}">
                            <Label Content="Runtime connection string" Target="{Binding ElementName=RuntimeConnection}" Padding="0" Margin="0,14,0,6" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="RuntimeConnection" PasswordChanged="ConnectionString_Changed" AutomationProperties.AutomationId="RuntimeConnection" AutomationProperties.Name="Runtime connection string" />
                                <Button x:Name="CopyRuntimeConnectionButton" Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="8" Command="{Binding Connections.CopyRuntimeConnectionCommand}" ToolTip="Copy runtime connection string" AutomationProperties.AutomationId="CopyRuntimeConnectionButton" AutomationProperties.Name="Copy runtime connection string"><Path Style="{StaticResource CopyIcon}" /></Button>
                            </Grid>
                            <Label Content="Administration connection string" Target="{Binding ElementName=AdministrationConnection}" Padding="0" Margin="0,14,0,6" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AdministrationConnection" PasswordChanged="ConnectionString_Changed" AutomationProperties.AutomationId="AdministrationConnection" AutomationProperties.Name="Administration connection string" />
                                <Button x:Name="CopyAdministrationConnectionButton" Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="8" Command="{Binding Connections.CopyAdministrationConnectionCommand}" ToolTip="Copy administration connection string" AutomationProperties.AutomationId="CopyAdministrationConnectionButton" AutomationProperties.Name="Copy administration connection string"><Path Style="{StaticResource CopyIcon}" /></Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AzureCliPanel" Visibility="{Binding Connections.UsesAzureCli, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding Connections.IsEditable}">
                            <Label Content="Fully qualified namespace" Target="{Binding ElementName=FullyQualifiedNamespace}" Padding="0" Margin="0,14,0,6" />
                            <TextBox x:Name="FullyQualifiedNamespace" Text="{Binding Connections.FullyQualifiedNamespace, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FullyQualifiedNamespace" AutomationProperties.Name="Fully qualified namespace" ToolTip="Service Bus namespace hostname used with the account cached by az login." />
                            <TextBlock Text="Uses the account cached by Azure CLI (az login)." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                        <Label Content="Connection color" Target="{Binding ElementName=ColorPicker}" Padding="0" Margin="0,14,0,6" />
                        <ListBox x:Name="ColorPicker" SelectedValuePath="ColorHex" SelectedValue="{Binding Connections.ColorHex}" IsEnabled="{Binding Connections.IsEditable}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ColorSwatchItem}" AutomationProperties.AutomationId="ColorPicker" AutomationProperties.Name="Connection accent color">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                        <Label Content="Connection warning (optional)" Target="{Binding ElementName=ConnectionWarning}" Padding="0" Margin="0,14,0,6" />
                        <TextBox x:Name="ConnectionWarning" Text="{Binding Connections.WarningMessage, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Connections.IsEditable}" MinHeight="72" MaxHeight="144" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ConnectionWarning" AutomationProperties.Name="Connection warning" />
                        <TextBlock Text="Shown before connecting. Leave empty to connect without a warning." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        <TextBlock x:Name="ProfileStatus" Text="{Binding Connections.Status}" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LicencesTab" Header="Licences" AutomationProperties.AutomationId="LicencesTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource InkBrush}" FontWeight="Normal">
                    <StackPanel Margin="4,24,4,12">
                        <TextBlock Text="Third-party licences" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="These components are bundled with Service Bus Emulator Explorer." Style="{StaticResource DialogCaption}" TextWrapping="Wrap" Margin="0,8,0,12" />
                        <ListBox x:Name="LicencesList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource LicenceItem}" ItemsSource="{Binding Licences.Components}" SelectedItem="{Binding Licences.SelectedComponent}" AutomationProperties.AutomationId="LicencesList" AutomationProperties.Name="Third-party components" />
                        <TextBlock Text="Licence text" Style="{StaticResource DialogLabel}" Margin="0,16,0,8" />
                        <TextBox x:Name="LicenceText" Text="{Binding Licences.NoticeText, Mode=OneWay}" Height="136" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="LicenceText" AutomationProperties.Name="Licence text" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="CopyLicenceButton" Margin="0" Command="{Binding Licences.CopyCommand}" AutomationProperties.AutomationId="CopyLicenceButton" AutomationProperties.Name="Copy licence text">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource CopyIcon}" Margin="0,0,7,0" /><TextBlock Text="Copy licence text" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <TextBlock x:Name="LicenceStatus" Grid.Column="1" Text="{Binding Licences.Status}" Style="{StaticResource DialogCaption}" Foreground="{DynamicResource ActionTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Background="{DynamicResource ChromeBrush}">
            <Grid>
                <Button x:Name="SaveProfileButton" Content="Save profile" HorizontalAlignment="Left" Margin="0" Command="{Binding Connections.SaveProfileCommand}" AutomationProperties.AutomationId="SaveProfileButton" />
                <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="84" HorizontalAlignment="Right" Command="{Binding DoneCommand}" AutomationProperties.AutomationId="DoneButton" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
