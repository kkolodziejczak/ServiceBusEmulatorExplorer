<UserControl x:Class="ServiceBusEmulatorExplorer.App.Investigation.MessageLibraryPrototypeReviewSurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ServiceBusEmulatorExplorer.App.Investigation"
 HorizontalAlignment="Stretch" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="ReviewScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="ReviewSurface" Visibility="Collapsed">
     <TextBlock x:Name="ReviewHeading" Text="Review 3 messages" Style="{StaticResource WorkbenchHeading}"/>
      <Grid x:Name="ReviewCards" Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="ReviewTargetCard" Grid.Row="0" Grid.Column="0" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="16" Margin="0,0,9,0"><StackPanel>
     <TextBlock Text="Target" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Profile" Margin="0,7"/><TextBlock x:Name="ReviewProfile" Grid.Column="1" Text="Local emulator" Margin="0,7" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="Endpoint" Margin="0,7"/><TextBlock x:Name="ReviewEndpoint" Grid.Row="1" Grid.Column="1" Text="localhost" Margin="0,7" TextWrapping="Wrap"/><TextBlock x:Name="ReviewTargetKind" Grid.Row="2" Text="Topic" Margin="0,7"/><TextBlock x:Name="ReviewTarget" Grid.Row="2" Grid.Column="1" Text="order-events" Margin="0,7" TextWrapping="Wrap"/></Grid>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Send option" FontWeight="SemiBold" Width="120" VerticalAlignment="Center"/><RadioButton x:Name="ReviewSendNow" Content="Send now" IsChecked="True" GroupName="ReviewTiming" Checked="ReviewTiming_Checked" Margin="0,0,24,0" Style="{StaticResource ScheduleChoiceRadioButton}"/><RadioButton x:Name="ReviewSchedule" Content="Schedule" GroupName="ReviewTiming" Checked="ReviewTiming_Checked" Style="{StaticResource ScheduleChoiceRadioButton}" AutomationProperties.AutomationId="PrototypeScheduleLater"/></StackPanel></Border>
     <Grid x:Name="ScheduleInputs" Visibility="Collapsed" Margin="0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ScheduleDateLabel" Grid.Row="0" Text="Date" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <Grid Grid.Row="0" Grid.Column="1" x:Name="ScheduleDateFieldHost" Margin="0,0,0,8">
       <local:CalendarOnlyDatePicker x:Name="ScheduleDateInput" Style="{StaticResource ScheduleDatePicker}" MaxWidth="{Binding ActualWidth, ElementName=ScheduleDateFieldHost}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ScheduleDateInput" AutomationProperties.Name="Date" AutomationProperties.HelpText="Choose a date from the calendar." ToolTip="Choose date" AutomationProperties.LabeledBy="{Binding ElementName=ScheduleDateLabel}" SelectedDateChanged="ScheduleInput_Changed"/>
      </Grid>
      <TextBlock x:Name="ScheduleTimeLabel" Grid.Row="1" Text="Time" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
       <ComboBox x:Name="ScheduleHourInput" Width="80" Height="32" IsEditable="False" HorizontalContentAlignment="Center" Style="{StaticResource AppComboBox}" SelectionChanged="ScheduleInput_Changed" AutomationProperties.AutomationId="ScheduleHourInput" AutomationProperties.Name="Hour" AutomationProperties.LabeledBy="{Binding ElementName=ScheduleTimeLabel}"/>
       <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource DialogLabel}"/>
       <ComboBox x:Name="ScheduleMinuteInput" Width="80" Height="32" IsEditable="False" HorizontalContentAlignment="Center" Style="{StaticResource AppComboBox}" SelectionChanged="ScheduleInput_Changed" AutomationProperties.AutomationId="ScheduleMinuteInput" AutomationProperties.Name="Minute" AutomationProperties.LabeledBy="{Binding ElementName=ScheduleTimeLabel}"/>
      </StackPanel>
      <TextBlock x:Name="ScheduleZoneLabel" Grid.Row="2" Text="Time zone" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
       <RadioButton x:Name="ScheduleUtc" Content="UTC" IsChecked="True" GroupName="TimeZone" Margin="0,0,20,0" Checked="ScheduleZone_Checked" Style="{StaticResource ScheduleChoiceRadioButton}"/>
       <RadioButton x:Name="ScheduleLocal" Content="Local" GroupName="TimeZone" Margin="0,0,0,0" Checked="ScheduleZone_Checked" Style="{StaticResource ScheduleChoiceRadioButton}"/>
      </WrapPanel>
      <TextBlock x:Name="ResolvedSchedule" Grid.Row="3" Grid.Column="1" Text="One time for all messages" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource DialogCaption}"/>
     </Grid>
       </StackPanel></Border>
       <Border x:Name="ReviewSummaryCard" Grid.Row="0" Grid.Column="1" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="16" Margin="9,0,0,0"><StackPanel>
        <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Messages" FontWeight="SemiBold" VerticalAlignment="Top"/><TextBlock x:Name="ReviewMessageCount" Grid.Column="1" Text="3 valid messages" Margin="0,0,0,7"/><TextBlock Grid.Row="1" Text="Body size" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><TextBlock x:Name="ReviewTotalSize" Grid.Row="1" Grid.Column="1" Text="0 bytes UTF-8" Margin="0,0,0,7" AutomationProperties.AutomationId="PrototypeReviewTotalSize" TextWrapping="WrapWithOverflow"/><TextBlock Grid.Row="3" Text="TTL" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><TextBlock x:Name="ReviewTtl" Grid.Row="3" Grid.Column="1" Text="inherit entity default" TextWrapping="WrapWithOverflow" Margin="0,0,0,7"/><TextBlock Grid.Row="4" Text="Properties" Style="{StaticResource DialogCaption}" VerticalAlignment="Top"/><ScrollViewer Grid.Row="4" Grid.Column="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Message properties"><TextBlock x:Name="ReviewPropertyDetails" TextWrapping="WrapWithOverflow"/></ScrollViewer></Grid>
       </StackPanel></Border>
      </Grid>
     <TextBlock x:Name="ReviewError" Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel x:Name="ProgressSurface" Visibility="Collapsed"><TextBlock x:Name="ProgressHeading" Text="Sending 3 messages" Style="{StaticResource WorkbenchHeading}"/><TextBlock x:Name="ProgressTarget" Text="Target: Local emulator / localhost / order-events" Margin="0,0,0,20"/><TextBlock x:Name="ProgressStatus" Text="0 of 3 acknowledged" Margin="0,0,0,8"/><ProgressBar x:Name="DispatchProgress" Height="10" Minimum="0" Maximum="3"/><TextBlock Text="Stops further submissions; acknowledged messages remain unchanged." Margin="0,20,0,20" TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}"/><Button x:Name="StopDispatch" Content="Stop" Click="StopDispatch_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeStopDispatch"/></StackPanel>
    <StackPanel x:Name="ResultsSurface" Visibility="Collapsed"><TextBlock x:Name="ResultsHeading" Text="Run results" Style="{StaticResource WorkbenchHeading}"/><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="35" MaxHeight="260" VerticalAlignment="Top" AutomationProperties.AutomationId="PrototypeRunResults"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Row}" Width="40" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="Auto" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="Auto" MaxWidth="160" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="90" ElementStyle="{StaticResource CompactDataGridText}"/></DataGrid.Columns></DataGrid><Border Background="{DynamicResource NeutralHoverBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,18"><TextBlock Text="Results are session-only. Broker counts refresh independently. No automatic retry is performed." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Export results" Click="ExportResults_Click"/><Button x:Name="CancelScheduled" Content="Cancel scheduled messages" Click="ShowCancellation_Click" Visibility="Collapsed" AutomationProperties.AutomationId="PrototypeShowCancellation"/><Button Content="View destination" Click="ViewDestination_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="PrototypeViewDestination"/></StackPanel></StackPanel>
    <StackPanel x:Name="CancellationSurface" Visibility="Collapsed"><TextBlock Text="Scheduled results" Style="{StaticResource WorkbenchHeading}"/><TextBlock x:Name="CancellationTarget" Text="Local emulator · order-events · Due time (UTC)" Margin="0,0,0,12"/><DataGrid x:Name="ScheduledGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="36" MaxHeight="250" VerticalAlignment="Top" AutomationProperties.AutomationId="PrototypeScheduledResults"><DataGrid.Columns><DataGridCheckBoxColumn Header="" Binding="{Binding Selected}" Width="40" ElementStyle="{StaticResource CompactDataGridCheckBox}"/><DataGridTextColumn Header="#" Binding="{Binding Row}" Width="45" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Receipt" Binding="{Binding Receipt}" Width="90" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="Auto" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Status" Binding="{Binding Outcome}" Width="Auto" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Scheduled for (UTC)" Binding="{Binding DueTime}" Width="*" MinWidth="160" ElementStyle="{StaticResource CompactDataGridText}"/></DataGrid.Columns></DataGrid><TextBlock Text="Cancellation may race activation. A request does not guarantee that a message was not activated." Foreground="{DynamicResource WarningHealthBrush}" TextWrapping="Wrap" Margin="0,14,0,14"/><TextBlock x:Name="CancellationError" Text="Select at least one eligible scheduled message before cancelling." Foreground="{DynamicResource DestructiveBrush}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed" AutomationProperties.AutomationId="PrototypeCancellationError"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back to results" Click="BackToResults_Click"/><Button Content="Cancel selected scheduled" Click="ConfirmCancellation_Click" Style="{StaticResource DestructiveButton}" AutomationProperties.AutomationId="PrototypeCancelScheduled"/></StackPanel></StackPanel>
    <StackPanel x:Name="HistorySurface" Visibility="Collapsed"><TextBlock Text="Cancellation history" Style="{StaticResource WorkbenchHeading}"/><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="36" MaxHeight="240" VerticalAlignment="Top"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding Receipt}" Width="90" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="Auto" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Cancellation status" Binding="{Binding Outcome}" Width="Auto" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/><DataGridTextColumn Header="Attempt (UTC)" Binding="{Binding RequestedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="*" MinWidth="160" ElementStyle="{StaticResource CompactDataGridText}"/></DataGrid.Columns></DataGrid><TextBlock x:Name="CancellationHistoryNotice" Text="Dispatch results remain unchanged. Retry requires fresh confirmation." TextWrapping="Wrap" Foreground="{DynamicResource ActionTextBrush}" Margin="0,16,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back to results" Click="BackToResults_Click"/><Button x:Name="RetryCancellation" Content="Retry cancellation" Click="ConfirmCancellation_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1">
   <Border Visibility="{Binding Visibility, ElementName=ReviewFooter}" Background="{DynamicResource NeutralHoverBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="ReviewNotice" Text="Subscriptions receive according to their rules." TextWrapping="Wrap"/></Border>
   <Border x:Name="ReviewFooter" Visibility="Collapsed" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Back to preparation" Click="Back_Click" Padding="10,7"/><Button x:Name="ConfirmDispatch" Grid.Column="2" Content="Send 3 messages" Click="Dispatch_Click" Style="{StaticResource PrimaryButton}" Padding="13,8" AutomationProperties.AutomationId="PrototypeConfirmDispatch"/></Grid>
   </Border>
  </StackPanel>
 </Grid>
</UserControl>
