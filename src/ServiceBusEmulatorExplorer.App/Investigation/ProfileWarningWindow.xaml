<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.ProfileWarningWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connection warning" Width="520" Height="390" MinWidth="460" MinHeight="320"
 WindowStartupLocation="CenterOwner" Icon="/ServiceBusEmulatorExplorer.App;component/Assets/AppIcon.png" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="{DynamicResource CanvasBrush}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Path Data="M10,1 L19,18 H1 Z M10,6 V11 M10,14 V15" Stroke="#946000" StrokeThickness="1.7" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock x:Name="WarningHeading" Text="Connection warning" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
  <TextBlock x:Name="ProfileNameText" Grid.Row="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,14,0,14" AutomationProperties.Name="Connection profile"/>
  <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="{Binding Text, ElementName=WarningHeading, StringFormat={}{0} message}">
    <TextBlock x:Name="WarningMessageText" TextWrapping="Wrap" AutomationProperties.AutomationId="WarningMessageText"/>
   </ScrollViewer>
  </Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" AutomationProperties.AutomationId="CancelButton" AutomationProperties.Name="Cancel connection"/>
   <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Continue_Click" AutomationProperties.AutomationId="ContinueButton" AutomationProperties.Name="Continue connection">
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ContinueLabel" Text="Continue" VerticalAlignment="Center"/><Path Data="M1,7 H14 M8,1 L14,7 L8,13" Stroke="White" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
   </Button>
  </StackPanel>
 </Grid></Border>
</Window>
