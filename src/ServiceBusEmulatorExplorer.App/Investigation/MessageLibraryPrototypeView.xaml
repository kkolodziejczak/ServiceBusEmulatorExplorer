<UserControl x:Class="ServiceBusEmulatorExplorer.App.Investigation.MessageLibraryPrototypeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:inspection="clr-namespace:ServiceBusEmulatorExplorer.App.Investigation.Inspection"
 Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14"
 Foreground="{DynamicResource InkBrush}" AutomationProperties.Name="Message Workbench prototype">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="PrototypeTemplateItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="7,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="Selection" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="PreviewTab" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardActionFocusVisual}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="0,0,0,7"/><Setter Property="Margin" Value="0,0,18,0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NeutralPressedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="PreviewTabActive" TargetType="Button" BasedOn="{StaticResource PreviewTab}"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Style>
   <Style x:Key="PreviewModeButton" TargetType="Button">
    <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
   </Style>
   <Style x:Key="PreviewModeActive" TargetType="Button" BasedOn="{StaticResource PreviewModeButton}"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="OutlineActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Style>
   <Style x:Key="WizardStep" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardActionFocusVisual}"/><Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Padding" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="StepFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" CornerRadius="15" Background="{TemplateBinding Background}" Margin="0,0,9,0"><TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding BorderBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepFrame" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="WizardStepActive" TargetType="Button" BasedOn="{StaticResource WizardStep}"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="White"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/></Style>
   <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CenteredDataGridColumnHeader}"/>
   <Style TargetType="DataGridRow" BasedOn="{StaticResource CenteredDataGridRow}"><Setter Property="Height" Value="32"/></Style>
   <Style TargetType="DataGridCell" BasedOn="{StaticResource CenteredDataGridCell}"/>
   <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid Margin="10,0"><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,19,0" VerticalAlignment="Center"/><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Width="8" Height="4"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}" Padding="0,4"><ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="CenteredDataGridCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </ResourceDictionary></UserControl.Resources>
<Grid x:Name="WorkbenchRoot">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="220"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
  <Border x:Name="WizardSteps" Grid.Row="0" Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,8" AutomationProperties.Name="Message preparation progress">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ComposeStepButton" Tag="1" Content="Compose" Click="ComposeStep_Click" Style="{StaticResource WizardStepActive}" AutomationProperties.AutomationId="LibraryComposeStep"/>
    <Border x:Name="ComposeConnector" Width="64" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <Button x:Name="PrepareStepButton" Tag="2" Content="Prepare" Click="PrepareStep_Click" Style="{StaticResource WizardStep}" AutomationProperties.AutomationId="LibraryPrepareStep"/>
    <Border x:Name="PrepareConnector" Width="64" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <Button x:Name="ReviewStepButton" Tag="3" Content="Review &amp; send" Click="ReviewStep_Click" Style="{StaticResource WizardStep}" IsEnabled="False" AutomationProperties.AutomationId="LibraryReviewStep"/>
   </StackPanel>
  </Border>
  <Grid Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource RaisedBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="14,16,12,10">
    <TextBox x:Name="TemplateSearch" Padding="30,7,35,7" TextChanged="TemplateSearch_Changed" ToolTip="Filter the sample template names" AutomationProperties.Name="Search templates" AutomationProperties.AutomationId="LibrarySearch"/>
    <Path Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M9,9 L14,14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
    <TextBlock Text="Search templates" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="31,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TemplateSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Button x:Name="ClearTemplateSearchButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="30" Margin="2" Padding="0" Visibility="Collapsed" Click="ClearTemplateSearch_Click" ToolTip="Clear template search" AutomationProperties.Name="Clear template search" AutomationProperties.AutomationId="LibraryClearSearch"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/></Button>
   </Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="13,3,9,10"><StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Path Data="M1,4 H7 L9,6 H17 V16 H1 Z" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="18" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Team messages" FontWeight="SemiBold"/></StackPanel><StackPanel x:Name="OrdersFolderLabel" Orientation="Horizontal" Margin="16,0,0,8"><Path Data="M1,4 H7 L9,6 H17 V16 H1 Z" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="18" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Orders" Foreground="{DynamicResource ActionTextBrush}"/></StackPanel><TextBlock x:Name="EmptyTemplates" Text="No saved templates for this topic." Visibility="Collapsed" Margin="9,12" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/><ListBox x:Name="TemplateList" SelectionChanged="TemplateList_Changed" Margin="37,0,0,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PrototypeTemplateItem}" AutomationProperties.Name="Saved templates" AutomationProperties.AutomationId="LibraryTree"/><StackPanel x:Name="AddedFolders"/></StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="4,14"><StackPanel Orientation="Horizontal"><Button Click="AddFolder_Click" Padding="4,6" FontSize="12" AutomationProperties.AutomationId="LibraryAddFolder"><StackPanel Orientation="Horizontal"><Path Data="M2,5 H7 L9,8 H18 V18 H2 Z M10,12 H16 M13,9 V15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,3,0"/><TextBlock Text="Add folder"/></StackPanel></Button><Button Click="RefreshLibrary_Click" Padding="4,6" FontSize="12" AutomationProperties.AutomationId="LibraryRefresh"><StackPanel Orientation="Horizontal"><Path Data="M14,2 V6 H10 M14,6 A6,6 0 1 0 14,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,3,0"/><TextBlock Text="Refresh"/></StackPanel></Button><Button Click="OpenNewMenu_Click" Padding="4,6" FontSize="12" AutomationProperties.AutomationId="LibraryNew"><StackPanel Orientation="Horizontal"><TextBlock Text="New"/><Path Data="M0,0 L4,4 L8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="8" Height="4" Stretch="Uniform" Margin="3,0,0,0" VerticalAlignment="Center"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="New template" Click="NewTemplate_Click"/><MenuItem Header="Capture sample message" Click="CaptureSample_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel></Border>
  </Grid>
  <GridSplitter Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerBrush}" AutomationProperties.Name="Resize saved templates pane"/>
  <Grid x:Name="AuthorPane" Grid.Row="1" Grid.Column="2" Background="{DynamicResource RaisedBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="18,16,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AuthorTitle" Text="Order created" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AuthorSubtitle" Text="Emitted when a new order is created in the retail system." Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/><TextBlock x:Name="FilterWarning" Text="Outside current filter · Choose a destination before review" Foreground="{DynamicResource WarningHealthBrush}" FontSize="12" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="SaveButton" Content="Save" Click="Save_Click" Padding="10,7" AutomationProperties.AutomationId="LibrarySave"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Path Data="M2,2 H15 L18,5 V18 H2 Z M5,2 V8 H14 V2 M5,12 H15 V18" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{Binding}"/></StackPanel></DataTemplate></Button.ContentTemplate></Button><Button Content="Save as" Click="SaveAs_Click" Padding="10,7" Margin="7,0,0,0" AutomationProperties.AutomationId="LibrarySaveAs"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="18,0,18,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="EditorBodyTab" Content="Body" Click="EditorBody_Click" Style="{StaticResource PreviewTabActive}" AutomationProperties.AutomationId="LibraryEditorBody"/><Button x:Name="EditorPropertiesTab" Content="Properties" Click="EditorProperties_Click" Style="{StaticResource PreviewTab}" AutomationProperties.AutomationId="LibraryEditorProperties"/><Button x:Name="EditorVariablesTab" Content="Variables" Click="EditorVariables_Click" Style="{StaticResource PreviewTab}" AutomationProperties.AutomationId="LibraryEditorVariables"/></StackPanel><StackPanel x:Name="EditorModeButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="EditorJsonTab" Content="JSON" Click="EditorJson_Click" Style="{StaticResource PreviewModeActive}"/><Button x:Name="EditorTextTab" Content="Text" Click="EditorTextMode_Click" Margin="7,0,0,0" Style="{StaticResource PreviewModeButton}"/></StackPanel></Grid></Border>
     <Grid Grid.Row="1">
      <Grid x:Name="BodyEditorSurface"><Border Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"><inspection:JsonEditor x:Name="EditorText" FontFamily="Consolas" FontSize="14" Foreground="#DCE7F3" Background="{DynamicResource EditorBackgroundBrush}" BorderThickness="0" Padding="20,18" IsReadOnly="False" ShowLineNumbers="True" LineNumbersForeground="#8394A9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Template author body" AutomationProperties.AutomationId="LibraryAuthorEditor"/></Border><TextBox x:Name="EditorPlainText" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Foreground="#DCE7F3" Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" Padding="20,18" AutomationProperties.Name="Template text body"/><Button Content="Copy" Click="CopyAuthor_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,12,0" Padding="8,4" Style="{StaticResource DarkButton}" AutomationProperties.AutomationId="LibraryCopyAuthor"/></Grid>
      <ScrollViewer x:Name="PropertiesEditorSurface" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,14,16,18">
       <TextBlock Text="Properties" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Subject" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertySubject" Text="OrderCreated" Margin="0,0,0,7" AutomationProperties.Name="Subject" AutomationProperties.AutomationId="LibrarySubject"/>
        <TextBlock Grid.Row="1" Text="Content type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="PropertyContentType" SelectedIndex="0" Margin="0,0,0,7" AutomationProperties.Name="Content type"><ComboBoxItem Content="application/json"/><ComboBoxItem Content="text/plain"/></ComboBox>
        <TextBlock Grid.Row="2" Text="Correlation ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="PropertyCorrelationId" Text="$(CustomerId)" Margin="0,0,0,7" AutomationProperties.Name="Correlation ID"/>
        <TextBlock Grid.Row="3" Text="Session ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="PropertySessionId" Margin="0,0,0,7" AutomationProperties.Name="Session ID"/>
        <TextBlock Grid.Row="4" Text="Message ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/><Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><RadioButton x:Name="GeneratedMessageId" Content="Generate new" IsChecked="True" GroupName="MessageIdMode" Margin="0,0,18,0" Checked="MessageIdMode_Checked"/><RadioButton x:Name="CustomMessageId" Content="Custom" GroupName="MessageIdMode" Checked="MessageIdMode_Checked"/></WrapPanel><TextBox Grid.Row="1" x:Name="CustomMessageIdInput" IsEnabled="False" Margin="0,6,0,0" AutomationProperties.Name="Custom message ID"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="IsEnabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid>
        <TextBlock Grid.Row="5" Text="Time to live (TTL)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/><Grid Grid.Row="5" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><RadioButton x:Name="InheritTtl" Content="Inherit entity default" IsChecked="True" GroupName="TtlMode" Margin="0,0,18,0" Checked="TtlMode_Checked"/><RadioButton x:Name="SpecifyTtl" Content="Specify duration" GroupName="TtlMode" Checked="TtlMode_Checked"/></WrapPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="TtlMinutes" Text="10" Width="56" IsEnabled="False" AutomationProperties.Name="TTL minutes"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="IsEnabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Text="min" Margin="5,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=TtlMinutes}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid>
       </Grid>
       <Expander x:Name="ReplyRoutingExpander" Header="Reply and routing" IsExpanded="False" Margin="0,0,0,10" AutomationProperties.AutomationId="LibraryReplyRouting"><StackPanel Margin="10,8,0,0">
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Reply to" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertyReplyTo" Text="order-replies"/></Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Reply session ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertyReplySessionId"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Partition key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBox x:Name="PropertyPartitionKey" Margin="0,0,0,3"/><TextBlock Text="Partition key is unsupported by the emulator." Style="{StaticResource Caption}"/></StackPanel></Grid>
       </StackPanel></Expander>
       <TextBlock Text="Application properties" FontWeight="SemiBold" Margin="0,0,0,7"/><DataGrid x:Name="ApplicationPropertiesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="34" Margin="0,0,0,7" PreviewKeyDown="ApplicationPropertiesGrid_PreviewKeyDown" SelectionChanged="ApplicationPropertiesGrid_SelectionChanged" AutomationProperties.Name="Application properties" AutomationProperties.AutomationId="LibraryApplicationProperties"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}"/><DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="110" ElementStyle="{StaticResource CenteredDataGridComboDisplay}" EditingElementStyle="{StaticResource CenteredDataGridCombo}"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.5*" ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button x:Name="AddPropertyButton" Content="+ Add property" Click="AddProperty_Click" HorizontalAlignment="Left" Padding="8,5" AutomationProperties.AutomationId="LibraryAddProperty"/><Button x:Name="DeleteSelectedPropertyButton" Content="Delete selected" Click="DeleteSelectedProperty_Click" HorizontalAlignment="Left" Padding="8,5" Margin="8,0,0,0" Style="{StaticResource DestructiveButton}" IsEnabled="False" AutomationProperties.AutomationId="LibraryDeleteSelectedProperty"/></StackPanel>
       <WrapPanel Margin="0,10,0,0"><TextBlock Text="Topic associations" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><WrapPanel x:Name="AssociationChips" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="+ Add association" Click="AddAssociation_Click" Padding="8,5"/></WrapPanel>
      </StackPanel></ScrollViewer>
      <Grid x:Name="VariablesEditorSurface" Visibility="Collapsed" Margin="16,14,16,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Variables" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><DataGrid x:Name="VariablesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="VariableSelection_Changed" RowHeight="34" AutomationProperties.Name="Template variables"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="115" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><StackPanel x:Name="VariableDefaultEditor" Visibility="Collapsed" Margin="0,10,0,7"><TextBlock x:Name="SelectedVariableName" Text="CustomerId default" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="UseVariableDefault" Content="Use default" Checked="VariableDefault_Changed" Unchecked="VariableDefault_Changed" VerticalAlignment="Center"/><TextBox x:Name="VariableDefaultValue" Width="150" Margin="12,0,0,0" TextChanged="VariableDefaultValue_Changed" AutomationProperties.Name="Selected variable default value"/></StackPanel></StackPanel><TextBlock Text="GUID per row. One UTC instant per prepared run." Style="{StaticResource Caption}" Margin="0,8,0,14"/><Button Content="Add variable" Click="AddVariable_Click" HorizontalAlignment="Left" Style="{StaticResource OutlineActionButton}"/></StackPanel></Grid>
     </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Draft kept while preparing" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="ContinueToPrepareButton" Content="Prepare message" Click="ContinueToPrepare_Click" Style="{StaticResource PrimaryButton}" Padding="13,8" AutomationProperties.AutomationId="LibraryContinueToPrepare"/></Grid></Border>
  </Grid>
  <Grid x:Name="PreparePane" Grid.Row="1" Grid.Column="2" Background="{DynamicResource RaisedBrush}" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="18,16,18,12"><StackPanel><TextBlock x:Name="PageTitle" Text="Prepare messages" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PageSubtitle" Text="Generate and preview messages using sample data." Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
   <Grid x:Name="PrepareBody" Grid.Row="1" Margin="18,0,18,15"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PrepareInputsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0"><StackPanel x:Name="PrepareSurface" AutomationProperties.AutomationId="LibraryPrepareSurface">
    <StackPanel Orientation="Horizontal" Margin="0,16,0,18"><RadioButton x:Name="SingleMode" Content="Single message" IsChecked="False" Checked="InputMode_Checked" GroupName="InputMode" Margin="0,4,16,0" AutomationProperties.AutomationId="LibrarySingleMode"/><RadioButton x:Name="CsvMode" Content="CSV batch" IsChecked="True" Checked="InputMode_Checked" GroupName="InputMode" Margin="0,4,0,0" AutomationProperties.AutomationId="LibraryCsvMode"/></StackPanel>
    <StackPanel x:Name="SingleInputs" Visibility="Collapsed">
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CustomerId *" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="CustomerInput" Text="C1001" TextChanged="Input_Changed" AutomationProperties.Name="Customer ID" AutomationProperties.AutomationId="LibraryCustomerId"/></Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Amount *" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="AmountInput" Text="149.90" TextChanged="Input_Changed" AutomationProperties.Name="Amount" AutomationProperties.AutomationId="LibraryAmount"/></Grid>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="EventId" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="SingleEventId" Text="Waiting for valid inputs" IsReadOnly="True" AutomationProperties.Name="Generated event ID" AutomationProperties.AutomationId="LibraryGeneratedEventId"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="OccurredAt (UTC)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="SingleOccurredAt" Text="Waiting for valid inputs" IsReadOnly="True" AutomationProperties.Name="Generated UTC time" AutomationProperties.AutomationId="LibraryGeneratedOccurredAt"/></Grid>
    </StackPanel>
    <StackPanel x:Name="CsvInputs">
      <TextBlock Text="CSV file" Style="{StaticResource FieldLabel}"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <TextBox x:Name="CsvFile" Text="orders.csv" IsReadOnly="True" AutomationProperties.Name="Sample CSV file"/>
        <Button Grid.Column="1" Content="Browse" Click="BrowseCsv_Click" Margin="8,0,0,0" Padding="10,7" AutomationProperties.AutomationId="LibraryBrowseCsv"/>
      </Grid>
      <Grid Margin="0,13,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Delimiter" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="CsvDelimiter" SelectedIndex="0" SelectionChanged="CsvDelimiter_Changed" AutomationProperties.Name="CSV delimiter"><ComboBoxItem Content="Comma (,)"/><ComboBoxItem Content="Semicolon (;)"/></ComboBox>
        </StackPanel>
        <Button Grid.Column="1" Content="Map columns" Click="MapColumns_Click" Margin="16,21,0,0" Padding="10,7" AutomationProperties.AutomationId="LibraryMapColumns"/>
      </Grid>
<Border x:Name="CsvValidationSummary" Background="#E8F7EF" BorderBrush="#9DD8B6" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,13,0,0"><DockPanel><TextBlock x:Name="ValidationStatusText" Text="3 of 3 rows valid" Foreground="#197442" FontWeight="SemiBold"/><Button x:Name="ValidationDetailsButton" Content="View results" IsEnabled="False" MinHeight="0" Height="20" Click="ViewValidationResults_Click" HorizontalAlignment="Right" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" AutomationProperties.AutomationId="LibraryValidationDetails"/></DockPanel></Border>
      <DataGrid x:Name="CsvRowsGrid" SelectionChanged="CsvRows_Changed" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" RowHeight="32" Margin="0,8,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" AutomationProperties.Name="CSV validation rows" AutomationProperties.AutomationId="LibraryPreviewRows"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding}" Width="35" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="CustomerId" Binding="{Binding}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/><DataGridTextColumn Header="Status" Binding="{Binding}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}"/></DataGrid.Columns></DataGrid>
    </StackPanel>
   </StackPanel></ScrollViewer>
   <Grid x:Name="PreviewSurface" Grid.Column="1" Margin="18,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Row 1 preview" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/><TextBlock x:Name="PreviewHint" Grid.Row="1" Text="3 of 3 rows valid" Style="{StaticResource Caption}" Margin="0,0,0,8"/><StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="BodyTab" Content="Body" Click="BodyTab_Click" Style="{StaticResource PreviewTabActive}" AutomationProperties.AutomationId="LibraryPreviewBody"/><Button x:Name="PropertiesTab" Content="Properties" Click="PropertiesTab_Click" Style="{StaticResource PreviewTab}" AutomationProperties.AutomationId="LibraryPreviewProperties"/></StackPanel><Border Grid.Row="3" Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" MinHeight="155"><inspection:JsonEditor x:Name="PreviewText" Text="No preview yet." FontFamily="Consolas" FontSize="14" Foreground="#DCE7F3" Background="{DynamicResource EditorBackgroundBrush}" BorderThickness="0" Padding="14,12" IsReadOnly="True" ShowLineNumbers="True" LineNumbersForeground="#8394A9" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prepared message preview" AutomationProperties.AutomationId="LibraryPreviewText"/></Border></Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BackToComposeButton" Content="Back to template" Click="BackToCompose_Click" HorizontalAlignment="Left" Padding="10,7" AutomationProperties.AutomationId="LibraryBackToCompose"/><StackPanel x:Name="FooterDestination" Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock x:Name="DestinationText" Text="Send to: order-events (Topic)" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DestinationProfileText" Text="Current connection" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel x:Name="FooterActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ChooseDestinationButton" Content="Choose destination" Click="ChooseDestination_Click" Visibility="Collapsed" Padding="10,7" Margin="0,0,8,0" AutomationProperties.AutomationId="LibraryChooseDestination"/><Button x:Name="ViewRunResultsButton" Content="View results" Click="ViewRunResults_Click" Visibility="Collapsed" Padding="10,7" Margin="0,0,8,0" AutomationProperties.AutomationId="LibraryViewRunResults"/><Button x:Name="ReviewButton" Content="Review 3 messages" Click="Review_Click" Style="{StaticResource PrimaryButton}" Padding="13,8" IsEnabled="False" AutomationProperties.AutomationId="LibraryReview"/></StackPanel></Grid></Border>
  </Grid>
  <ContentControl x:Name="ReviewHost" Grid.Row="1" Grid.Column="2" Background="{DynamicResource RaisedBrush}" Margin="18,16,18,0" Visibility="Collapsed" AutomationProperties.AutomationId="LibraryReviewStage"/>
 </Grid>
</UserControl>
