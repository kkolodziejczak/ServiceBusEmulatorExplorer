   <Grid x:Name="PrepareBody" Grid.Row="1" Margin="18,0,18,15"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PrepareInputsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0"><StackPanel x:Name="PrepareSurface" AutomationProperties.AutomationId="LibraryPrepareSurface">
    <StackPanel Orientation="Horizontal" Margin="0,16,0,18"><RadioButton x:Name="SingleMode" Content="Single message" IsChecked="False" Checked="InputMode_Checked" GroupName="InputMode" Margin="0,4,16,0" AutomationProperties.AutomationId="LibrarySingleMode"/><RadioButton x:Name="CsvMode" Content="CSV batch" IsChecked="True" Checked="InputMode_Checked" GroupName="InputMode" Margin="0,4,0,0" AutomationProperties.AutomationId="LibraryCsvMode"/></StackPanel>
    <StackPanel x:Name="SingleInputs" Visibility="Collapsed">
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CustomerId *" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="CustomerInput" Text="C1001" TextChanged="Input_Changed" AutomationProperties.Name="Customer ID" AutomationProperties.AutomationId="LibraryCustomerId"/></Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Amount *" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="AmountInput" Text="149.90" TextChanged="Input_Changed" AutomationProperties.Name="Amount" AutomationProperties.AutomationId="LibraryAmount"/></Grid>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="EventId" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="SingleEventId" Text="Waiting for valid inputs" IsReadOnly="True" AutomationProperties.Name="Generated event ID" AutomationProperties.AutomationId="LibraryGeneratedEventId"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="OccurredAt (UTC)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="SingleOccurredAt" Text="Waiting for valid inputs" IsReadOnly="True" AutomationProperties.Name="Generated UTC time" AutomationProperties.AutomationId="LibraryGeneratedOccurredAt"/></Grid>
    </StackPanel>
    <StackPanel x:Name="CsvInputs">
      <TextBlock Text="CSV file" Style="{StaticResource FieldLabel}"/>
