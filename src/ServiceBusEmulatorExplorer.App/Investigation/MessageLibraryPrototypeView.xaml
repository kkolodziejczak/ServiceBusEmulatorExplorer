<UserControl x:Class="ServiceBusEmulatorExplorer.App.Investigation.MessageLibraryPrototypeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:inspection="clr-namespace:ServiceBusEmulatorExplorer.App.Investigation.Inspection"
 Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14"
 Foreground="{DynamicResource InkBrush}" AutomationProperties.Name="Message Workbench prototype">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
   <Style x:Key="WorkbenchTreeItem" TargetType="TreeViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="SelectionBackground" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="3"/><ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="30" Padding="0" BorderThickness="0" Focusable="False" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 5 L 0 10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" Margin="0,4"/><ItemsPresenter x:Name="ChildrenPresenter" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBackground" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="SelectionBackground" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PreviewTab" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardActionFocusVisual}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="0,0,0,7"/><Setter Property="Margin" Value="0,0,18,0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NeutralPressedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="PreviewTabActive" TargetType="Button" BasedOn="{StaticResource PreviewTab}"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Style>
   <Style x:Key="OutlineActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Style>
   <Style x:Key="WizardStep" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardActionFocusVisual}"/><Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Padding" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="StepFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" CornerRadius="15" Background="{TemplateBinding Background}" Margin="0,0,9,0"><TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding BorderBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepFrame" Property="Background" Value="{DynamicResource NeutralHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="WizardStepActive" TargetType="Button" BasedOn="{StaticResource WizardStep}"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="White"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style TargetType="DataGridRow" BasedOn="{StaticResource CompactDataGridRow}"><Setter Property="Height" Value="32"/></Style>
   <Style x:Key="PropertyNameDisplay" TargetType="TextBlock" BasedOn="{StaticResource CompactDataGridText}">
    <Setter Property="Text" Value="{Binding Name, FallbackValue='+ Add property...', TargetNullValue='+ Add property...'}"/>
    <Style.Triggers><DataTrigger Binding="{Binding Name, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="PropertyDeleteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="3"/><Setter Property="Visibility" Value="Hidden"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding Name, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers>
   </Style>
 </ResourceDictionary></UserControl.Resources>
<Grid x:Name="WorkbenchRoot" PreviewMouseDown="WorkbenchRoot_PreviewMouseDown">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
  <Border x:Name="WizardSteps" Grid.Row="0" Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,8" AutomationProperties.Name="Message preparation progress">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ComposeStepButton" Tag="1" Content="Compose" Click="ComposeStep_Click" Style="{StaticResource WizardStepActive}" AutomationProperties.AutomationId="LibraryComposeStep"/>
    <Border x:Name="ComposeConnector" Width="64" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <Button x:Name="PrepareStepButton" Tag="2" Content="Prepare" Click="PrepareStep_Click" Style="{StaticResource WizardStep}" AutomationProperties.AutomationId="LibraryPrepareStep"/>
    <Border x:Name="PrepareConnector" Width="64" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <Button x:Name="ReviewStepButton" Tag="3" Content="Review &amp; send" Click="ReviewStep_Click" Style="{StaticResource WizardStep}" IsEnabled="False" AutomationProperties.AutomationId="LibraryReviewStep"/>
   </StackPanel>
  </Border>
  <Grid Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource RaisedBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="14,16,12,8">
    <TextBox x:Name="TemplateSearch" Padding="30,7,35,7" TextChanged="TemplateSearch_Changed" ToolTip="Filter the sample template names" AutomationProperties.Name="Search templates" AutomationProperties.AutomationId="LibrarySearch"/>
    <Path Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M9,9 L14,14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
    <TextBlock Text="Search templates" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="31,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TemplateSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Button x:Name="ClearTemplateSearchButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="30" Margin="2" Padding="0" Visibility="Collapsed" Click="ClearTemplateSearch_Click" ToolTip="Clear template search" AutomationProperties.Name="Clear template search" AutomationProperties.AutomationId="LibraryClearSearch"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/></Button>
   </Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,9,5">
    <Button x:Name="LibraryNewButton" Click="NewTemplate_Click" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="New template" AutomationProperties.Name="New template" AutomationProperties.AutomationId="LibraryNew"><Path Data="M3,1 H13 L17,5 V19 H3 Z M6,8 H14 M6,11 H14 M6,14 H11 M14,13 V19 M11,16 H17" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="16" Height="18" Stretch="Uniform"/></Button>
    <Button x:Name="LibraryAddFolderButton" Click="AddFolder_Click" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="New folder" AutomationProperties.Name="New folder" AutomationProperties.AutomationId="LibraryAddFolder"><Path Data="M2,5 H7 L9,8 H18 V18 H2 Z M10,13 H16 M13,10 V16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="17" Stretch="Uniform"/></Button>
    <Button x:Name="LibraryCollapseAllButton" Click="CollapseAllFolders_Click" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Collapse all folders" AutomationProperties.Name="Collapse all folders" AutomationProperties.AutomationId="LibraryCollapseAll"><Path Data="M5,2 H18 V15 M2,5 H15 V18 H2 Z M5,11 H12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="19" Stretch="Uniform"/></Button>
   </StackPanel>
   <TreeView x:Name="LibraryTree" Grid.Row="2" Margin="7,0,5,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource WorkbenchTreeItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="LibraryTree_SelectionChanged" PreviewMouseDown="LibraryTree_PreviewMouseDown" PreviewKeyDown="LibraryTree_PreviewKeyDown" AllowDrop="True" PreviewMouseLeftButtonDown="LibraryTree_DragStart"
    PreviewMouseMove="LibraryTree_DragMove" DragOver="LibraryTree_DragOver" DragLeave="LibraryTree_DragLeave" Drop="LibraryTree_Drop" AutomationProperties.Name="Saved templates" AutomationProperties.AutomationId="LibraryTree"/>
  </Grid>
  <GridSplitter Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerBrush}" AutomationProperties.Name="Resize saved templates pane"/>
  <Grid x:Name="AuthorPane" Grid.Row="1" Grid.Column="2" Background="{DynamicResource RaisedBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="18,16,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AuthorTitle" Text="Order created" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="Order created"/><Button x:Name="LibraryRenameButton" Grid.Column="1" Click="BeginRenameCurrentTemplate_Click" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="7,0,0,0" ToolTip="Rename template" AutomationProperties.Name="Rename template" AutomationProperties.AutomationId="LibraryRename"><Path Data="M3,14 L13,4 L17,8 L7,18 L2,19 Z M11,6 L15,10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button><WrapPanel x:Name="LibraryRenameEditor" Grid.ColumnSpan="2" Visibility="Collapsed">
 <TextBox x:Name="LibraryRenameInput" Width="180" MinWidth="80" Margin="0,0,8,4" KeyDown="LibraryRenameInput_KeyDown" AutomationProperties.Name="Rename template" AutomationProperties.AutomationId="LibraryRenameInput"/>
 <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
  <Button Content="Save name" Click="SaveRename_Click" Style="{StaticResource PrimaryButton}" Padding="9,5" AutomationProperties.Name="Save name" AutomationProperties.AutomationId="LibraryRenameSave"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Path Data="M1,6 L5,10 L13,1" Stroke="White" StrokeThickness="1.5" Width="13" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding}"/></StackPanel></DataTemplate></Button.ContentTemplate></Button>
  <Button Click="CancelRename_Click" Style="{StaticResource IconButton}" Width="30" Height="32" Margin="4,0,0,0" ToolTip="Cancel rename" AutomationProperties.Name="Cancel rename" AutomationProperties.AutomationId="LibraryRenameCancel"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/></Button>
 </StackPanel>
</WrapPanel><TextBlock x:Name="LibraryRenameError" Grid.Row="1" Grid.ColumnSpan="2" Text="Enter a name." Foreground="{DynamicResource DestructiveBrush}" FontSize="12" Visibility="Collapsed"/><TextBlock x:Name="FilterWarning" Grid.Row="2" Grid.ColumnSpan="2" Text="Outside current filter" Foreground="{DynamicResource WarningHealthBrush}" FontSize="12" Visibility="Collapsed"/></Grid><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="SaveButton" Content="Save" Click="Save_Click" Padding="10,7" AutomationProperties.AutomationId="LibrarySave"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Path Data="M2,2 H15 L18,5 V18 H2 Z M5,2 V8 H14 V2 M5,12 H15 V18" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{Binding}"/></StackPanel></DataTemplate></Button.ContentTemplate></Button><Button Content="Save as" Click="SaveAs_Click" Padding="10,7" Margin="7,0,0,0" AutomationProperties.AutomationId="LibrarySaveAs"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="18,0,18,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="EditorBodyTab" Content="Body" Click="EditorBody_Click" Style="{StaticResource PreviewTabActive}" AutomationProperties.AutomationId="LibraryEditorBody"/><Button x:Name="EditorPropertiesTab" Content="Properties" Click="EditorProperties_Click" Style="{StaticResource PreviewTab}" AutomationProperties.AutomationId="LibraryEditorProperties"/><Button x:Name="EditorVariablesTab" Content="Variables" Click="EditorVariables_Click" Style="{StaticResource PreviewTab}" AutomationProperties.AutomationId="LibraryEditorVariables"/></StackPanel></Border>
     <DockPanel Grid.Row="1"><TextBlock x:Name="DestinationWarning" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource WarningHealthBrush}" Visibility="Collapsed" Margin="0,0,0,10" AutomationProperties.AutomationId="LibraryDestinationStatus"/><Grid>
      <Grid x:Name="BodyEditorSurface"><Border Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"><inspection:JsonEditor x:Name="EditorText" FontFamily="Consolas" FontSize="14" Foreground="#DCE7F3" Background="{DynamicResource EditorBackgroundBrush}" BorderThickness="0" Padding="20,18" IsReadOnly="False" ShowLineNumbers="True" LineNumbersForeground="#8394A9" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Template author JSON body" AutomationProperties.AutomationId="LibraryAuthorEditor"/></Border><Button Content="Copy" Click="CopyAuthor_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,12,0" Padding="8,4" Style="{StaticResource DarkButton}" AutomationProperties.AutomationId="LibraryCopyAuthor"/></Grid>
      <ScrollViewer x:Name="PropertiesEditorSurface" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,14,16,18">
       <TextBlock Text="Properties" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Subject" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertySubject" Text="OrderCreated" Margin="0,0,0,7" AutomationProperties.Name="Subject" AutomationProperties.AutomationId="LibrarySubject"/>
        <TextBlock Grid.Row="1" Text="Content type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="PropertyContentType" SelectedIndex="0" Margin="0,0,0,7" AutomationProperties.Name="Content type"><ComboBoxItem Content="application/json"/><ComboBoxItem Content="text/plain"/></ComboBox>
        <TextBlock Grid.Row="2" Text="Correlation ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="PropertyCorrelationId" Text="$(CustomerId)" Margin="0,0,0,7" AutomationProperties.Name="Correlation ID"/>
        <TextBlock Grid.Row="3" Text="Session ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="PropertySessionId" Margin="0,0,0,7" AutomationProperties.Name="Session ID"/>
        <TextBlock Grid.Row="4" Text="Message ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/><Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><RadioButton x:Name="GeneratedMessageId" Content="Generate new" IsChecked="True" GroupName="MessageIdMode" Margin="0,0,18,0" Checked="MessageIdMode_Checked"/><RadioButton x:Name="CustomMessageId" Content="Custom" GroupName="MessageIdMode" Checked="MessageIdMode_Checked"/></WrapPanel><TextBox Grid.Row="1" x:Name="CustomMessageIdInput" IsEnabled="False" Margin="0,6,0,0" AutomationProperties.Name="Custom message ID"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="IsEnabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid>
        <TextBlock Grid.Row="5" Text="Time to live (TTL)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/><Grid Grid.Row="5" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><RadioButton x:Name="InheritTtl" Content="Inherit entity default" IsChecked="True" GroupName="TtlMode" Margin="0,0,18,0" Checked="TtlMode_Checked"/><RadioButton x:Name="SpecifyTtl" Content="Specify duration" GroupName="TtlMode" Checked="TtlMode_Checked"/></WrapPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="TtlMinutes" Text="10" Width="56" IsEnabled="False" AutomationProperties.Name="TTL minutes"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="IsEnabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Text="min" Margin="5,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=TtlMinutes}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid>
       </Grid>
       <Expander x:Name="ReplyRoutingExpander" Header="Reply and routing" IsExpanded="False" Margin="0,0,0,10" AutomationProperties.AutomationId="LibraryReplyRouting"><StackPanel Margin="10,8,0,0">
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Reply to" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertyReplyTo" Text="order-replies"/></Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Reply session ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="PropertyReplySessionId"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Partition key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBox x:Name="PropertyPartitionKey" Margin="0,0,0,3"/><TextBlock Text="Partition key is unsupported by the emulator." Style="{StaticResource Caption}"/></StackPanel></Grid>
       </StackPanel></Expander>
       <TextBlock Text="Application properties" FontWeight="SemiBold" Margin="0,0,0,7"/><DataGrid x:Name="ApplicationPropertiesGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="34" MaxHeight="280" VerticalAlignment="Top" Margin="0,0,0,7" PreviewKeyDown="ApplicationPropertiesGrid_PreviewKeyDown" RowEditEnding="ApplicationPropertiesGrid_RowEditEnding" LostKeyboardFocus="ApplicationPropertiesGrid_LostKeyboardFocus" AutomationProperties.Name="Application properties" AutomationProperties.AutomationId="LibraryApplicationProperties">
 <DataGrid.Columns>
  <DataGridTemplateColumn Header="Name" Width="Auto" MinWidth="100" MaxWidth="200" SortMemberPath="Name">
   <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource PropertyNameDisplay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
   <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactDataGridEditingText}" Loaded="PropertyNameEditor_Loaded" AutomationProperties.Name="Property name" AutomationProperties.AutomationId="LibraryPropertyName"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
  </DataGridTemplateColumn>
  <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80" MaxWidth="120" ElementStyle="{StaticResource CompactDataGridComboDisplay}" EditingElementStyle="{StaticResource CompactDataGridCombo}"/>
  <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="90" ElementStyle="{StaticResource CompactDataGridText}" EditingElementStyle="{StaticResource CompactDataGridEditingText}"/>
  <DataGridTemplateColumn Width="32" CanUserResize="False" CanUserSort="False"><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource CompactDataGridCell}"><Setter Property="Padding" Value="0"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.CellTemplate><DataTemplate>
   <Button Click="DeleteProperty_Click" Style="{StaticResource PropertyDeleteButton}" ToolTip="Delete property" AutomationProperties.Name="Delete property" AutomationProperties.AutomationId="LibraryDeleteProperty">
    <Path Data="{StaticResource DeleteGeometry}" Stroke="{DynamicResource DestructiveBrush}" StrokeThickness="1.5" Width="14" Height="16" Stretch="Uniform"/>
   </Button>
  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns>
</DataGrid>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Destination" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="TemplateDestination" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="TemplateDestination_SelectionChanged" AutomationProperties.Name="Template destination" AutomationProperties.AutomationId="TemplateDestination"><ComboBoxItem Content="Choose destination" Tag=""/><ComboBoxItem Content="order-events (Topic)" Tag="order-events"/><ComboBoxItem Content="inventory-events (Topic)" Tag="inventory-events"/><ComboBoxItem Content="order-replies (Queue)" Tag="order-replies"/></ComboBox></Grid>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="VariablesEditorSurface" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="16,14,16,18">
  <TextBlock Text="Variables" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="VariableSelection_Changed" RowHeight="34" MaxHeight="240" VerticalAlignment="Top" AutomationProperties.Name="Template variables">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" MinWidth="100" MaxWidth="200" ElementStyle="{StaticResource CompactDataGridText}"/>
    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" MinWidth="65" MaxWidth="100" ElementStyle="{StaticResource CompactDataGridText}"/>
    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" MinWidth="85" MaxWidth="140" ElementStyle="{StaticResource CompactDataGridText}"/>
    <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="*" MinWidth="100" ElementStyle="{StaticResource CompactDataGridText}"/>
