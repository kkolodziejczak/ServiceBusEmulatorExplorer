<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.ReplayReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review replay" Width="660" MinWidth="480" SizeToContent="Height" MaxHeight="760"
 WindowStartupLocation="CenterOwner" Icon="/ServiceBusEmulatorExplorer.App;component/Assets/AppIcon.png"
 Style="{DynamicResource ReplayWindow}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24" Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="ReviewHeading" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="ProfileText" Style="{StaticResource DialogCaption}" Margin="0,0,0,16"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="540">
   <ItemsControl x:Name="ReplayRows"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Source" Margin="0,0,8,8"/><TextBlock Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Grid.Row="1" Text="Destination" Margin="0,0,8,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Destination}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Grid.Row="2" Text="Original ID" Margin="0,0,8,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OriginalId}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      </Grid>
      <Border Style="{StaticResource ValidationWarningFrame}" Margin="0,8,0,16"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/></Border>
      <TextBlock Text="New message ID" Style="{StaticResource DialogLabel}" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="MessageIdBox" Text="{Binding MessageId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New message ID" AutomationProperties.AutomationId="ReplayMessageId"/>
       <Button x:Name="ResetButton" Grid.Column="1" Margin="8,0,0,0" Click="Reset_Click" AutomationProperties.Name="Reset generated message ID"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource RefreshGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" Margin="0,0,8,0"/><TextBlock Text="Reset"/></StackPanel></Button>
      </Grid>
      <TextBlock Style="{StaticResource DialogCaption}" Text="Generated automatically. Editable before sending." Margin="0,8,0,16"/>
      <Border x:Name="ValidationNotice" Style="{StaticResource ValidationWarningFrame}" Margin="0,0,0,16" Visibility="{Binding ProblemVisibility}">
       <DockPanel><Button x:Name="FixMessageIdButton" DockPanel.Dock="Right" Content="Edit ID" Style="{StaticResource ValidationWarningAction}" Click="FixId_Click"/><TextBlock Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Body" Style="{StaticResource DialogLabel}"/><TextBlock Grid.Column="1" Text="{Binding BodySummary}"/></Grid>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
   <Button x:Name="ReplayConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Confirm_Click" AutomationProperties.AutomationId="ReplayConfirmButton"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" Margin="0,0,8,0"/><TextBlock x:Name="ConfirmLabel"/></StackPanel></Button>
  </StackPanel>
 </Grid>
</Window>
