  <DataTemplate x:Key="NamespaceCountTooltip"><TextBlock Text="{Binding}" TextAlignment="Left" FontSize="14" TextWrapping="Wrap" MaxWidth="340"/></DataTemplate>
  <HierarchicalDataTemplate DataType="{x:Type local:EntityNode}" ItemsSource="{Binding Children}">
   <Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="24" MaxWidth="32" SharedSizeGroup="Messages"/><ColumnDefinition Width="Auto" MinWidth="24" MaxWidth="32" SharedSizeGroup="Scheduled"/><ColumnDefinition Width="Auto" MinWidth="24" MaxWidth="32" SharedSizeGroup="DeadLetter"/></Grid.ColumnDefinitions>
    <DockPanel x:Name="EntityLabel" Margin="3,0,6,0"><Path Style="{StaticResource EntityIcon}" ToolTip="{Binding Kind}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DockPanel>
    <TextBlock Grid.Column="1" Style="{StaticResource NamespaceCount}" Text="{Binding DisplayMessageCount}" Foreground="{DynamicResource PrimaryBrush}" AutomationProperties.Name="{Binding ActiveCountDetail}"><TextBlock.ToolTip><ToolTip Style="{StaticResource NamespaceCountTooltipStyle}" Content="{Binding ActiveCountDetail}" ContentTemplate="{StaticResource NamespaceCountTooltip}"/></TextBlock.ToolTip></TextBlock>
    <TextBlock Grid.Column="2" Style="{StaticResource NamespaceCount}" Text="{Binding DisplayScheduledCount}" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.Name="{Binding ScheduledCountDetail}"><TextBlock.ToolTip><ToolTip Style="{StaticResource NamespaceCountTooltipStyle}" Content="{Binding ScheduledCountDetail}" ContentTemplate="{StaticResource NamespaceCountTooltip}"/></TextBlock.ToolTip></TextBlock>
    <TextBlock Grid.Column="3" Style="{StaticResource NamespaceCount}" Text="{Binding DisplayDlqCount}" Foreground="{DynamicResource DeadLetterTextBrush}" AutomationProperties.Name="{Binding DlqCountDetail}"><TextBlock.ToolTip><ToolTip Style="{StaticResource NamespaceCountTooltipStyle}" Content="{Binding DlqCountDetail}" ContentTemplate="{StaticResource NamespaceCountTooltip}"/></TextBlock.ToolTip></TextBlock>
   </Grid>
   <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="EntityLabel" Property="Grid.ColumnSpan" Value="4"/></DataTrigger></HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
 </ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource ChromeBrush}" x:Name="ToolbarSeparator" BorderBrush="{DynamicResource ToolbarDividerBrush}" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0" LastChildFill="False">
