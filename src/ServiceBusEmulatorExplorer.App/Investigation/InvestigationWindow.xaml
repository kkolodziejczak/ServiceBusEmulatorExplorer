     <Button x:Name="GlobalWatchButton" Click="GlobalWatch_Click" Padding="8,4" ToolTip="Watch messages across this connection" AutomationProperties.Name="Watch all entities" AutomationProperties.AutomationId="GlobalWatchButton"><StackPanel Orientation="Horizontal"><Path Data="M8,1 C4,1 3,4 3,7 V11 L1,14 H15 L13,11 V7 C13,4 12,1 8,1 Z M5,16 H11" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,7,0"/><TextBlock Text="Watch all" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource IconButton}" Padding="6,2" ToolTip="Settings" AutomationProperties.Name="Settings"><Path Data="M6,0 H10 L10.5,2.5 12,3.4 14.4,2.6 16.4,6 14.5,7.7 V9.3 L16.4,11 14.4,14.4 12,13.6 10.5,14.5 10,17 H6 L5.5,14.5 4,13.6 1.6,14.4 -0.4,11 1.5,9.3 V7.7 L-0.4,6 1.6,2.6 4,3.4 5.5,2.5 Z M11,8.5 A3,3 0 1 1 5,8.5 A3,3 0 1 1 11,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/></Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="305" MinWidth="240" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="15,16,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="SearchBox" Grid.Row="0" Padding="30,7,35,7" TextChanged="Search_Changed" PreviewKeyDown="SearchKeyDown" GotKeyboardFocus="SearchFocused" ToolTip="Search entities, correlation IDs or message IDs across this connection" AutomationProperties.Name="Search all entities and messages" AutomationProperties.AutomationId="SearchBox"/>
