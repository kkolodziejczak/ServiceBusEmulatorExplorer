    <ItemsPresenter x:Name="ChildrenPresenter" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBackground" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="SelectionBackground" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:EntityNode}" ItemsSource="{Binding Children}">
   <Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/><ColumnDefinition Width="65"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <DockPanel Margin="3,0,6,0"><Path Style="{StaticResource EntityIcon}" ToolTip="{Binding Kind}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DockPanel>
    <TextBlock Grid.Column="1" Text="{Binding DisplayMessageCount}" ToolTip="{Binding ActiveCountDetail}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding DisplayScheduledCount}" ToolTip="{Binding ScheduledCountDetail}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Grid.Column="3" Text="{Binding DisplayDlqCount}" ToolTip="{Binding DlqCountDetail}" Foreground="#A65B00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
   </Grid>
  </HierarchicalDataTemplate>
 </ResourceDictionary></Window.Resources>
