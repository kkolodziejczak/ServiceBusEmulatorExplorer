     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Check" Visibility="Collapsed" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"><Path x:Name="Tick" Visibility="Collapsed" Data="M1,5 L4,8 L10,1" Stroke="White" StrokeThickness="1.6" Margin="1"/></Border>
     <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsCheckable" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
