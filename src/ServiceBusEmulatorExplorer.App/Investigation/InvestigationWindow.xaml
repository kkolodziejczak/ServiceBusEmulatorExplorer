 Title="Service Bus Emulator Explorer" Width="1200" Height="800" Icon="/ServiceBusEmulatorExplorer.App;component/Assets/AppIcon.png" MinWidth="980" MinHeight="640" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}" WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="WatchOverviewItemStyle" TargetType="MenuItem">
