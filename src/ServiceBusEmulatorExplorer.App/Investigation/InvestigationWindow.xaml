Automatic refresh interval" AutomationProperties.AutomationId="AutoInterval"><ComboBoxItem Content="Auto: Off"/><ComboBoxItem Content="Auto: 5s"/><ComboBoxItem Content="Auto: 10s"/><ComboBoxItem Content="Auto: 30s"/></ComboBox><Button x:Name="PauseButton" Width="36" Padding="0" Click="Pause_Click" AutomationProperties.Name="Pause automatic refresh" AutomationProperties.AutomationId="PauseButton"><Path Data="{StaticResource PauseGeometry}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/></Button></StackPanel>
