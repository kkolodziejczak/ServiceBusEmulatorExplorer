    <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
     <Border Width="420" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="0,5">
      <ListBox x:Name="SuggestionsList" BorderThickness="0" MaxHeight="440" ItemContainerStyle="{StaticResource SearchSuggestionListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="SuggestionKeyDown" PreviewMouseLeftButtonUp="SuggestionPicked" AutomationProperties.Name="Grouped search suggestions">
       <ListBox.GroupStyle><GroupStyle HeaderTemplate="{StaticResource SearchSuggestionGroupHeaderTemplate}"/></ListBox.GroupStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path x:Name="SuggestionIcon" Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.4" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource SearchSuggestionDetail}"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DockPanel><TextBlock x:Name="SuggestionBadge" Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource SearchSuggestionBadge}"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Message.IsDeadLetter}" Value="True"><Setter TargetName="SuggestionIcon" Property="Stroke" Value="#A65B00"/><Setter TargetName="SuggestionBadge" Property="Foreground" Value="#A65B00"/></DataTrigger><DataTrigger Binding="{Binding Entity.Kind}" Value="Subscription"><Setter TargetName="SuggestionIcon" Property="Stroke" Value="#7351B5"/><Setter TargetName="SuggestionBadge" Property="Foreground" Value="#7351B5"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
