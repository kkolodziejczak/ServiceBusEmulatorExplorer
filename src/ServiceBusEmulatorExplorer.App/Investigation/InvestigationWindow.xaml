     <Border x:Name="SearchStatusPanel" Grid.Row="1" Margin="18,0,15,12" Padding="10,8" Background="{DynamicResource NeutralHoverBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"><DockPanel><Button x:Name="StopSearchButton" DockPanel.Dock="Right" Click="StopSearch_Click" Padding="10,4" AutomationProperties.Name="Stop search" AutomationProperties.AutomationId="StopSearchButton"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Stop" VerticalAlignment="Center"/></StackPanel></Button><TextBlock x:Name="SearchStatusText" AutomationProperties.AutomationId="SearchStatusText" AutomationProperties.LiveSetting="Polite" Text="" Foreground="{DynamicResource ActionTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
