    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WatchOverviewMenuStyle" TargetType="ContextMenu">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="MinWidth" Value="260"/><Setter Property="MaxWidth" Value="360"/>
