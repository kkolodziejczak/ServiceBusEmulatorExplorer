    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ConnectionButton" Click="Connection_Click" Padding="10,5" AutomationProperties.AutomationId="ConnectionButton" AutomationProperties.Name="Toggle connection"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionHealthDot" Width="8" Height="8" Fill="#24743B" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionHealthText" Text="Disconnected" VerticalAlignment="Center"/></StackPanel></Button>
