      <DataGrid.Columns>
       <DataGridTemplateColumn Width="40" MinWidth="40" CanUserSort="False"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllBox" Click="SelectAll_Click" AutomationProperties.Name="Select all loaded messages" AutomationProperties.AutomationId="SelectAllMessages"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="RowCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding EventName, StringFormat=Select {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Event / Message ID" Width="Auto" MinWidth="120" MaxWidth="200" SortMemberPath="EventName"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,6,4,2" HorizontalAlignment="Left"><TextBlock Text="{Binding EventName}" FontWeight="SemiBold" TextAlignment="Left" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding EventName}"/><TextBlock Text="{Binding MessageId}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,0" TextAlignment="Left" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessageId}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Correlation ID" Width="Auto" MinWidth="110" MaxWidth="160" SortMemberPath="CorrelationId"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="7,8" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding CorrelationId}" MaxWidth="99" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding CorrelationId}" FontSize="12"/><Button Click="CopyRowCorrelation_Click" Padding="3" Margin="4,0,0,0" Style="{StaticResource IconButton}" ToolTip="Copy correlation ID" AutomationProperties.Name="Copy row correlation ID"><Path Style="{StaticResource CopyIcon}"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn x:Name="SourceColumn" Visibility="Collapsed" Header="Location / State" Width="Auto" MaxWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,8,5,5" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" FontSize="12" TextAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" VerticalAlignment="Center"/><Border Grid.Column="1" CornerRadius="3" HorizontalAlignment="Left" Padding="6,2" Margin="5,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#6C9BD2"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsDeadLetter}" Value="True"><Setter Property="Background" Value="#FFE6C8"/><Setter Property="BorderBrush" Value="#A65B00"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StateLabel}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#174A7E"/><Setter Property="TextAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding IsDeadLetter}" Value="True"><Setter Property="Foreground" Value="#A65B00"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn x:Name="EnqueuedColumn" Header="Enqueued (UTC)" Binding="{Binding Enqueued, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CompactDataGridText}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="7,0"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="EmptyResults" VerticalAlignment="Center" Margin="25" Visibility="Collapsed"><Border x:Name="EmptySearchIcon" Width="48" Height="48" Background="{DynamicResource NeutralHoverBrush}" CornerRadius="24" HorizontalAlignment="Center"><Path Data="M24,15 A9,9 0 1 1 6,15 A9,9 0 1 1 24,15 M21,22 L30,31" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" Width="32" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyMessage" Text="No messages in this view" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/><Button x:Name="EmptyClearButton" Content="Clear search" Click="ClearSearch_Click" HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.AutomationId="EmptyClearButton"/></StackPanel>
     </Grid>
     <Border x:Name="ListFooter" Grid.Row="4" Padding="15,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><DockPanel><Button x:Name="LoadMoreButton" Content="Load more" DockPanel.Dock="Right" Click="LoadMore_Click" IsEnabled="{Binding CanLoadMore}" AutomationProperties.AutomationId="LoadMoreButton"/><Button x:Name="DeleteButton" DockPanel.Dock="Right" Click="Delete_Click" Padding="8,4" Style="{StaticResource DestructiveButton}" ToolTip="Delete checked messages" AutomationProperties.Name="Delete checked messages" AutomationProperties.AutomationId="DeleteButton"><StackPanel Orientation="Horizontal"><Path Data="M2,4 H16 M6,4 V1 H12 V4 M4,4 L5,18 H13 L14,4 M7,7 V14 M11,7 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button><TextBlock AutomationProperties.AutomationId="MessageCountSummary" Text="{Binding CountSummary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></DockPanel></Border>
    </Grid>
    <GridSplitter x:Name="InspectorSplitter" ResizeDirection="Columns" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerBrush}" AutomationProperties.Name="Resize message inspector"/>
    <Grid x:Name="InspectorPane" Grid.Column="2" PreviewKeyDown="Inspector_PreviewKeyDown">
     <Grid.CommandBindings><CommandBinding Command="Find" Executed="InspectorFind_Executed" CanExecute="InspectorFind_CanExecute"/></Grid.CommandBindings>
     <Grid.InputBindings><KeyBinding Command="Find" Key="F" Modifiers="Control"/></Grid.InputBindings><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="InspectorHeading" Margin="18,18,15,12">
      <DockPanel><Border x:Name="InspectorState" DockPanel.Dock="Right" Background="#FFE6C8" CornerRadius="3" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="{Binding FocusedMessage.StateLabel}" Foreground="#A65B00" FontSize="12"/></Border><TextBlock x:Name="InspectorTitle" Text="{Binding FocusedMessage.EventName}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></DockPanel>
      <TextBlock x:Name="InspectorMessageId" AutomationProperties.AutomationId="InspectorMessageId" Text="{Binding FocusedMessage.MessageId}" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,10"/>
      <Border x:Name="CorrelationMetadata" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="3" Padding="10,9"><StackPanel>
       <DockPanel><Button x:Name="FindRelatedButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="7,4" Click="FindRelated_Click" AutomationProperties.Name="Find related messages" AutomationProperties.AutomationId="FindRelatedButton"><StackPanel Orientation="Horizontal"><Path Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M9,9 L14,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Find related" VerticalAlignment="Center"/></StackPanel></Button><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Correlation ID" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock x:Name="CorrelationValue" Text="{Binding FocusedMessage.CorrelationId}" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocusedMessage.CorrelationId}" FontSize="12" VerticalAlignment="Center"/><Button Style="{StaticResource IconButton}" x:Name="CopyCorrelationButton" Padding="4" Margin="5,0,0,0"   Click="CopyCorrelation_Click" ToolTip="Copy correlation ID" AutomationProperties.Name="Copy correlation ID" AutomationProperties.AutomationId="CopyCorrelationButton"><Path Style="{StaticResource CopyIcon}"/></Button></StackPanel></DockPanel>
       <TextBlock x:Name="DlqReason" Text="{Binding FocusedMessage.DeadLetterReason, StringFormat=DLQ reason: {0}}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </StackPanel>
     <WrapPanel x:Name="InspectorTabs" Grid.Row="1" Margin="9,0,8,0"><StackPanel Orientation="Horizontal"><ToggleButton Style="{StaticResource TabToggle}" x:Name="JsonTab" Content="JSON" IsChecked="True" Checked="Json_Checked" Unchecked="InspectorTab_Unchecked" Padding="9,8" AutomationProperties.AutomationId="JsonTab"/><ToggleButton Style="{StaticResource TabToggle}" x:Name="PropertiesTab" Content="Properties" Checked="Properties_Checked" Unchecked="InspectorTab_Unchecked" Padding="9,8" AutomationProperties.AutomationId="PropertiesTab"/><ToggleButton Style="{StaticResource TabToggle}" x:Name="RawTab" Content="Raw" Checked="Raw_Checked" Unchecked="InspectorTab_Unchecked" Padding="9,8" AutomationProperties.AutomationId="RawTab"/></StackPanel><WrapPanel><Button x:Name="SaveInspectedTemplateButton" Content="Create template" Click="SaveInspectedTemplate_Click" Height="32" Padding="9,4" VerticalAlignment="Center" AutomationProperties.AutomationId="InspectorSaveTemplate"/><Button x:Name="ReplayButton" Content="▶  Replay" Click="Replay_Click" Style="{StaticResource PrimaryButton}" Height="32" Padding="10,4" VerticalAlignment="Center" AutomationProperties.AutomationId="ReplayButton"/></WrapPanel></WrapPanel>
     <Grid x:Name="InspectorContentGrid" Grid.Row="3" Background="{DynamicResource EditorBackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="FindPanel" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Right" MaxWidth="440" Margin="8,8,12,0" Padding="4" Background="{DynamicResource DarkButtonBrush}" BorderBrush="{DynamicResource DarkButtonBorderBrush}" BorderThickness="1" CornerRadius="3">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="FindBox" MinWidth="70" MaxWidth="200" Padding="6,4" Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource EditorForegroundBrush}" BorderBrush="{DynamicResource DarkButtonBorderBrush}" TextChanged="Find_Changed" KeyDown="Find_KeyDown" AutomationProperties.Name="Find in message" AutomationProperties.AutomationId="FindText"/>
        <TextBlock x:Name="FindMatchCount" Grid.Column="1" FontSize="12" Foreground="{DynamicResource EditorForegroundBrush}" Margin="8,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="FindPrevious" Grid.Column="2" Click="FindPrevious_Click" Style="{StaticResource DarkButton}" Width="28" Height="28" MinHeight="28" Padding="6" Margin="0" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match" AutomationProperties.AutomationId="FindPrevious"><Path Data="M0,5 L5,0 L10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="5"/></Button>
        <Button x:Name="FindNext" Grid.Column="3" Click="FindNext_Click" Style="{StaticResource DarkButton}" Width="28" Height="28" MinHeight="28" Padding="6" Margin="4,0,0,0" ToolTip="Next match (Enter)" AutomationProperties.Name="Next match" AutomationProperties.AutomationId="FindNext"><Path Data="M0,0 L5,5 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="5"/></Button>
        <Button x:Name="CloseFindButton" Grid.Column="4" Click="CloseFind_Click" Style="{StaticResource DarkButton}" Width="28" Height="28" MinHeight="28" Padding="6" Margin="4,0,0,0" ToolTip="Close find (Esc)" AutomationProperties.Name="Close find" AutomationProperties.AutomationId="CloseFind"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10"/></Button>
       </Grid>
      </Border>
      <RichTextBox x:Name="BodyViewer" Grid.Row="1" IsInactiveSelectionHighlightEnabled="True" Background="#1C2937" Foreground="#DCE7F3" FontFamily="Consolas" FontSize="14" Padding="20,18" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Original message body and properties" AutomationProperties.AutomationId="BodyViewer" Visibility="Collapsed"/>
      <inspection:JsonEditor x:Name="BodyEditor" Grid.Row="1" Background="#1C2937" FontFamily="Consolas" FontSize="14" Padding="14,18" BorderThickness="0" ShowLineNumbers="True" LineNumbersForeground="#8394A9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="BodyEditor_Changed" AutomationProperties.Name="Editable message JSON" AutomationProperties.AutomationId="BodyEditor"/>
      <Border x:Name="ModifiedBadge" Grid.Row="1" Background="#FFE38D" CornerRadius="3" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,105,0" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="Modified" Foreground="#5E4600" FontSize="11"/></Border>
      <Button x:Name="CopyButton" Grid.Row="1" Click="Copy_Click" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,12,0" Style="{StaticResource DarkButton}" ToolTip="Copy displayed body or properties" AutomationProperties.AutomationId="CopyBody" AutomationProperties.Name="Copy displayed body or properties"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource CopyIcon}" Margin="0,0,6,0"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel></Button>
     </Grid>
     <Border x:Name="ReplayActions" Grid.Row="4" Padding="10,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><StackPanel>
      <TextBlock x:Name="EditError" Foreground="#A94415" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
      <WrapPanel><Button x:Name="DiscardButton" Click="Discard_Click" Padding="10,8" Visibility="Collapsed" AutomationProperties.Name="Discard changes" AutomationProperties.AutomationId="DiscardButton"><StackPanel Orientation="Horizontal"><Path Data="M1,6 H10 A5,5 0 0 1 10,16 H6 M1,6 L6,1 M1,6 L6,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Discard changes" VerticalAlignment="Center"/></StackPanel></Button><TextBlock x:Name="NextReplayIdText" Text="" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="10,6" TextWrapping="Wrap" MaxWidth="230"/></WrapPanel>
     </StackPanel></Border>
     <StackPanel x:Name="EmptyInspector" Grid.RowSpan="5" VerticalAlignment="Center" Margin="25" Visibility="Collapsed"><Path Data="M4,1 H20 L30,11 V39 H4 Z M20,1 V11 H30 M10,18 H24 M10,24 H24 M10,30 H20" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="34" Height="42" HorizontalAlignment="Center"/><TextBlock Text="Select a message to inspect" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="Choose a message from the list to view its details, JSON content, and replay options." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Background="{DynamicResource ChromeBrush}"><Button Style="{StaticResource IconButton}" x:Name="LogToggle" DockPanel.Dock="Right" Width="32" Padding="0" Click="ToggleLog_Click"   AutomationProperties.Name="Collapse activity log" ToolTip="Collapse activity log" AutomationProperties.AutomationId="LogToggle"><Path x:Name="LogChevron" Data="M1,8 L7,2 L13,8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><Button Style="{StaticResource IconButton}" x:Name="ClearLogButton" DockPanel.Dock="Right" Click="ClearLog_Click"   Padding="8,5" Margin="3,0" Visibility="{Binding Visibility, ElementName=LogPanel}" ToolTip="Clear activity log" AutomationProperties.Name="Clear activity log" AutomationProperties.AutomationId="ClearLogButton"><Path Data="M2,4 H16 M6,4 V1 H12 V4 M4,4 L5,18 H13 L14,4 M7,7 V14 M11,7 V14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="16" Height="18" Stretch="Uniform"/></Button><Border Width="23" Height="23" Margin="16,0,0,0" Background="#22374D" CornerRadius="2"><TextBlock Text="›_" FontFamily="Consolas" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="LogHeading" Text="Activity log · Expanded" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/></DockPanel>
    <Grid x:Name="LogPanel" Grid.Row="1" Height="150" Background="#1C2937"><RichTextBox x:Name="LogText" Background="Transparent" Foreground="#D5E5F5" FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0" Padding="16,7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Activity log entries"><RichTextBox.Document><FlowDocument PagePadding="0"/></RichTextBox.Document></RichTextBox></Grid>
   </Grid>
  </Border>
  <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,7"><DockPanel><ComboBox x:Name="TimeDisplaySelector" DockPanel.Dock="Right" Width="94" Margin="12,0,0,0" SelectedIndex="0" Style="{StaticResource CompactComboBox}" SelectionChanged="TimeDisplay_Changed" AutomationProperties.Name="Time display zone" AutomationProperties.AutomationId="TimeDisplaySelector"><ComboBoxItem Content="UTC"/><ComboBoxItem Content="Local"/></ComboBox><TextBlock x:Name="LastOperationTime" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="{DynamicResource ActionTextBrush}" FontSize="11" Margin="15,0,0,0"/><TextBlock x:Name="LastOperation" VerticalAlignment="Center" Text="Last operation: Ready" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ActionTextBrush}" FontSize="12"/></DockPanel></Border>
  <Popup x:Name="WatchPopup" PlacementTarget="{Binding ElementName=WatchButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Width="250" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
    <StackPanel><TextBlock x:Name="WatchPopupTitle" Text="Watch" FontWeight="SemiBold" Margin="0,0,0,13" TextWrapping="Wrap"/>
     <CheckBox x:Name="WatchActiveChoice" Style="{StaticResource WatchCheckStyle}" Content="Active messages" Checked="WatchChoice_Click" Unchecked="WatchChoice_Click" Margin="0,0,0,13" AutomationProperties.Name="Watch active messages"/>
     <CheckBox x:Name="WatchDlqChoice" Style="{StaticResource WatchCheckStyle}" Content="Dead-letter messages" Checked="WatchChoice_Click" Unchecked="WatchChoice_Click" Margin="0,0,0,15" AutomationProperties.Name="Watch dead-letter messages"/>
     <TextBlock Text="Notifications on new arrivals" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
     <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0"><Button Style="{StaticResource IconButton}" x:Name="StopWatchingButton" Content="Stop watching" Click="StopWatching_Click"   Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Padding="0,4" Margin="0" AutomationProperties.AutomationId="StopWatchingButton"/></Border>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</Window>
