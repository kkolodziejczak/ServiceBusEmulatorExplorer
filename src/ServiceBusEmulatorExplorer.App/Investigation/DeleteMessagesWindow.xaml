<Window x:Class="ServiceBusEmulatorExplorer.App.Investigation.DeleteMessagesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delete messages" Width="470" SizeToContent="Height" MinWidth="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Icon="/ServiceBusEmulatorExplorer.App;component/Assets/AppIcon.png" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/SharedStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D11A2A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#D11A2A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B31222"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#940D1B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#17213D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E1E8F1"/><Setter Property="BorderBrush" Value="#D2DCE9"/><Setter Property="Foreground" Value="#627692"/></Trigger></Style.Triggers></Style>
 </ResourceDictionary></Window.Resources>
 <Border Background="{DynamicResource CanvasBrush}" Padding="24"><StackPanel><TextBlock x:Name="DeleteHeading" Text="Delete messages?" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DeleteSummary" TextWrapping="Wrap" Margin="0,12,0,12"/>
  <Border Background="#FFF0ED" BorderBrush="#F1C4BF" BorderThickness="1" CornerRadius="4" Padding="12"><TextBlock Text="This cannot be undone. Only the selected dead-letter deliveries will be deleted. Other deliveries and active messages will remain." Foreground="#B31222" TextWrapping="Wrap"/></Border>
  <Label Content="Type DELETE to confirm" Target="{Binding ElementName=DeleteConfirmationInput}" Padding="0" Margin="0,18,0,7"/>
  <TextBox x:Name="DeleteConfirmationInput" Padding="10,8" BorderBrush="{DynamicResource ControlBorderBrush}" TextChanged="Confirmation_Changed" AutomationProperties.Name="Type DELETE to confirm deletion" AutomationProperties.AutomationId="DeleteConfirmationInput"/>
  <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelDeleteButton"/><Button x:Name="ConfirmDeleteButton" IsEnabled="False" Style="{StaticResource DeleteButtonStyle}" Click="Delete_Click" AutomationProperties.Name="Confirm delete messages" AutomationProperties.AutomationId="ConfirmDeleteButton"><StackPanel Orientation="Horizontal"><Path Data="M2,4 H16 M6,4 V1 H12 V4 M4,4 L5,18 H13 L14,4 M7,7 V14 M11,7 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="14" Height="16" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock x:Name="DeleteButtonLabel" Text="Delete messages" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel>
 </StackPanel></Border>
</Window>

