<Window x:Class="ServiceBusEmulatorExplorer.App.DeleteDeadLetterMessagesConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete DLQ Messages"
        Height="280"
        Width="480"
        MinHeight="280"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageSummaryText"
                       AutomationProperties.AutomationId="DeleteDlqSummaryText"
                       Foreground="#607086"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="WarningText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />
            <CheckBox x:Name="ConfirmDeleteCheckBox"
                      AutomationProperties.AutomationId="ConfirmDeleteDlqCheckBox"
                      Content="I understand these DLQ message deletes cannot be undone"
                      Checked="ConfirmDeleteCheckBox_Changed"
                      Unchecked="ConfirmDeleteCheckBox_Changed" />
            <StackPanel x:Name="ConfirmPhrasePanel"
                        Visibility="Collapsed">
                <TextBlock Text="Type DELETE VISIBLE to confirm"
                           Margin="0,0,0,4" />
                <TextBox x:Name="ConfirmPhraseTextBox"
                         AutomationProperties.AutomationId="ConfirmDeleteDlqPhraseTextBox"
                         TextChanged="ConfirmPhraseTextBox_Changed" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteButton"
                    AutomationProperties.AutomationId="ConfirmDeleteDlqButton"
                    Content="Delete"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="DeleteButton_Click" />
            <Button AutomationProperties.AutomationId="CancelDeleteDlqButton"
                    Content="Cancel"
                    MinWidth="96"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
