<Project Sdk="Microsoft.NET.Sdk">

  <!-- View models shared by every UI. Plain net10.0 without WPF, so no view model can depend on a UI framework (DEC-053). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceBusEmulatorExplorer.Core\ServiceBusEmulatorExplorer.Core.csproj" />
  </ItemGroup>

</Project>
